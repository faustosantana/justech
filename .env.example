# ─── JAIOS Core Platform ─────────────────────────────────────────────────────

# Application
APP_NAME=JAIOS
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Proxy interno Next.js (docker: http://backend:8000)
INTERNAL_API_URL=http://backend:8000

# Fase 6.5 — Search Acceleration
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=120
SEARCH_CACHE_ASSISTANT_TTL_SECONDS=60
SEARCH_INDEX_ENABLED=true
SEARCH_ANALYTICS_ENABLED=true
NEXT_PUBLIC_APP_NAME=JAIOS

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jaios
POSTGRES_USER=jaios
POSTGRES_PASSWORD=jaios_secret
DATABASE_URL=postgresql+asyncpg://jaios:jaios_secret@postgres:5432/jaios

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=jaios_

# n8n
N8N_HOST=n8n
N8N_PORT=5678
N8N_WEBHOOK_URL=http://n8n:5678
N8N_API_KEY=

# LLM Providers
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_PROVIDER=claude

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# DeepSeek Huawei
DEEPSEEK_HUAWEI_API_KEY=
DEEPSEEK_HUAWEI_BASE_URL=
DEEPSEEK_HUAWEI_DEFAULT_MODEL=deepseek-chat

# Hermes Local (Ollama / local inference)
HERMES_LOCAL_BASE_URL=http://host.docker.internal:11434
HERMES_LOCAL_DEFAULT_MODEL=hermes3

# Odoo Integration
ODOO_URL=
ODOO_DB=justech
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_READ_ONLY=true

# Microsoft 365 Intelligence Center (Fase 4 — estructura base, sin Graph real)
M365_READ_ONLY=true
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=http://localhost:8000/api/v1/m365/auth/callback

# DGCP Integration (Dominican Republic procurement)
DGCP_API_BASE_URL=https://datosabiertos.dgcp.gob.do/api-dgcp/v1
DGCP_API_KEY=

# Redis (optional — sessions, rate limiting)
REDIS_URL=redis://redis:6379/0

# Desktop Windows CI (Opción A — build automático sin browser)
# GH_TOKEN=ghp_xxxxxxxx
# JAIOS_GITHUB_REPO=justech/jaios
