[options]
; Plantilla producción — hellenia_prod (NO activa en Fase 10)
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/enterprise/addons,/mnt/custom
data_dir = /var/lib/odoo
admin_passwd = CHANGE_ME_STRONG_MASTER_PASSWORD
dbfilter = ^hellenia_prod$
list_db = False
proxy_mode = True
workers = 2
max_cron_threads = 2
limit_time_cpu = 600
limit_time_real = 1200
longpolling_port = 8072
log_level = info
logfile = False

; Ajustar según RAM VPS al Go-Live (regla: workers = (RAM_GB * 2) - 1 aprox.)
