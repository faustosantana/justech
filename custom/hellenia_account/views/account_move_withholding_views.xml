<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_hellenia_withholding" model="ir.ui.view">
        <field name="name">account.move.form.hellenia.withholding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Retenciones aplicadas" name="hellenia_withholdings"
                      invisible="not hellenia_withholding_line_ids">
                    <group>
                        <field name="hellenia_withholding_total" readonly="1"/>
                    </group>
                    <field name="hellenia_withholding_line_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="payment_id" string="Pago"/>
                            <field name="withholding_code" string="Código"/>
                            <field name="label" string="Retención"/>
                            <field name="base_amount" string="Base"/>
                            <field name="rate" string="%"/>
                            <field name="amount" string="Monto retenido"/>
                            <field name="account_id" string="Cuenta contable"/>
                            <field name="fiscal_report_codes" string="Reporte fiscal"/>
                            <field name="state" string="Estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
