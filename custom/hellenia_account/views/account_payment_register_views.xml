<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_hellenia" model="ir.ui.view">
        <field name="name">account.payment.register.form.hellenia</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']" position="before">
                <group name="hellenia_payment_docs" string="Documentos pendientes" invisible="not line_ids">
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="move_id" string="Factura"/>
                            <field name="justech_do_ncf" string="NCF"/>
                            <field name="date" string="Fecha"/>
                            <field name="date_maturity" string="Vencimiento"/>
                            <field name="currency_id" string="Moneda"/>
                            <field name="amount_currency" string="Total"/>
                            <field name="amount_residual" string="Residual"/>
                        </list>
                    </field>
                </group>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="string">Método de pago</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="string">Diario</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="after">
                <field name="hellenia_wh_isr_gov" string="Retención 5% Gobierno"
                       invisible="payment_type != 'inbound'"/>
                <field name="hellenia_wh_itbis_30" string="Retención ITBIS 30%"
                       invisible="payment_type != 'outbound'"/>
                <field name="hellenia_wh_isr_10" string="Retención proveedor informal 10%"
                       invisible="payment_type != 'outbound'"/>
                <field name="hellenia_wh_itbis_75" string="Retención ITBIS informal 75%"
                       invisible="payment_type != 'outbound'"/>
                <field name="hellenia_withholding_total" readonly="1" invisible="not hellenia_withholding_line_ids"/>
            </xpath>
            <xpath expr="//group[@name='group1']" position="after">
                <group string="Detalle retenciones" invisible="not hellenia_withholding_line_ids">
                    <field name="hellenia_withholding_line_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="label" string="Retención"/>
                            <field name="base_amount" string="Base"/>
                            <field name="rate" string="Porcentaje"/>
                            <field name="amount" string="Monto retenido"/>
                            <field name="account_id" string="Cuenta contable"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
