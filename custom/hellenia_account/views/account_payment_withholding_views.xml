<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_hellenia_withholding" model="ir.ui.view">
        <field name="name">account.payment.form.hellenia.withholding</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Resumen aplicación" invisible="not hellenia_applied_amount and not hellenia_withholding_total">
                    <group>
                        <field name="hellenia_invoice_display" readonly="1"/>
                        <field name="hellenia_applied_amount" readonly="1"/>
                        <field name="hellenia_withholding_total" readonly="1"/>
                        <field name="hellenia_net_transfer" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Retenciones aplicadas" name="hellenia_withholdings"
                      invisible="not hellenia_withholding_line_ids">
                    <field name="hellenia_withholding_line_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="invoice_name" string="Factura"/>
                            <field name="ncf" string="NCF"/>
                            <field name="label" string="Retención"/>
                            <field name="withholding_type" string="Tipo"/>
                            <field name="base_label" string="Base"/>
                            <field name="base_amount" string="Monto base"/>
                            <field name="rate" string="Porcentaje"/>
                            <field name="amount" string="Monto retenido"/>
                            <field name="account_id" string="Cuenta contable"/>
                            <field name="move_line_id" string="Línea asiento" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
