<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_governance" model="res.groups.privilege">
        <field name="name">Hellenia Governance</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>
    <record id="group_governance_user" model="res.groups">
        <field name="name">Governance User</field>
        <field name="privilege_id" ref="res_groups_privilege_governance"/>
    </record>
    <record id="group_governance_manager" model="res.groups">
        <field name="name">Governance Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_governance"/>
        <field name="implied_ids" eval="[(4, ref('group_governance_user'))]"/>
    </record>
</odoo>
