<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hellenia_feature_policy_list" model="ir.ui.view">
        <field name="name">hellenia.feature.policy.list</field>
        <field name="model">hellenia.feature.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="feature_code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="enabled"/>
            </list>
        </field>
    </record>
    <record id="action_hellenia_feature_policy" model="ir.actions.act_window">
        <field name="name">Políticas de features</field>
        <field name="res_model">hellenia.feature.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
