<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hellenia_menu_policy_list" model="ir.ui.view">
        <field name="name">hellenia.menu.policy.list</field>
        <field name="model">hellenia.menu.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="menu_xmlid"/>
                <field name="name"/>
                <field name="visibility"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="action_hellenia_menu_policy" model="ir.actions.act_window">
        <field name="name">Políticas de menú</field>
        <field name="res_model">hellenia.menu.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
