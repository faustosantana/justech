<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hellenia_permission_list" model="ir.ui.view">
        <field name="name">hellenia.permission.list</field>
        <field name="model">hellenia.permission</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="risk_level"/>
                <field name="impacted_modules"/>
            </list>
        </field>
    </record>
    <record id="view_hellenia_permission_form" model="ir.ui.view">
        <field name="name">hellenia.permission.form</field>
        <field name="model">hellenia.permission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="risk_level"/>
                        <field name="impacted_modules"/>
                    </group>
                    <group string="Documentación">
                        <field name="description"/>
                        <field name="affects"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hellenia_permission" model="ir.actions.act_window">
        <field name="name">Permisos</field>
        <field name="res_model">hellenia.permission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
