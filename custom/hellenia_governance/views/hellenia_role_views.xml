<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hellenia_role_list" model="ir.ui.view">
        <field name="name">hellenia.role.list</field>
        <field name="model">hellenia.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="is_system"/>
            </list>
        </field>
    </record>
    <record id="view_hellenia_role_form" model="ir.ui.view">
        <field name="name">hellenia.role.form</field>
        <field name="model">hellenia.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="is_system" readonly="1"/>
                    </group>
                    <field name="description"/>
                    <field name="permission_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hellenia_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">hellenia.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
