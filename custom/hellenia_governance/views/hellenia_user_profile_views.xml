<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hellenia_user_profile_list" model="ir.ui.view">
        <field name="name">hellenia.user.profile.list</field>
        <field name="model">hellenia.user.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_hellenia_user_profile_form" model="ir.ui.view">
        <field name="name">hellenia.user.profile.form</field>
        <field name="model">hellenia.user.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="role_ids" widget="many2many_tags"/>
                    <field name="permission_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hellenia_user_profile" model="ir.actions.act_window">
        <field name="name">Perfiles de usuario</field>
        <field name="res_model">hellenia.user.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
