<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>

    <!-- Cotización Hellenia — reporte QWeb independiente (draft/sent) -->
    <record id="action_report_hellenia_quotation" model="ir.actions.report">
        <field name="name">Cotización Hellenia</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hellenia_reports.report_hellenia_quotation</field>
        <field name="report_file">hellenia_reports.report_hellenia_quotation</field>
        <field name="print_report_name">'Cotización - %s' % (object.name)</field>
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_quotation"/>
    </record>

    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
    <record id="account_followup.action_report_followup" model="ir.actions.report">
        <field name="paperformat_id" ref="hellenia_reports.paperformat_hellenia_letter"/>
    </record>
</odoo>
