<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bloques reutilizables -->
    <template id="hellenia_document_footer_blocks">
        <t t-set="hellenia_company" t-value="(o and o.company_id) or (doc and doc.company_id) or user.company_id"/>
        <div class="hellenia-terms mt-4" t-if="hellenia_company.hellenia_terms_conditions">
            <strong class="hellenia-section-title">Términos y condiciones</strong>
            <div t-field="hellenia_company.hellenia_terms_conditions"/>
        </div>
        <div class="hellenia-signature row mt-4 pt-3" t-if="hellenia_company.hellenia_signature_image or hellenia_company.hellenia_stamp_image">
            <div class="col-6 text-center" t-if="hellenia_company.hellenia_signature_image">
                <img t-att-src="image_data_uri(hellenia_company.hellenia_signature_image)"
                     class="hellenia-signature-img" alt="Firma"/>
                <div class="hellenia-signature-line mt-2">Firma autorizada</div>
            </div>
            <div class="col-6 text-center" t-if="hellenia_company.hellenia_stamp_image">
                <img t-att-src="image_data_uri(hellenia_company.hellenia_stamp_image)"
                     class="hellenia-stamp-img" alt="Sello"/>
            </div>
        </div>
    </template>

    <!-- Layout corporativo Hellenia -->
    <template id="external_layout_hellenia">
        <div t-attf-class="header o_company_#{company.id}_layout hellenia-header">
            <div class="row align-items-center hellenia-header-top">
                <div class="col-5">
                    <img t-if="company.logo"
                         class="hellenia-logo o_company_logo_big"
                         t-att-src="image_data_uri(company.logo)"
                         alt="Logo Hellenia"/>
                </div>
                <div class="col-7 text-end hellenia-company-block">
                    <div class="hellenia-company-name" t-field="company.name"/>
                    <ul class="list-unstyled hellenia-company-contact mb-0">
                        <li t-if="company.partner_id.street">
                            <span t-field="company.partner_id"
                                  t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                        </li>
                        <li t-if="company.vat" class="hellenia-rnc">
                            <strong>RNC:</strong> <span t-field="company.vat"/>
                        </li>
                        <li t-if="company.phone">
                            <strong>Tel.:</strong> <span t-field="company.phone"/>
                        </li>
                        <li t-if="company.email">
                            <strong>Correo:</strong> <span t-field="company.email"/>
                        </li>
                        <li t-if="company.website">
                            <strong>Web:</strong> <span t-field="company.website"/>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="hellenia-header-accent"/>
            <div t-if="company.report_header" t-field="company.report_header" class="hellenia-tagline mt-2"/>
        </div>

        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout hellenia-article o_snail_mail"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <h2 class="hellenia-doc-title" t-out="layout_document_title"/>
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout hellenia-footer {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="hellenia-footer-accent"/>
            <div class="o_footer_content d-flex border-top pt-2">
                <div class="flex-grow-1 text-start me-2">
                    <div t-if="company.hellenia_legal_notice" t-field="company.hellenia_legal_notice"/>
                    <div t-else="" t-field="company.report_footer"/>
                    <div class="hellenia-social mt-1" t-if="company.hellenia_social_instagram or company.hellenia_social_whatsapp or company.hellenia_social_facebook">
                        <span t-if="company.hellenia_social_instagram">IG: <t t-esc="company.hellenia_social_instagram"/></span>
                        <span t-if="company.hellenia_social_whatsapp"> | WA: <t t-esc="company.hellenia_social_whatsapp"/></span>
                        <span t-if="company.hellenia_social_facebook"> | FB: <t t-esc="company.hellenia_social_facebook"/></span>
                    </div>
                </div>
                <div class="text-end text-muted">
                    <div t-if="report_type == 'pdf' and display_name_in_footer" t-out="o.name"/>
                    <div t-if="report_type == 'pdf'" class="text-nowrap">
                        Página <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

</odoo>
