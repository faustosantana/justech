<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Layout mínimo — sin web.external_layout -->
    <template id="hellenia_quote_layout">
        <t t-set="company" t-value="doc.company_id"/>
        <style type="text/css">
                html, body { margin: 0; padding: 0; }
                main .hq-doc { margin: 0; padding: 0; width: 100%; max-width: none; }
                .o_body_html .container main .article.hq-doc { padding: 0; margin: 0; border: none; }
            .hq-doc {
                font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
                font-size: 9pt;
                color: #000000;
                line-height: 1.45;
                margin: 0;
                padding: 0;
                width: 100%;
            }
            .hq-doc table { border-collapse: collapse; width: 100%; border: none !important; }
            .hq-doc td, .hq-doc th { border: none !important; }

            .hq-green { color: #3E4827; }
            .hq-lbl { color: #888888; font-weight: bold; text-transform: uppercase; font-size: 6.5pt; letter-spacing: 0.4px; }
            .hq-val { color: #000000; font-size: 9pt; }
            .hq-title { color: #3E4827; font-weight: bold; text-transform: uppercase; font-size: 6.5pt; letter-spacing: 0.7px; margin: 0 0 10px 0; }

            .hq-hdr { margin: 0 0 8px 0; }
            .hq-hdr td { vertical-align: top; }
            .hq-logo { max-height: 82px; max-width: 240px; width: auto; height: auto; display: block; }
            .hq-co { text-align: right; font-size: 7.5pt; color: #000000; line-height: 1.55; }
            .hq-co-name { font-size: 11pt; font-weight: bold; color: #3E4827; margin: 0 0 2px 0; }

            .hq-band { background-color: #3E4827; }
            .hq-band td { padding: 11px 14px; background-color: #3E4827; color: #ffffff; }
            .hq-band-title { font-size: 11pt; font-weight: bold; letter-spacing: 2.5px; text-transform: uppercase; color: #ffffff; }
            .hq-band-num { color: #ffffff; font-weight: bold; font-size: 10pt; text-align: right; display: block; border-left: 1px solid rgba(255,255,255,0.35); padding-left: 14px; }
            .hq-band-num span { color: #ffffff !important; }

            .hq-line-soft { border: none; border-bottom: 1px solid #e0e0e0; margin: 0; height: 0; }

            .hq-dates td { padding: 8px 0 10px 0; }

            .hq-cards { margin: 14px 0 18px 0; }
            .hq-card { vertical-align: top; padding: 2px 18px 2px 0; }
            .hq-card-r { padding: 2px 0 2px 18px; }
            .hq-vdiv { width: 1px; background-color: #e0e0e0; font-size: 1px; padding: 0; }
            .hq-field { margin: 0 0 9px 0; }
            .hq-pay { margin-top: 12px; }
            .hq-pay-val { font-size: 9.5pt; font-weight: bold; color: #000000; margin-top: 3px; }

            .hq-items { margin: 0 0 6px 0; }
            .hq-items thead th {
                background-color: #3E4827;
                color: #ffffff !important;
                font-size: 6.5pt;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.7px;
                padding: 11px 12px;
            }
            .hq-items tbody td {
                padding: 11px 12px;
                font-size: 8.5pt;
                color: #000000;
                vertical-align: middle;
                border: none !important;
                border-bottom: 1px solid #f0f0f0 !important;
            }
            .hq-items tbody tr:last-child td { border-bottom: none !important; }
            .hq-items .c-num { text-align: center; width: 28px; }
            .hq-items .c-qty, .hq-items .c-price, .hq-items .c-sub { text-align: right; white-space: nowrap; }
            .hq-items .c-sub { font-weight: bold; }

            .hq-totals { width: 300px; margin: 10px 0 14px auto; }
            .hq-totals td { padding: 5px 2px; font-size: 8.5pt; border: none !important; }
            .hq-totals .t-lbl { color: #888888; font-weight: bold; text-align: left; width: 50%; }
            .hq-totals .t-val { color: #000000; font-weight: bold; text-align: right; width: 50%; }
            .hq-totals tr.grand td { border-top: 2px solid #3E4827 !important; padding-top: 11px; }
            .hq-totals tr.grand .t-lbl { font-size: 11pt; color: #3E4827; text-transform: uppercase; }
            .hq-totals tr.grand .t-val { font-size: 15pt; color: #3E4827; font-weight: bold; }

            .hq-spacer td { font-size: 1px; line-height: 1px; }

            .hq-cond { margin: 0 0 14px 0; }
            .hq-cond-title {
                color: #3E4827;
                font-weight: bold;
                text-transform: uppercase;
                font-size: 6.5pt;
                letter-spacing: 0.7px;
                margin: 0 0 6px 0;
                padding: 0 0 4px 0;
                border-bottom: 2px solid #3E4827;
                display: inline-block;
            }
            .hq-cond-body { font-size: 7.5pt; color: #000000; line-height: 1.55; white-space: pre-line; }

            .hq-sigs { margin: 0 0 10px 0; }
            .hq-sigs td { vertical-align: top; padding: 0; }
            .hq-sig-lbl { font-size: 6.5pt; font-weight: bold; text-transform: uppercase; color: #3E4827; letter-spacing: 0.5px; margin: 0 0 5px 0; }
            .hq-sig-line { border-bottom: 1px solid #000000; height: 28px; width: 100%; margin: 0 0 6px 0; }
            .hq-sig-date { margin-top: 12px; }
            .hq-sig-date .hq-sig-line { max-width: 240px; }

            .hq-foot {
                border-top: 2px solid #3E4827;
                padding-top: 7px;
                text-align: center;
                font-size: 7pt;
                color: #3E4827;
                margin-top: 4px;
            }
            .hq-pg { text-align: center; font-size: 6.5pt; color: #888888; margin-top: 4px; }
        </style>
        <div class="hq-doc page article"
             t-att-data-oe-model="doc._name"
             t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>

    <!-- Cuerpo del documento -->
    <template id="hellenia_quote_body">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="product_count" t-value="len(lines_to_report.filtered(lambda l: not l.display_type and not l.is_downpayment))"/>
        <t t-set="spacer_cap" t-value="110 if product_count &lt;= 1 else (65 if product_count &lt;= 5 else (30 if product_count &lt;= 15 else 8))"/>
        <t t-set="sig_cap" t-value="0 if product_count &lt;= 5 else 10"/>
        <t t-set="bottom_spacer_px" t-value="min(doc.get_hellenia_quotation_bottom_spacer_px(), spacer_cap)"/>
        <t t-set="signature_spacer_px" t-value="min(doc.get_hellenia_quotation_signature_spacer_px(), sig_cap)"/>
        <t t-set="partner_phone" t-value="doc.partner_id.phone or doc.partner_id.mobile"/>
        <t t-set="hellenia_default_quotation_terms">(a) Las piezas ofrecidas son únicas y sujetas a disponibilidad.
(b) Esta cotización tiene una validez de 5 días.
(c) Se requiere confirmación del pago del 100% para reservar la pieza.
(d) Transporte disponible bajo cotización.
(e) Asesoría de colocación, instalación y styling disponible bajo cotización.
(f) Las piezas pueden presentar marcas propias del tiempo, lo cual forma parte de su carácter y autenticidad.</t>

        <table width="100%" cellpadding="0" cellspacing="0" class="hq-hdr">
            <tr>
                <td width="40%" style="padding-right: 14px;">
                    <img t-if="company.logo" class="hq-logo"
                         t-att-src="image_data_uri(company.logo)" alt="Hellenia"/>
                </td>
                <td width="60%" class="hq-co">
                    <div class="hq-co-name"><span t-field="company.name"/></div>
                    <div t-if="company.partner_id.street">
                        <span t-field="company.partner_id.street"/>
                        <t t-if="company.partner_id.city">, <span t-field="company.partner_id.city"/></t>
                    </div>
                    <div t-if="company.vat"><span class="hq-green" style="font-weight:bold;">RNC: </span><span t-field="company.vat"/></div>
                    <div t-if="company.phone"><span class="hq-green" style="font-weight:bold;">Tel.: </span><span t-field="company.phone"/></div>
                    <div t-if="company.email"><span class="hq-green" style="font-weight:bold;">Correo: </span><span t-field="company.email"/></div>
                    <div t-if="company.website"><span class="hq-green" style="font-weight:bold;">Web: </span><span t-field="company.website"/></div>
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" class="hq-band">
            <tr>
                <td width="50%" class="hq-band-title">COTIZACIÓN</td>
                <td width="50%">
                    <span class="hq-band-num">No. <span t-field="doc.name"/></span>
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" class="hq-dates">
            <tr>
                <td width="50%" t-if="doc.date_order">
                    <span class="hq-lbl">Fecha de Cotización: </span>
                    <span class="hq-val" style="font-weight:bold;">
                        <span t-out="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                    </span>
                </td>
                <td width="50%" align="right" t-if="doc.validity_date">
                    <span class="hq-lbl">Vencimiento: </span>
                    <span class="hq-val" style="font-weight:bold;">
                        <span t-out="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''"/>
                    </span>
                </td>
            </tr>
        </table>
        <hr class="hq-line-soft"/>

        <table width="100%" cellpadding="0" cellspacing="0" class="hq-cards">
            <tr>
                <td width="49%" class="hq-card">
                    <div class="hq-title">Información del Cliente</div>
                    <div class="hq-field">
                        <div class="hq-lbl">Cliente</div>
                        <div class="hq-val"><span t-field="doc.partner_id.name"/></div>
                    </div>
                    <div class="hq-field" t-if="doc.partner_id.vat">
                        <div class="hq-lbl">RNC</div>
                        <div class="hq-val"><span t-field="doc.partner_id.vat"/></div>
                    </div>
                    <div class="hq-field" t-if="partner_phone">
                        <div class="hq-lbl">Teléfono</div>
                        <div class="hq-val"><span t-out="partner_phone"/></div>
                    </div>
                    <div class="hq-field" t-if="doc.partner_id.email">
                        <div class="hq-lbl">Correo</div>
                        <div class="hq-val"><span t-field="doc.partner_id.email"/></div>
                    </div>
                </td>
                <td class="hq-vdiv">&#160;</td>
                <td width="49%" class="hq-card hq-card-r">
                    <div class="hq-title">Información del Vendedor</div>
                    <div class="hq-field" t-if="doc.user_id">
                        <div class="hq-lbl">Vendedor</div>
                        <div class="hq-val"><span t-field="doc.user_id.name"/></div>
                    </div>
                    <div class="hq-pay">
                        <div class="hq-title" style="margin-bottom:4px;">Términos de Pago</div>
                        <div class="hq-pay-val" t-out="doc.get_hellenia_payment_term_display()"/>
                    </div>
                </td>
            </tr>
        </table>

        <table class="hq-items" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th class="c-num">#</th>
                    <th>DESCRIPCIÓN</th>
                    <th class="c-qty">CANT.</th>
                    <th class="c-price">P. UNIT.</th>
                    <th class="c-sub">SUBTOTAL</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="n" t-value="0"/>
                <t t-foreach="lines_to_report" t-as="line">
                    <t t-if="not line.display_type and not line.is_downpayment">
                        <t t-set="n" t-value="n + 1"/>
                        <tr>
                            <td class="c-num"><span t-out="n"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="c-qty">
                                <span t-field="line.product_uom_qty"/>
                                <t t-if="line.product_uom_id"> <span t-field="line.product_uom_id"/></t>
                            </td>
                            <td class="c-price">
                                <span t-field="line.price_unit"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                            <td class="c-sub">
                                <span t-field="line.price_subtotal"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>

        <table class="hq-totals" cellpadding="0" cellspacing="0" align="right">
            <tr>
                <td class="t-lbl">Subtotal</td>
                <td class="t-val">
                    <span t-field="doc.amount_untaxed"
                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                </td>
            </tr>
            <tr>
                <td class="t-lbl">ITBIS (18%)</td>
                <td class="t-val">
                    <span t-field="doc.amount_tax"
                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                </td>
            </tr>
            <tr class="grand">
                <td class="t-lbl">TOTAL</td>
                <td class="t-val">
                    <span t-field="doc.amount_total"
                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                </td>
            </tr>
        </table>

        <div style="clear:both;height:1px;font-size:1px;">&#160;</div>

        <table class="hq-spacer" width="100%" cellpadding="0" cellspacing="0" t-if="bottom_spacer_px &gt; 0">
            <tr><td t-attf-style="height: {{ bottom_spacer_px }}px;">&#160;</td></tr>
        </table>

        <div class="hq-cond">
            <div class="hq-cond-title">CONDICIONES</div>
            <t t-if="doc.note">
                <div class="hq-cond-body" t-field="doc.note"/>
            </t>
            <t t-else="">
                <div class="hq-cond-body"
                     t-out="company.hellenia_quotation_terms or hellenia_default_quotation_terms"/>
            </t>
        </div>

        <table class="hq-spacer" width="100%" cellpadding="0" cellspacing="0" t-if="signature_spacer_px &gt; 0">
            <tr><td t-attf-style="height: {{ signature_spacer_px }}px;">&#160;</td></tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" class="hq-sigs">
            <tr>
                <td width="48%">
                    <div class="hq-sig-lbl">Entregado por</div>
                    <div class="hq-sig-line">&#160;</div>
                    <div class="hq-sig-date">
                        <div class="hq-sig-lbl">Fecha:</div>
                        <div class="hq-sig-line">&#160;</div>
                    </div>
                </td>
                <td width="4%"></td>
                <td width="48%">
                    <div class="hq-sig-lbl">Recibido por</div>
                    <div class="hq-sig-line">&#160;</div>
                </td>
            </tr>
        </table>

        <div class="hq-foot">
            <t t-if="company.phone"><span t-field="company.phone"/></t>
            <t t-if="company.email"> | <span t-field="company.email"/></t>
            <t t-if="company.website"> | <span t-field="company.website"/></t>
        </div>
        <div class="hq-pg">Página <span class="page"/> de <span class="topage"/></div>
    </template>

    <!-- Reporte principal — web.html_container (sin web.external_layout) -->
    <template id="report_hellenia_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-call="hellenia_reports.hellenia_quote_layout">
                    <t t-call="hellenia_reports.hellenia_quote_body"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
