<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_hellenia" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class" add="hellenia-invoice-doc" separator=" "/>
        </xpath>

        <!-- Título fiscal dinámico (sin Proforma Invoice) -->
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title" t-out="o.hellenia_fiscal_document_title()"/>
        </xpath>
        <xpath expr="//t[@name='draft_invoice_title']" position="replace">
            <t name="draft_invoice_title" t-out="o.hellenia_fiscal_document_title()"/>
        </xpath>
        <xpath expr="//t[@name='cancelled_invoice_title']" position="replace">
            <t name="cancelled_invoice_title">FACTURA CANCELADA</t>
        </xpath>
        <xpath expr="//t[@name='credit_note_title']" position="replace">
            <t name="credit_note_title">NOTA DE CRÉDITO</t>
        </xpath>
        <xpath expr="//t[@name='draft_credit_note_title']" position="replace">
            <t name="draft_credit_note_title">NOTA DE CRÉDITO</t>
        </xpath>
        <xpath expr="//t[@name='cancelled_credit_note_title']" position="replace">
            <t name="cancelled_credit_note_title">NOTA DE CRÉDITO CANCELADA</t>
        </xpath>
        <xpath expr="//t[@name='proforma_invoice_title']" position="replace">
            <t name="proforma_invoice_title" t-out="o.hellenia_fiscal_document_title()"/>
        </xpath>

        <!-- NCF destacado (sin QR — no e-CF) -->
        <xpath expr="//div[@id='informations']" position="before">
            <div class="hellenia-ncf-box row mb-3" t-if="o.justech_do_ncf">
                <div class="col-12">
                    <div class="hellenia-ncf-label">Número de Comprobante Fiscal</div>
                    <div class="hellenia-ncf-value" t-field="o.justech_do_ncf"/>
                    <div class="hellenia-ncf-legal text-muted small mt-1" t-if="o.hellenia_ncf_legal_note()">
                        <span t-out="o.hellenia_ncf_legal_note()"/>
                    </div>
                    <div t-if="o.hellenia_ncf_type_label()" class="hellenia-ncf-type">
                        <span t-out="o.hellenia_ncf_type_label()"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Etiquetas en español -->
        <xpath expr="//strong[text()='Invoice Date']" position="replace">
            <strong>Fecha de factura</strong>
        </xpath>
        <xpath expr="//strong[text()='Credit Note Date']" position="replace">
            <strong>Fecha de nota de crédito</strong>
        </xpath>
        <xpath expr="//strong[text()='Due Date']" position="replace">
            <strong>Fecha de vencimiento</strong>
        </xpath>
        <xpath expr="//strong[text()='Delivery Date']" position="replace">
            <strong>Fecha de entrega</strong>
        </xpath>
        <xpath expr="//strong[text()='Source']" position="replace">
            <strong>Origen</strong>
        </xpath>
        <xpath expr="//strong[text()='Customer Code']" position="replace">
            <strong>Código cliente</strong>
        </xpath>
        <xpath expr="//strong[text()='Reference']" position="replace">
            <strong>Referencia</strong>
        </xpath>
        <xpath expr="//span[text()='Untaxed Amount']" position="replace">
            <span>Subtotal</span>
        </xpath>
        <xpath expr="//span[text()='Payment Communication']" position="replace">
            <span>Concepto de pago</span>
        </xpath>
        <xpath expr="//span[text()='Amount Due']" position="replace">
            <span>Total pendiente</span>
        </xpath>

        <xpath expr="//th[@name='th_description']/span" position="replace">
            <span>Descripción</span>
        </xpath>
        <xpath expr="//th[@name='th_quantity']/span" position="replace">
            <span>Cantidad</span>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']/span" position="replace">
            <span>Precio unit.</span>
        </xpath>
        <xpath expr="//th[@name='th_taxes']/span" position="replace">
            <span>Impuestos</span>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']/span" position="replace">
            <span>Importe</span>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class" add="hellenia-lines-table" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="hellenia_reports.hellenia_document_footer_blocks"/>
        </xpath>
    </template>

    <!-- Ocultar bloque NCF duplicado de justech (ya integrado en caja destacada) -->
    <template id="report_invoice_document_hellenia_ncf_cleanup"
              inherit_id="justech_l10n_do_ncf.report_invoice_document_justech_ncf">
        <xpath expr="//div[@name='justech_ncf']" position="replace"/>
        <xpath expr="//div[@name='justech_doc_type']" position="replace"/>
    </template>

</odoo>
