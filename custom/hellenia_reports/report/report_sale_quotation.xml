<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cotización Hellenia 23.4B — réplica visual 1:1 -->
    <template id="hellenia_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="product_count" t-value="len(lines_to_report.filtered(lambda l: not l.display_type and not l.is_downpayment))"/>
        <t t-set="spacer_cap" t-value="110 if product_count &lt;= 1 else (65 if product_count &lt;= 5 else (30 if product_count &lt;= 15 else 8))"/>
        <t t-set="sig_cap" t-value="0 if product_count &lt;= 5 else 10"/>
        <t t-set="bottom_spacer_px" t-value="min(doc.get_hellenia_quotation_bottom_spacer_px(), spacer_cap)"/>
        <t t-set="signature_spacer_px" t-value="min(doc.get_hellenia_quotation_signature_spacer_px(), sig_cap)"/>
        <t t-set="hellenia_default_quotation_terms">(a) Las piezas ofrecidas son únicas y sujetas a disponibilidad.
(b) Esta cotización tiene una validez de 5 días.
(c) Se requiere confirmación del pago del 100% para reservar la pieza.
(d) Transporte disponible bajo cotización.
(e) Asesoría de colocación, instalación y styling disponible bajo cotización.
(f) Las piezas pueden presentar marcas propias del tiempo, lo cual forma parte de su carácter y autenticidad.</t>

        <div class="page article o_report_layout_standard hellenia-q4b-page"
             t-att-data-oe-model="doc._name"
             t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <style type="text/css">
                html, body { margin: 0; padding: 0; }
                h2.hellenia-doc-title,
                .o_report_layout_standard .address,
                .header.hellenia-header,
                .footer.hellenia-footer {
                    display: none !important;
                    height: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden !important;
                }
                .hellenia-article,
                .o_report_layout_standard.hellenia-article,
                .article.o_report_layout_standard {
                    margin: 0 !important;
                    padding: 0 !important;
                }

                /* Paleta única */
                .hellenia-q4b-page {
                    font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
                    font-size: 9pt;
                    color: #2d361c;
                    line-height: 1.45;
                    margin: 0;
                    padding: 0;
                    width: 100%;
                }
                .hellenia-q4b-page table { border-collapse: collapse; width: 100%; border: none; }
                .hellenia-q4b-page td,
                .hellenia-q4b-page th { border: none; }

                /* ── Header ── */
                .hq-hdr { margin: 0 0 8px 0; }
                .hq-hdr td { vertical-align: top; border: none; }
                .hq-logo-cell { width: 40%; padding: 0 16px 0 0; }
                .hq-logo {
                    max-height: 82px;
                    max-width: 240px;
                    width: auto;
                    height: auto;
                    display: block;
                }
                .hq-co { width: 60%; text-align: right; font-size: 7.5pt; color: #2d361c; line-height: 1.55; }
                .hq-co-name { font-size: 11pt; font-weight: bold; color: #3E4827; margin: 0 0 3px 0; }
                .hq-co-line { margin: 0; padding: 0; }
                .hq-co-lbl { font-weight: bold; color: #3E4827; }

                /* ── Banda verde (todo blanco) ── */
                .hq-band { background-color: #3E4827; }
                .hq-band td { padding: 11px 14px; vertical-align: middle; background-color: #3E4827; }
                .hq-band-title {
                    font-size: 11pt;
                    font-weight: bold;
                    letter-spacing: 2.5px;
                    text-transform: uppercase;
                    color: #ffffff;
                }
                .hq-band-num-cell { text-align: right; }
                .hq-band-num {
                    display: inline-block;
                    color: #ffffff;
                    font-weight: bold;
                    font-size: 10pt;
                    padding-left: 16px;
                    border-left: 1px solid #ffffff;
                }
                .hq-band-num span { color: #ffffff; }

                /* ── Separadores (solo 3 tipos) ── */
                .hq-rule-light {
                    border: none;
                    border-bottom: 1px solid #e0e0e0;
                    margin: 0;
                    height: 0;
                }
                .hq-rule-mid {
                    border: none;
                    border-bottom: 1px solid #c8c8c8;
                    margin: 0;
                    height: 0;
                }

                /* ── Fechas ── */
                .hq-dates td { padding: 8px 0; }
                .hq-dt-lbl {
                    font-size: 6.5pt;
                    text-transform: uppercase;
                    color: #3E4827;
                    font-weight: bold;
                    letter-spacing: 0.5px;
                }
                .hq-dt-val { font-size: 9pt; font-weight: bold; color: #2d361c; }

                /* ── Tarjetas cliente / vendedor (sin tabla interna) ── */
                .hq-cards { margin: 14px 0 18px 0; }
                .hq-card { vertical-align: top; padding: 4px 16px 4px 0; }
                .hq-card-right { padding: 4px 0 4px 16px; }
                .hq-card-div {
                    width: 1px;
                    background-color: #e0e0e0;
                    padding: 0;
                    font-size: 1px;
                }
                .hq-card-title {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 0.8px;
                    margin: 0 0 12px 0;
                }
                .hq-card-title svg { vertical-align: middle; margin-right: 5px; }
                .hq-card-title span { vertical-align: middle; }
                .hq-field { margin: 0 0 10px 0; padding: 0; }
                .hq-field-lbl {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 0.5px;
                    margin: 0 0 2px 0;
                }
                .hq-field-val { font-size: 9pt; color: #2d361c; margin: 0; }
                .hq-pay-section { margin-top: 14px; }
                .hq-pay-val { font-size: 9.5pt; font-weight: bold; color: #2d361c; margin-top: 4px; }

                /* ── Tabla productos (solo encabezado verde + línea fina) ── */
                .hq-items { margin: 0 0 6px 0; }
                .hq-items thead th {
                    background-color: #3E4827;
                    color: #ffffff;
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    padding: 11px 12px;
                }
                .hq-items thead th,
                .hq-items thead th span { color: #ffffff; }
                .hq-items tbody td {
                    padding: 11px 12px;
                    font-size: 8.5pt;
                    color: #2d361c;
                    vertical-align: middle;
                    border: none;
                    border-bottom: 1px solid #f0f0f0;
                }
                .hq-items tbody tr:last-child td { border-bottom: none; }
                .hq-items .c-num { text-align: center; width: 30px; color: #3E4827; }
                .hq-items .c-qty,
                .hq-items .c-price,
                .hq-items .c-sub { text-align: right; white-space: nowrap; }
                .hq-items .c-sub { font-weight: bold; color: #2d361c; }
                .hq-items .row-section td {
                    font-weight: bold;
                    color: #3E4827;
                    background: transparent;
                    border-bottom: 1px solid #f0f0f0;
                }
                .hq-items .row-note td {
                    font-style: italic;
                    color: #2d361c;
                    border-bottom: 1px solid #f0f0f0;
                }

                /* ── Totales (TOTAL protagonista) ── */
                .hq-totals { width: 300px; margin: 12px 0 14px auto; }
                .hq-totals td { padding: 6px 4px; font-size: 8.5pt; border: none; }
                .hq-totals .t-lbl { color: #3E4827; text-align: left; width: 50%; font-weight: bold; }
                .hq-totals .t-val { color: #2d361c; font-weight: bold; text-align: right; width: 50%; }
                .hq-totals tr.t-grand td {
                    border-top: 2px solid #3E4827;
                    padding-top: 12px;
                    padding-bottom: 4px;
                }
                .hq-totals tr.t-grand .t-lbl {
                    font-size: 11pt;
                    font-weight: bold;
                    color: #3E4827;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }
                .hq-totals tr.t-grand .t-val {
                    font-size: 15pt;
                    font-weight: bold;
                    color: #3E4827;
                }

                /* ── Espaciador ── */
                .hq-spacer { font-size: 1px; line-height: 1px; }
                .hq-spacer td { font-size: 1px; line-height: 1px; }

                /* ── Condiciones (sin caja) ── */
                .hq-cond { margin: 0 0 12px 0; }
                .hq-cond-title {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 0.8px;
                    margin: 0 0 8px 0;
                    padding: 0 0 4px 0;
                    border-bottom: 1px solid #c8c8c8;
                    display: inline-block;
                    min-width: 100px;
                }
                .hq-cond-body {
                    font-size: 7.5pt;
                    color: #2d361c;
                    line-height: 1.55;
                    white-space: pre-line;
                }

                /* ── Firmas (minimalistas) ── */
                .hq-sigs { margin: 0 0 10px 0; }
                .hq-sigs td { vertical-align: top; padding: 0; border: none; }
                .hq-sig-title {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 0.7px;
                    margin: 0 0 6px 0;
                }
                .hq-sig-title svg { vertical-align: middle; margin-right: 5px; }
                .hq-sig-title span { vertical-align: middle; }
                .hq-sig-line {
                    border-bottom: 1px solid #2d361c;
                    height: 30px;
                    width: 100%;
                    margin: 0 0 4px 0;
                }
                .hq-sig-date { margin-top: 14px; }
                .hq-sig-date .hq-sig-line { max-width: 250px; }

                /* ── Footer ── */
                .hq-foot {
                    border-top: 1px solid #e0e0e0;
                    padding-top: 7px;
                    text-align: center;
                    font-size: 7pt;
                    color: #3E4827;
                }
                .hq-page {
                    text-align: center;
                    font-size: 6.5pt;
                    color: #3E4827;
                    margin-top: 4px;
                    opacity: 0.6;
                }
            </style>

            <!-- HEADER -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-hdr">
                <tr>
                    <td class="hq-logo-cell">
                        <img t-if="company.logo" class="hq-logo"
                             t-att-src="image_data_uri(company.logo)" alt="Hellenia"/>
                    </td>
                    <td class="hq-co">
                        <div class="hq-co-name"><span t-field="company.name"/></div>
                        <div class="hq-co-line" t-if="company.partner_id.street">
                            <span t-field="company.partner_id.street"/>
                            <t t-if="company.partner_id.city">, <span t-field="company.partner_id.city"/></t>
                        </div>
                        <div class="hq-co-line" t-if="company.vat">
                            <span class="hq-co-lbl">RNC: </span><span t-field="company.vat"/>
                        </div>
                        <div class="hq-co-line" t-if="company.phone">
                            <span class="hq-co-lbl">Tel.: </span><span t-field="company.phone"/>
                        </div>
                        <div class="hq-co-line" t-if="company.email">
                            <span class="hq-co-lbl">Correo: </span><span t-field="company.email"/>
                        </div>
                        <div class="hq-co-line" t-if="company.website">
                            <span class="hq-co-lbl">Web: </span><span t-field="company.website"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- BANDA VERDE -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-band">
                <tr>
                    <td width="55%" class="hq-band-title">COTIZACIÓN</td>
                    <td width="45%" class="hq-band-num-cell">
                        <span class="hq-band-num">No. <span t-field="doc.name"/></span>
                    </td>
                </tr>
            </table>

            <!-- FECHAS (entre dos líneas finas) -->
            <hr class="hq-rule-light"/>
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-dates">
                <tr>
                    <td width="50%" t-if="doc.date_order">
                        <span class="hq-dt-lbl">Fecha de Cotización: </span>
                        <span class="hq-dt-val">
                            <span t-out="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                        </span>
                    </td>
                    <td width="50%" align="right" t-if="doc.validity_date">
                        <span class="hq-dt-lbl">Vencimiento: </span>
                        <span class="hq-dt-val">
                            <span t-out="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''"/>
                        </span>
                    </td>
                </tr>
            </table>
            <hr class="hq-rule-light"/>

            <!-- TARJETAS CLIENTE / VENDEDOR -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-cards">
                <tr>
                    <td width="49%" class="hq-card">
                        <div class="hq-card-title">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="#3E4827" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                            <span>Información del Cliente</span>
                        </div>
                        <div class="hq-field">
                            <div class="hq-field-lbl">Cliente</div>
                            <div class="hq-field-val"><span t-field="doc.partner_id.name"/></div>
                        </div>
                        <div class="hq-field" t-if="doc.partner_id.vat">
                            <div class="hq-field-lbl">RNC</div>
                            <div class="hq-field-val"><span t-field="doc.partner_id.vat"/></div>
                        </div>
                        <div class="hq-field" t-if="doc.partner_id.phone">
                            <div class="hq-field-lbl">Teléfono</div>
                            <div class="hq-field-val"><span t-field="doc.partner_id.phone"/></div>
                        </div>
                        <div class="hq-field" t-if="doc.partner_id.email">
                            <div class="hq-field-lbl">Correo</div>
                            <div class="hq-field-val"><span t-field="doc.partner_id.email"/></div>
                        </div>
                    </td>
                    <td class="hq-card-div">&#160;</td>
                    <td width="49%" class="hq-card hq-card-right">
                        <div class="hq-card-title">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="#3E4827" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                            <span>Información del Vendedor</span>
                        </div>
                        <div class="hq-field" t-if="doc.user_id">
                            <div class="hq-field-lbl">Vendedor</div>
                            <div class="hq-field-val"><span t-field="doc.user_id.name"/></div>
                        </div>
                        <div class="hq-pay-section">
                            <div class="hq-card-title" style="margin-bottom: 6px;">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="#3E4827" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                                </svg>
                                <span>Términos de Pago</span>
                            </div>
                            <div class="hq-pay-val" t-out="doc.get_hellenia_payment_term_display()"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- PRODUCTOS -->
            <table class="hq-items" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th class="c-num">#</th>
                        <th>DESCRIPCIÓN</th>
                        <th class="c-qty">CANT.</th>
                        <th class="c-price">P. UNIT.</th>
                        <th class="c-sub">SUBTOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="product_line_num" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-if="line.display_type == 'line_section'">
                            <tr class="row-section">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr class="row-note">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="not line.display_type and not line.is_downpayment">
                            <t t-set="product_line_num" t-value="product_line_num + 1"/>
                            <tr>
                                <td class="c-num"><span t-out="product_line_num"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="c-qty">
                                    <span t-field="line.product_uom_qty"/>
                                    <t t-if="line.product_uom_id"> <span t-field="line.product_uom_id"/></t>
                                </td>
                                <td class="c-price">
                                    <span t-field="line.price_unit"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="c-sub">
                                    <span t-field="line.price_subtotal"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- TOTALES -->
            <table class="hq-totals" cellpadding="0" cellspacing="0" align="right">
                <tr>
                    <td class="t-lbl">Subtotal</td>
                    <td class="t-val">
                        <span t-field="doc.amount_untaxed"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="t-lbl">ITBIS</td>
                    <td class="t-val">
                        <span t-field="doc.amount_tax"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr class="t-grand">
                    <td class="t-lbl">TOTAL</td>
                    <td class="t-val">
                        <span t-field="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </table>

            <div style="clear: both; height: 1px; font-size: 1px;">&#160;</div>

            <table class="hq-spacer" width="100%" cellpadding="0" cellspacing="0"
                   t-if="bottom_spacer_px &gt; 0">
                <tr><td t-attf-style="height: {{ bottom_spacer_px }}px;">&#160;</td></tr>
            </table>

            <!-- CONDICIONES -->
            <div class="hq-cond">
                <div class="hq-cond-title">CONDICIONES</div>
                <t t-if="doc.note">
                    <div class="hq-cond-body" t-field="doc.note"/>
                </t>
                <t t-else="">
                    <div class="hq-cond-body"
                         t-out="company.hellenia_quotation_terms or hellenia_default_quotation_terms"/>
                </t>
            </div>

            <table class="hq-spacer" width="100%" cellpadding="0" cellspacing="0"
                   t-if="signature_spacer_px &gt; 0">
                <tr><td t-attf-style="height: {{ signature_spacer_px }}px;">&#160;</td></tr>
            </table>

            <!-- FIRMAS -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-sigs">
                <tr>
                    <td width="48%">
                        <div class="hq-sig-title">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="#3E4827" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                            </svg>
                            <span>Entregado por</span>
                        </div>
                        <div class="hq-sig-line">&#160;</div>
                        <div class="hq-sig-date">
                            <div class="hq-sig-title">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="#3E4827" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/>
                                </svg>
                                <span>Fecha:</span>
                            </div>
                            <div class="hq-sig-line">&#160;</div>
                        </div>
                    </td>
                    <td width="4%"></td>
                    <td width="48%">
                        <div class="hq-sig-title">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="#3E4827" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                            <span>Recibido por</span>
                        </div>
                        <div class="hq-sig-line">&#160;</div>
                    </td>
                </tr>
            </table>

            <!-- FOOTER -->
            <div class="hq-foot">
                <t t-if="company.phone"><span t-field="company.phone"/></t>
                <t t-if="company.email"> | <span t-field="company.email"/></t>
                <t t-if="company.website"> | <span t-field="company.website"/></t>
            </div>
            <div class="hq-page">
                Página <span class="page"/> de <span class="topage"/>
            </div>
        </div>
    </template>

    <template id="report_saleorder_raw_hellenia_quotation" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace">
            <t t-if="doc.state in ['draft', 'sent']"
               t-call="hellenia_reports.hellenia_quotation_document"
               t-lang="doc.partner_id.lang"/>
            <t t-else=""
