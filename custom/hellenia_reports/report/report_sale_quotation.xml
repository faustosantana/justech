<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cotización Hellenia — compacto, wkhtmltopdf-safe -->
    <template id="hellenia_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="sp" t-value="doc.user_id.partner_id if doc.user_id else False"/>
        <t t-set="bottom_spacer_px" t-value="doc.get_hellenia_quotation_bottom_spacer_px()"/>
        <t t-set="signature_spacer_px" t-value="doc.get_hellenia_quotation_signature_spacer_px()"/>
        <t t-set="hellenia_default_quotation_terms">(a) Las piezas ofrecidas son únicas y sujetas a disponibilidad.
(b) Esta cotización tiene una validez de 5 días.
(c) Se requiere confirmación del pago del 100% para reservar la pieza.
(d) Transporte disponible bajo cotización.
(e) Asesoría de colocación, instalación y styling disponible bajo cotización.
(f) Las piezas pueden presentar marcas propias del tiempo, lo cual forma parte de su carácter y autenticidad.</t>

        <div class="page article o_report_layout_standard hellenia-quote-page"
             t-att-data-oe-model="doc._name"
             t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <style type="text/css">
                h2.hellenia-doc-title,
                .o_report_layout_standard .address,
                .header.hellenia-header,
                .footer.hellenia-footer {
                    display: none !important;
                    height: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden !important;
                }
                .hellenia-quote-page {
                    font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
                    font-size: 9.5pt;
                    color: #2d2d2d;
                    line-height: 1.35;
                    margin: -4mm 0 0 0;
                    padding: 0;
                    width: 100%;
                }
                .hellenia-quote-page table { border-collapse: collapse; width: 100%; }
                .hellenia-quote-hdr-table,
                .hellenia-quote-hdr-table td {
                    border: none !important;
                    background: transparent;
                }
                .hellenia-quote-hdr-logo-cell {
                    border-right: 1px solid #e5e5e5;
                    padding: 0 10px 0 0;
                    vertical-align: top;
                }
                .hellenia-quote-logo {
                    max-height: 75px;
                    max-width: 220px;
                    width: auto;
                    height: auto;
                    display: block;
                    margin: 0;
                }
                .hellenia-quote-hdr-right {
                    font-size: 8pt;
                    color: #5c5c5c;
                    text-align: right;
                    vertical-align: top;
                    line-height: 1.3;
                    padding: 0 0 0 10px;
                }
                .hellenia-quote-company-name {
                    font-size: 11pt;
                    font-weight: bold;
                    color: #3E4827;
                    margin-bottom: 1px;
                }
                .hellenia-quote-band {
                    background-color: #3E4827;
                    color: #ffffff;
                    margin: 2px 0 6px 0;
                }
                .hellenia-quote-band td { padding: 4px 10px; vertical-align: middle; }
                .hellenia-quote-band-title {
                    font-size: 11pt;
                    font-weight: bold;
                    letter-spacing: 1.5px;
                }
                .hellenia-quote-num-box {
                    background-color: #ffffff;
                    color: #3E4827;
                    font-weight: bold;
                    font-size: 10pt;
                    padding: 4px 10px;
                    text-align: center;
                    display: inline-block;
                }
                .hellenia-quote-label {
                    font-size: 7pt;
                    text-transform: uppercase;
                    color: #8a8a8a;
                    font-weight: bold;
                    letter-spacing: 0.4px;
                }
                .hellenia-quote-value {
                    font-size: 9pt;
                    font-weight: bold;
                    color: #2d2d2d;
                }
                .hellenia-quote-box {
                    border: 1px solid #e5e5e5;
                    padding: 6px 8px;
                    vertical-align: top;
                }
                .hellenia-quote-box-title {
                    font-size: 7pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    border-bottom: 1px solid #e5e5e5;
                    padding-bottom: 3px;
                    margin-bottom: 4px;
                    letter-spacing: 0.4px;
                }
                .hellenia-quote-field-label {
                    font-size: 7pt;
                    color: #8a8a8a;
                    font-weight: bold;
                    text-transform: uppercase;
                    padding-top: 2px;
                }
                .hellenia-quote-field-value {
                    font-size: 8.5pt;
                    color: #2d2d2d;
                    padding-bottom: 1px;
                }
                .hellenia-quote-items {
                    width: 100%;
                    margin: 8px 0;
                }
                .hellenia-quote-items th {
                    background-color: #3E4827;
                    color: #ffffff;
                    font-size: 7pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    padding: 5px 6px;
                    border: 1px solid #3E4827;
                }
                .hellenia-quote-items td {
                    padding: 4px 6px;
                    border-bottom: 1px solid #e5e5e5;
                    font-size: 8.5pt;
                    vertical-align: top;
                }
                .hellenia-quote-items .num { text-align: center; width: 26px; }
                .hellenia-quote-items .qty,
                .hellenia-quote-items .price,
                .hellenia-quote-items .sub { text-align: right; white-space: nowrap; }
                .hellenia-quote-totals {
                    width: 250px;
                    margin-left: auto;
                    margin-bottom: 8px;
                }
                .hellenia-quote-totals td {
                    padding: 3px 8px;
                    font-size: 8.5pt;
                    border-bottom: 1px solid #e5e5e5;
                }
                .hellenia-quote-totals .lbl { color: #5c5c5c; }
                .hellenia-quote-totals .val { text-align: right; font-weight: bold; }
                .hellenia-quote-totals .grand td {
                    background-color: #f0f2ec;
                    border-top: 2px solid #3E4827;
                    border-bottom: 2px solid #3E4827;
                    font-size: 10.5pt;
                    font-weight: bold;
                    color: #3E4827;
                    padding: 6px 8px;
                }
                .hellenia-quote-totals .grand .lbl {
                    color: #3E4827;
                    font-weight: bold;
                }
                .hellenia-quote-bottom-spacer {
                    width: 100%;
                    font-size: 1px;
                    line-height: 1px;
                }
                .hellenia-quote-bottom-spacer td {
                    max-height: 255px !important;
                    overflow: hidden;
                }
                .hellenia-quote-conditions ~ table.hellenia-quote-bottom-spacer td {
                    max-height: 40px !important;
                }
                .hellenia-quote-conditions {
                    border: 1px solid #e5e5e5;
                    padding: 8px 10px;
                    margin-bottom: 10px;
                }
                .hellenia-quote-conditions-title {
                    font-size: 7pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    margin-bottom: 5px;
                    letter-spacing: 0.4px;
                }
                .hellenia-quote-conditions-body {
                    font-size: 8pt;
                    color: #5c5c5c;
                    line-height: 1.4;
                    white-space: pre-line;
                }
                .hellenia-quote-signatures {
                    width: 100%;
                    margin: 4px 0 14px 0;
                    padding-top: 4px;
                }
                .hellenia-quote-signatures td {
                    border: none;
                    padding: 0 6px 0 0;
                    vertical-align: top;
                }
                .hellenia-quote-sig-label {
                    font-size: 7pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 0.6px;
                    margin-bottom: 3px;
                }
                .hellenia-quote-sig-line {
                    border-bottom: 1px solid #5c5c5c;
                    height: 24px;
                    width: 100%;
                    min-width: 220px;
                }
                .hellenia-quote-sig-line-date {
                    max-width: 280px;
                }
                .hellenia-quote-footer {
                    border-top: 1px solid #3E4827;
                    padding-top: 6px;
                    font-size: 7.5pt;
                    color: #5c5c5c;
                    text-align: center;
                    margin-top: 4px;
                }
            </style>

            <!-- Encabezado sin marco -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hellenia-quote-hdr-table" style="margin: 0 0 2px 0;">
                <tr>
                    <td width="40%" class="hellenia-quote-hdr-logo-cell">
                        <img t-if="company.logo"
                             class="hellenia-quote-logo"
                             style="max-height: 75px; max-width: 220px; height: auto; width: auto; margin: 0;"
                             t-att-src="image_data_uri(company.logo)"
                             alt="Hellenia"/>
                    </td>
                    <td width="60%" class="hellenia-quote-hdr-right">
                        <div class="hellenia-quote-company-name" t-field="company.name"/>
                        <div t-if="company.partner_id.street">
                            <span t-field="company.partner_id.street"/>
                            <t t-if="company.partner_id.city">, <span t-field="company.partner_id.city"/></t>
                        </div>
                        <div t-if="company.vat"><strong>RNC:</strong> <span t-field="company.vat"/></div>
                        <div t-if="company.phone"><strong>Tel.:</strong> <span t-field="company.phone"/></div>
                        <div t-if="company.email"><strong>Correo:</strong> <span t-field="company.email"/></div>
                        <div t-if="company.website"><strong>Web:</strong> <span t-field="company.website"/></div>
                    </td>
                </tr>
            </table>

            <!-- Banda título -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hellenia-quote-band">
                <tr>
                    <td class="hellenia-quote-band-title">COTIZACIÓN</td>
                    <td align="right">
                        <span class="hellenia-quote-num-box">No. <span t-field="doc.name"/></span>
                    </td>
                </tr>
            </table>

            <!-- Fechas en una fila -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 8px;">
                <tr>
                    <td width="50%" valign="top" t-if="doc.date_order">
                        <span class="hellenia-quote-label">Fecha de Cotización: </span>
                        <span class="hellenia-quote-value">
                            <span t-out="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                        </span>
                    </td>
                    <td width="50%" valign="top" align="right" t-if="doc.validity_date">
                        <span class="hellenia-quote-label">Vencimiento: </span>
                        <span class="hellenia-quote-value">
                            <span t-out="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''"/>
                        </span>
                    </td>
                </tr>
            </table>

            <!-- Cliente / Vendedor -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 8px;">
                <tr>
                    <td width="49%" valign="top" class="hellenia-quote-box" style="padding-right: 6px;">
                        <div class="hellenia-quote-box-title">INFORMACIÓN DEL CLIENTE</div>
                        <div class="hellenia-quote-field-label">Cliente</div>
                        <div class="hellenia-quote-field-value" t-field="doc.partner_id.name"/>
                        <t t-if="doc.partner_id.street or doc.partner_id.city">
                            <div class="hellenia-quote-field-label">Dirección</div>
                            <div class="hellenia-quote-field-value">
                                <span t-if="doc.partner_id.street" t-field="doc.partner_id.street"/>
                                <t t-if="doc.partner_id.street and doc.partner_id.city">, </t>
                                <span t-if="doc.partner_id.city" t-field="doc.partner_id.city"/>
                            </div>
                        </t>
                        <t t-if="doc.partner_id.vat">
                            <div class="hellenia-quote-field-label">RNC</div>
                            <div class="hellenia-quote-field-value" t-field="doc.partner_id.vat"/>
                        </t>
                        <t t-if="doc.partner_id.phone">
                            <div class="hellenia-quote-field-label">Teléfono</div>
                            <div class="hellenia-quote-field-value" t-field="doc.partner_id.phone"/>
                        </t>
                        <t t-if="doc.partner_id.email">
                            <div class="hellenia-quote-field-label">Correo</div>
                            <div class="hellenia-quote-field-value" t-field="doc.partner_id.email"/>
                        </t>
                    </td>
                    <td width="2%"></td>
                    <td width="49%" valign="top" class="hellenia-quote-box">
                        <div class="hellenia-quote-box-title">INFORMACIÓN DEL VENDEDOR</div>
                        <t t-if="doc.user_id">
                            <div class="hellenia-quote-field-label">Vendedor</div>
                            <div class="hellenia-quote-field-value" t-field="doc.user_id.name"/>
                        </t>
                        <t t-if="sp and sp.phone">
                            <div class="hellenia-quote-field-label">Teléfono</div>
                            <div class="hellenia-quote-field-value" t-field="sp.phone"/>
                        </t>
                        <t t-if="doc.user_id and doc.user_id.email">
                            <div class="hellenia-quote-field-label">Correo</div>
                            <div class="hellenia-quote-field-value" t-field="doc.user_id.email"/>
                        </t>
                        <div class="hellenia-quote-box-title" style="margin-top: 6px;">TÉRMINOS DE PAGO</div>
                        <div class="hellenia-quote-field-value" t-out="doc.get_hellenia_payment_term_display()"/>
                    </td>
                </tr>
            </table>

            <!-- Productos -->
            <table class="hellenia-quote-items" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th class="num">#</th>
                        <th>DESCRIPCIÓN</th>
                        <th class="qty">CANT.</th>
                        <th class="price">P. UNIT.</th>
                        <th class="sub">SUBTOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="product_line_num" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-if="line.display_type == 'line_section'">
                            <tr>
                                <td colspan="5" style="background-color: #f8f9f6; font-weight: bold; color: #3E4827; font-size: 8.5pt;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td colspan="5" style="font-style: italic; color: #5c5c5c; font-size: 8pt;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="not line.display_type and not line.is_downpayment">
                            <t t-set="product_line_num" t-value="product_line_num + 1"/>
                            <tr>
                                <td class="num"><span t-out="product_line_num"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="qty">
                                    <span t-field="line.product_uom_qty"/>
                                    <t t-if="line.product_uom_id"> <span t-field="line.product_uom_id"/></t>
                                </td>
                                <td class="price">
                                    <span t-field="line.price_unit"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="sub">
                                    <span t-field="line.price_subtotal"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- Totales -->
            <table class="hellenia-quote-totals" cellpadding="0" cellspacing="0" align="right">
                <tr>
                    <td class="lbl">Subtotal</td>
                    <td class="val">
                        <span t-field="doc.amount_untaxed"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="lbl">ITBIS</td>
                    <td class="val">
                        <span t-field="doc.amount_tax"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr class="grand">
                    <td class="lbl">Total</td>
                    <td class="val">
                        <span t-field="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </table>

            <div style="clear: both; height: 1px;"></div>

            <!-- Espaciador: empuja condiciones/firmas hacia el cierre con pocos productos -->
            <table class="hellenia-quote-bottom-spacer" width="100%" cellpadding="0" cellspacing="0"
                   t-if="bottom_spacer_px &gt; 0">
                <tr>
                    <td t-attf-style="height: {{ bottom_spacer_px }}px; font-size: 1px; line-height: 1px;">&#160;</td>
                </tr>
            </table>

            <!-- Condiciones -->
            <div class="hellenia-quote-conditions">
                <div class="hellenia-quote-conditions-title">CONDICIONES</div>
                <t t-if="doc.note">
                    <div class="hellenia-quote-conditions-body" t-field="doc.note"/>
                </t>
                <t t-else="">
                    <div class="hellenia-quote-conditions-body"
                         t-out="company.hellenia_quotation_terms or hellenia_default_quotation_terms"/>
                </t>
            </div>

            <!-- Espaciador antes de firmas -->
            <table class="hellenia-quote-bottom-spacer" width="100%" cellpadding="0" cellspacing="0"
                   t-if="signature_spacer_px &gt; 0">
                <tr>
                    <td t-attf-style="height: {{ signature_spacer_px }}px; font-size: 1px; line-height: 1px;">&#160;</td>
                </tr>
            </table>

            <!-- Firmas -->
            <table class="hellenia-quote-signatures" cellpadding="0" cellspacing="0">
                <tr>
                    <td width="48%">
                        <div class="hellenia-quote-sig-label">Entregado por</div>
                        <div class="hellenia-quote-sig-line">&#160;</div>
                    </td>
                    <td width="4%"></td>
                    <td width="48%">
                        <div class="hellenia-quote-sig-label">Recibido por</div>
                        <div class="hellenia-quote-sig-line">&#160;</div>
                    </td>
                </tr>
                <tr>
                    <td colspan="3" style="padding-top: 10px;">
                        <div class="hellenia-quote-sig-label">Fecha</div>
                        <div class="hellenia-quote-sig-line hellenia-quote-sig-line-date">&#160;</div>
                    </td>
                </tr>
            </table>

            <!-- Pie -->
            <div class="hellenia-quote-footer">
                <t t-if="company.phone"><span t-field="company.phone"/></t>
                <t t-if="company.email"> | <span t-field="company.email"/></t>
                <t t-if="company.website"> | <span t-field="company.website"/></t>
            </div>
        </div>
    </template>

    <template id="report_saleorder_raw_hellenia_quotation" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace">
            <t t-if="doc.state in ['draft', 'sent']"
               t-call="hellenia_reports.hellenia_quotation_document"
               t-lang="doc.partner_id.lang"/>
            <t t-else=""
               t-call="sale.report_saleorder_document"
               t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

</odoo>
