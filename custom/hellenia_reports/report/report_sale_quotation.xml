<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cotización Hellenia 23.4 — reconstrucción completa (referencia visual premium) -->
    <template id="hellenia_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="product_count" t-value="len(lines_to_report.filtered(lambda l: not l.display_type and not l.is_downpayment))"/>
        <t t-set="spacer_cap" t-value="110 if product_count &lt;= 1 else (65 if product_count &lt;= 5 else (30 if product_count &lt;= 15 else 8))"/>
        <t t-set="sig_cap" t-value="0 if product_count &lt;= 5 else 10"/>
        <t t-set="bottom_spacer_px" t-value="min(doc.get_hellenia_quotation_bottom_spacer_px(), spacer_cap)"/>
        <t t-set="signature_spacer_px" t-value="min(doc.get_hellenia_quotation_signature_spacer_px(), sig_cap)"/>
        <t t-set="hellenia_default_quotation_terms">(a) Las piezas ofrecidas son únicas y sujetas a disponibilidad.
(b) Esta cotización tiene una validez de 5 días.
(c) Se requiere confirmación del pago del 100% para reservar la pieza.
(d) Transporte disponible bajo cotización.
(e) Asesoría de colocación, instalación y styling disponible bajo cotización.
(f) Las piezas pueden presentar marcas propias del tiempo, lo cual forma parte de su carácter y autenticidad.</t>

        <div class="page article o_report_layout_standard hellenia-q4-page"
             t-att-data-oe-model="doc._name"
             t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <style type="text/css">
                html, body { margin: 0; padding: 0; }
                h2.hellenia-doc-title,
                .o_report_layout_standard .address,
                .header.hellenia-header,
                .footer.hellenia-footer {
                    display: none !important;
                    height: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden !important;
                }
                .hellenia-article,
                .o_report_layout_standard.hellenia-article,
                .article.o_report_layout_standard {
                    margin: 0 !important;
                    padding: 0 !important;
                }

                .hellenia-q4-page {
                    font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
                    font-size: 9pt;
                    color: #1a1a1a;
                    line-height: 1.45;
                    margin: 0;
                    padding: 0;
                    width: 100%;
                }
                .hellenia-q4-page table {
                    border-collapse: collapse;
                    width: 100%;
                }
                .hellenia-q4-page td,
                .hellenia-q4-page th { border: none; }

                /* Header */
                .hq-header { margin: 0 0 8px 0; }
                .hq-header td { vertical-align: top; }
                .hq-logo-cell { width: 42%; padding: 0 16px 0 0; }
                .hq-logo {
                    max-height: 82px;
                    max-width: 240px;
                    width: auto;
                    height: auto;
                    display: block;
                    margin: 0;
                }
                .hq-co-block {
                    width: 58%;
                    text-align: right;
                    font-size: 7.5pt;
                    color: #6b7280;
                    line-height: 1.55;
                    padding: 0;
                }
                .hq-co-name {
                    font-size: 11pt;
                    font-weight: bold;
                    color: #3E4827;
                    margin: 0 0 3px 0;
                }
                .hq-co-line { margin: 0; padding: 0; }

                /* Banda documento */
                .hq-band {
                    background-color: #3E4827;
                    color: #ffffff;
                    margin: 0;
                }
                .hq-band td { padding: 9px 14px; vertical-align: middle; }
                .hq-band-title {
                    font-size: 11pt;
                    font-weight: bold;
                    letter-spacing: 3px;
                    text-transform: uppercase;
                }
                .hq-band-num {
                    display: inline-block;
                    background-color: #354020;
                    border: 1px solid rgba(255, 255, 255, 0.35);
                    color: #ffffff;
                    font-weight: bold;
                    font-size: 10pt;
                    padding: 5px 14px;
                    letter-spacing: 0.4px;
                }
                .hq-band-rule {
                    border: none;
                    border-bottom: 1px solid #d1d5db;
                    margin: 0 0 10px 0;
                    height: 0;
                }

                /* Fechas */
                .hq-dates { margin: 0 0 14px 0; }
                .hq-meta-lbl {
                    font-size: 6.5pt;
                    text-transform: uppercase;
                    color: #9ca3af;
                    font-weight: bold;
                    letter-spacing: 0.7px;
                }
                .hq-meta-val {
                    font-size: 9pt;
                    font-weight: bold;
                    color: #111827;
                }

                /* Bloques cliente / vendedor */
                .hq-parties { margin: 0 0 18px 0; }
                .hq-party-col {
                    width: 49%;
                    vertical-align: top;
                    background-color: #fafafa;
                    padding: 9px 12px;
                }
                .hq-party-col-right {
                    border-left: 1px solid #e5e7eb;
                }
                .hq-party-gap { width: 2%; }
                .hq-sec-head {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #6b7280;
                    letter-spacing: 0.9px;
                    margin: 0 0 10px 0;
                    padding: 0;
                }
                .hq-sec-head svg {
                    vertical-align: middle;
                    margin-right: 5px;
                }
                .hq-sec-head span { vertical-align: middle; }
                .hq-fld-lbl {
                    font-size: 6.5pt;
                    color: #9ca3af;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.6px;
                    padding: 5px 0 1px 0;
                }
                .hq-fld-val {
                    font-size: 9pt;
                    color: #1f2937;
                    padding: 0 0 1px 0;
                }
                .hq-pay-block { margin-top: 12px; padding-top: 10px; }
                .hq-pay-val {
                    font-size: 9.5pt;
                    font-weight: bold;
                    color: #111827;
                    padding-top: 2px;
                }

                /* Tabla productos */
                .hq-items { margin: 0 0 6px 0; }
                .hq-items th {
                    background-color: #3E4827;
                    color: #ffffff;
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.9px;
                    padding: 8px 12px;
                }
                .hq-items th:first-child { padding-left: 14px; }
                .hq-items th:last-child { padding-right: 14px; }
                .hq-items td {
                    padding: 7px 12px;
                    border-bottom: 1px solid #f0f0f0;
                    font-size: 8.5pt;
                    color: #1f2937;
                    vertical-align: middle;
                }
                .hq-items tbody tr:last-child td {
                    border-bottom: 1px solid #d1d5db;
                }
                .hq-items .c-num {
                    text-align: center;
                    width: 30px;
                    color: #9ca3af;
                    font-size: 8pt;
                }
                .hq-items .c-qty,
                .hq-items .c-price,
                .hq-items .c-sub {
                    text-align: right;
                    white-space: nowrap;
                }
                .hq-items .c-sub { font-weight: 600; color: #111827; }
                .hq-items .row-section td {
                    background-color: #f5f6f2;
                    font-weight: bold;
                    color: #3E4827;
                    font-size: 8.5pt;
                    padding-top: 10px;
                    padding-bottom: 10px;
                }
                .hq-items .row-note td {
                    font-style: italic;
                    color: #6b7280;
                    font-size: 8pt;
                }

                /* Totales */
                .hq-totals {
                    width: 300px;
                    margin: 10px 0 14px auto;
                }
                .hq-totals td {
                    padding: 6px 4px;
                    font-size: 8.5pt;
                    border: none;
                }
                .hq-totals .t-lbl {
                    color: #6b7280;
                    text-align: left;
                    width: 55%;
                }
                .hq-totals .t-val {
                    color: #1f2937;
                    font-weight: 600;
                    text-align: right;
                    width: 45%;
                }
                .hq-totals tr.t-first td {
                    border-top: 1px solid #e5e7eb;
                    padding-top: 10px;
                }
                .hq-totals tr.t-grand td {
                    border-top: 2px solid #374151;
                    padding-top: 12px;
                    padding-bottom: 4px;
                }
                .hq-totals tr.t-grand .t-lbl {
                    font-size: 9.5pt;
                    font-weight: bold;
                    color: #111827;
                    text-transform: uppercase;
                    letter-spacing: 0.6px;
                }
                .hq-totals tr.t-grand .t-val {
                    font-size: 14pt;
                    font-weight: bold;
                    color: #3E4827;
                }

                /* Espaciador dinámico */
                .hq-spacer { width: 100%; font-size: 1px; line-height: 1px; }
                .hq-spacer td { font-size: 1px; line-height: 1px; }

                /* Condiciones */
                .hq-conditions { margin: 0 0 10px 0; padding: 0; }
                .hq-cond-title {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 1px;
                    margin: 0 0 8px 0;
                    padding: 0 0 4px 0;
                    border-bottom: 1px solid #d1d5db;
                    display: inline-block;
                    min-width: 120px;
                }
                .hq-cond-body {
                    font-size: 7.5pt;
                    color: #6b7280;
                    line-height: 1.55;
                    white-space: pre-line;
                }

                /* Firmas */
                .hq-sigs { width: 100%; margin: 0 0 8px 0; }
                .hq-sigs td { vertical-align: top; padding: 0; }
                .hq-sig-head {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #6b7280;
                    letter-spacing: 0.8px;
                    margin-bottom: 6px;
                }
                .hq-sig-head svg { vertical-align: middle; margin-right: 5px; }
                .hq-sig-head span { vertical-align: middle; }
                .hq-sig-line {
                    border-bottom: 1px solid #9ca3af;
                    height: 22px;
                    width: 100%;
                }
                .hq-sig-date-inline { padding-top: 8px; }
                .hq-sig-line-date { max-width: 240px; }

                /* Footer */
                .hq-footer {
                    border-top: 1px solid #e5e7eb;
                    padding-top: 6px;
                    margin-top: 2px;
                    text-align: center;
                    font-size: 7pt;
                    color: #9ca3af;
                    letter-spacing: 0.2px;
                }
                .hq-pagenum {
                    text-align: center;
                    font-size: 6.5pt;
                    color: #c4c4c4;
                    margin-top: 2px;
                    padding-bottom: 0;
                }
            </style>

            <!-- ═══ HEADER ═══ -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-header">
                <tr>
                    <td class="hq-logo-cell">
                        <img t-if="company.logo"
                             class="hq-logo"
                             t-att-src="image_data_uri(company.logo)"
                             alt="Hellenia"/>
                    </td>
                    <td class="hq-co-block">
                        <div class="hq-co-name" t-field="company.name"/>
                        <div class="hq-co-line" t-if="company.partner_id.street">
                            <span t-field="company.partner_id.street"/>
                            <t t-if="company.partner_id.city">, <span t-field="company.partner_id.city"/></t>
                        </div>
                        <div class="hq-co-line" t-if="company.vat">
                            <span class="hq-meta-lbl">RNC</span>
                            <span t-field="company.vat"/>
                        </div>
                        <div class="hq-co-line" t-if="company.phone">
                            <span class="hq-meta-lbl">Tel.</span>
                            <span t-field="company.phone"/>
                        </div>
                        <div class="hq-co-line" t-if="company.email">
                            <span class="hq-meta-lbl">Correo</span>
                            <span t-field="company.email"/>
                        </div>
                        <div class="hq-co-line" t-if="company.website">
                            <span class="hq-meta-lbl">Web</span>
                            <span t-field="company.website"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ═══ BANDA VERDE ═══ -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-band">
                <tr>
                    <td class="hq-band-title">COTIZACIÓN</td>
                    <td align="right">
                        <span class="hq-band-num">No. <span t-field="doc.name"/></span>
                    </td>
                </tr>
            </table>
            <hr class="hq-band-rule"/>

            <!-- ═══ FECHAS ═══ -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-dates">
                <tr>
                    <td width="50%" t-if="doc.date_order">
                        <span class="hq-meta-lbl">Fecha de Cotización: </span>
                        <span class="hq-meta-val">
                            <span t-out="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                        </span>
                    </td>
                    <td width="50%" align="right" t-if="doc.validity_date">
                        <span class="hq-meta-lbl">Vencimiento: </span>
                        <span class="hq-meta-val">
                            <span t-out="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''"/>
                        </span>
                    </td>
                </tr>
            </table>

            <!-- ═══ CLIENTE / VENDEDOR ═══ -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hq-parties">
                <tr>
                    <td class="hq-party-col">
                        <div class="hq-sec-head">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="#9ca3af" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                            <span>Información del Cliente</span>
                        </div>
                        <div class="hq-fld-lbl">Cliente</div>
                        <div class="hq-fld-val" t-field="doc.partner_id.name"/>
                        <t t-if="doc.partner_id.vat">
                            <div class="hq-fld-lbl">RNC</div>
                            <div class="hq-fld-val" t-field="doc.partner_id.vat"/>
                        </t>
                        <t t-if="doc.partner_id.phone">
                            <div class="hq-fld-lbl">Teléfono</div>
                            <div class="hq-fld-val" t-field="doc.partner_id.phone"/>
                        </t>
                        <t t-if="doc.partner_id.email">
                            <div class="hq-fld-lbl">Correo</div>
                            <div class="hq-fld-val" t-field="doc.partner_id.email"/>
                        </t>
                    </td>
                    <td class="hq-party-gap"></td>
                    <td class="hq-party-col hq-party-col-right">
                        <div class="hq-sec-head">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="#9ca3af" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                            <span>Información del Vendedor</span>
                        </div>
                        <t t-if="doc.user_id">
                            <div class="hq-fld-lbl">Vendedor</div>
                            <div class="hq-fld-val" t-field="doc.user_id.name"/>
                        </t>
                        <div class="hq-pay-block">
                            <div class="hq-sec-head" style="margin-bottom: 6px;">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="#9ca3af" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                                </svg>
                                <span>Términos de Pago</span>
                            </div>
                            <div class="hq-pay-val" t-out="doc.get_hellenia_payment_term_display()"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ═══ PRODUCTOS ═══ -->
            <table class="hq-items" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th class="c-num">#</th>
                        <th>Descripción</th>
                        <th class="c-qty">Cant.</th>
                        <th class="c-price">P. Unit.</th>
                        <th class="c-sub">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="product_line_num" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-if="line.display_type == 'line_section'">
                            <tr class="row-section">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr class="row-note">
                                <td colspan="5"><span t-field="line.name"/></td>
                            </tr>
                        </t>
                        <t t-elif="not line.display_type and not line.is_downpayment">
                            <t t-set="product_line_num" t-value="product_line_num + 1"/>
                            <tr>
                                <td class="c-num"><span t-out="product_line_num"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="c-qty">
                                    <span t-field="line.product_uom_qty"/>
                                    <t t-if="line.product_uom_id"> <span t-field="line.product_uom_id"/></t>
                                </td>
                                <td class="c-price">
                                    <span t-field="line.price_unit"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="c-sub">
                                    <span t-field="line.price_subtotal"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- ═══ TOTALES ═══ -->
            <table class="hq-totals" cellpadding="0" cellspacing="0" align="right">
                <tr class="t-first">
                    <td class="t-lbl">Subtotal</td>
                    <td class="t-val">
                        <span t-field="doc.amount_untaxed"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="t-lbl">ITBIS</td>
                    <td class="t-val">
                        <span t-field="doc.amount_tax"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr class="t-grand">
                    <td class="t-lbl">Total</td>
                    <td class="t-val">
                        <span t-field="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </table>

            <div style="clear: both; height: 1px; font-size: 1px; line-height: 1px;">&#160;</div>

            <!-- ═══ ESPACIADOR DINÁMICO (condiciones al fondo) ═══ -->
            <table class="hq-spacer" width="100%" cellpadding="0" cellspacing="0"
                   t-if="bottom_spacer_px &gt; 0">
                <tr>
                    <td t-attf-style="height: {{ bottom_spacer_px }}px;">&#160;</td>
                </tr>
            </table>

            <!-- ═══ CONDICIONES ═══ -->
            <div class="hq-conditions">
                <div class="hq-cond-title">Condiciones</div>
                <t t-if="doc.note">
                    <div class="hq-cond-body" t-field="doc.note"/>
                </t>
                <t t-else="">
                    <div class="hq-cond-body"
                         t-out="company.hellenia_quotation_terms or hellenia_default_quotation_terms"/>
                </t>
            </div>

            <!-- ═══ ESPACIADOR FIRMAS ═══ -->
            <table class="hq-spacer" width="100%" cellpadding="0" cellspacing="0"
                   t-if="signature_spacer_px &gt; 0">
                <tr>
                    <td t-attf-style="height: {{ signature_spacer_px }}px;">&#160;</td>
                </tr>
            </table>

            <!-- ═══ FIRMAS ═══ -->
            <table class="hq-sigs" cellpadding="0" cellspacing="0">
                <tr>
                    <td width="48%">
                        <div class="hq-sig-head">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="#9ca3af" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                            </svg>
                            <span>Entregado por</span>
                        </div>
                        <div class="hq-sig-line">&#160;</div>
                        <div class="hq-sig-date-inline">
                            <div class="hq-sig-head">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="#9ca3af" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5z"/>
                                </svg>
                                <span>Fecha</span>
                            </div>
                            <div class="hq-sig-line hq-sig-line-date">&#160;</div>
                        </div>
                    </td>
                    <td width="4%"></td>
                    <td width="48%">
                        <div class="hq-sig-head">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="#9ca3af" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                            </svg>
                            <span>Recibido por</span>
                        </div>
                        <div class="hq-sig-line">&#160;</div>
                    </td>
                </tr>
            </table>

            <!-- ═══ FOOTER ═══ -->
            <div class="hq-footer">
                <t t-if="company.phone"><span t-field="company.phone"/></t>
                <t t-if="company.email"> | <span t-field="company.email"/></t>
                <t t-if="company.website"> | <span t-field="company.website"/></t>
            </div>
            <div class="hq-pagenum">
                Página <span class="page"/> de <span class="topage"/>
            </div>
        </div>
    </template>

    <template id="report_saleorder_raw_hellenia_quotation" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace">
            <t t-if="doc.state in ['draft', 'sent']"
               t-call="hellenia_reports.hellenia_quotation_document"
               t-lang="doc.partner_id.lang"/>
            <t t-else=""
               t-call="sale.report_saleorder_document"
               t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

