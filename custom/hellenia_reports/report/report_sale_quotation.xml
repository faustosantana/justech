<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cotización Hellenia — premium corporativo, solo tablas/CSS wkhtmltopdf-safe -->
    <template id="hellenia_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="sp" t-value="doc.user_id.partner_id if doc.user_id else False"/>
        <t t-set="product_count" t-value="len(lines_to_report.filtered(lambda l: not l.display_type and not l.is_downpayment))"/>
        <t t-set="shell_min_height" t-value="'0'"/>
        <t t-if="product_count &lt;= 8">
            <t t-set="shell_min_height" t-value="'210mm'"/>
        </t>
        <t t-set="hellenia_default_quotation_terms">(a) Las piezas ofrecidas son únicas y sujetas a disponibilidad.
(b) Esta cotización tiene una validez de 5 días.
(c) Se requiere confirmación del pago del 100% para reservar la pieza.
(d) Transporte disponible bajo cotización.
(e) Asesoría de colocación, instalación y styling disponible bajo cotización.
(f) Las piezas pueden presentar marcas propias del tiempo, lo cual forma parte de su carácter y autenticidad.</t>

        <div class="page article o_report_layout_standard hellenia-quote-page"
             t-att-data-oe-model="doc._name"
             t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <style type="text/css">
                /* Ocultar layout Odoo duplicado — solo en PDF cotización */
                .header, .footer, h2.hellenia-doc-title, .o_report_layout_standard .address {
                    display: none !important;
                    height: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    overflow: hidden !important;
                }
                .hellenia-article, .o_report_layout_standard {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                .hellenia-quote-shell {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: -15mm;
                }
                .hellenia-quote-shell td {
                    border: none;
                    padding: 0;
                    vertical-align: top;
                }
                .hellenia-quote-shell .hellenia-quote-bottom-cell {
                    vertical-align: bottom;
                    padding-top: 4px;
                }
                .hellenia-quote-page {
                    font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
                    font-size: 9pt;
                    color: #2d2d2d;
                    line-height: 1.38;
                    margin: 0;
                    padding: 0;
                }
                .hellenia-quote-page table { border-collapse: collapse; border: none; }
                .hellenia-quote-hdr-table td { border: none; vertical-align: top; padding: 0; }
                .hellenia-quote-hdr-logo-cell { padding-right: 14px; width: 38%; }
                .hellenia-quote-logo {
                    max-height: 68px;
                    max-width: 200px;
                    width: auto;
                    height: auto;
                    display: block;
                }
                .hellenia-quote-hdr-right {
                    font-size: 7.5pt;
                    color: #6a6a6a;
                    text-align: right;
                    line-height: 1.32;
                    padding-left: 10px;
                }
                .hellenia-quote-company-name {
                    font-size: 10.5pt;
                    font-weight: bold;
                    color: #3E4827;
                    margin-bottom: 2px;
                    letter-spacing: 0.02em;
                }
                .hellenia-quote-band {
                    background-color: #3E4827;
                    color: #ffffff;
                    margin: 4px 0 10px 0;
                }
                .hellenia-quote-band td { padding: 5px 12px; border: none; }
                .hellenia-quote-band-title {
                    font-size: 10.5pt;
                    font-weight: bold;
                    letter-spacing: 2px;
                }
                .hellenia-quote-num-box {
                    background-color: #ffffff;
                    color: #3E4827;
                    font-weight: bold;
                    font-size: 9.5pt;
                    padding: 3px 11px;
                }
                .hellenia-quote-meta-row {
                    margin-bottom: 14px;
                }
                .hellenia-quote-meta-row td {
                    border: none;
                    vertical-align: top;
                    padding: 0 16px 0 0;
                }
                .hellenia-quote-block-title {
                    font-size: 6.5pt;
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    color: #9a9a9a;
                    font-weight: bold;
                    margin-bottom: 6px;
                }
                .hellenia-quote-field-label {
                    font-size: 6.5pt;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    color: #9a9a9a;
                    font-weight: normal;
                    padding-top: 5px;
                }
                .hellenia-quote-field-value {
                    font-size: 8.5pt;
                    color: #2d2d2d;
                    font-weight: normal;
                    padding-bottom: 1px;
                }
                .hellenia-quote-field-value-strong {
                    font-size: 9pt;
                    font-weight: bold;
                    color: #2d2d2d;
                }
                .hellenia-quote-dates {
                    margin-bottom: 12px;
                    padding-bottom: 8px;
                    border-bottom: 1px solid #ececec;
                }
                .hellenia-quote-dates td { border: none; padding: 0; }
                .hellenia-quote-label {
                    font-size: 6.5pt;
                    text-transform: uppercase;
                    color: #9a9a9a;
                    letter-spacing: 0.5px;
                }
                .hellenia-quote-value {
                    font-size: 8.5pt;
                    color: #2d2d2d;
                    font-weight: bold;
                }
                .hellenia-quote-items {
                    width: 100%;
                    margin: 6px 0 10px 0;
                }
                .hellenia-quote-items th {
                    background-color: #3E4827;
                    color: #ffffff;
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.6px;
                    padding: 6px 8px;
                    border: none;
                }
                .hellenia-quote-items td {
                    padding: 5px 8px;
                    border: none;
                    border-bottom: 1px solid #ededed;
                    font-size: 8.5pt;
                    vertical-align: top;
                }
                .hellenia-quote-items tbody tr:last-child td { border-bottom: 1px solid #d8d8d8; }
                .hellenia-quote-items .num { text-align: center; width: 24px; color: #8a8a8a; }
                .hellenia-quote-items .qty,
                .hellenia-quote-items .price,
                .hellenia-quote-items .sub { text-align: right; white-space: nowrap; }
                .hellenia-quote-totals {
                    width: 240px;
                    margin: 4px 0 6px auto;
                }
                .hellenia-quote-totals td {
                    padding: 4px 4px 4px 12px;
                    font-size: 8.5pt;
                    border: none;
                }
                .hellenia-quote-totals .lbl { color: #7a7a7a; }
                .hellenia-quote-totals .val { text-align: right; font-weight: bold; color: #2d2d2d; }
                .hellenia-quote-totals .grand td {
                    background-color: #f4f6f1;
                    padding: 8px 4px 8px 12px;
                    font-size: 11pt;
                    font-weight: bold;
                    color: #3E4827;
                    border-top: 2px solid #3E4827;
                }
                .hellenia-quote-totals .grand .lbl { color: #3E4827; font-weight: bold; }
                .hellenia-quote-conditions {
                    border: none;
                    border-top: 1px solid #e8e8e8;
                    padding: 10px 0 8px 0;
                    margin: 0;
                }
                .hellenia-quote-conditions-title {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    color: #3E4827;
                    letter-spacing: 0.8px;
                    margin-bottom: 6px;
                }
                .hellenia-quote-conditions-body {
                    font-size: 7.5pt;
                    color: #6a6a6a;
                    line-height: 1.45;
                    white-space: pre-line;
                }
                .hellenia-quote-signatures {
                    width: 100%;
                    margin: 14px 0 10px 0;
                    padding-top: 6px;
                    border-top: 1px solid #ececec;
                }
                .hellenia-quote-signatures td {
                    border: none;
                    padding: 0;
                    vertical-align: top;
                }
                .hellenia-quote-sig-block { padding-right: 20px; }
                .hellenia-quote-sig-label {
                    font-size: 6.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    color: #3E4827;
                    margin-bottom: 8px;
                }
                .hellenia-quote-sig-line {
                    border-bottom: 1px solid #4a4a4a;
                    height: 28px;
                    width: 100%;
                }
                .hellenia-quote-sig-date { max-width: 260px; margin-top: 12px; }
                .hellenia-quote-footer {
                    border-top: 1px solid #e0e0e0;
                    padding: 4px 0 0 0;
                    margin: 0;
                    font-size: 7pt;
                    color: #8a8a8a;
                    text-align: center;
                    letter-spacing: 0.3px;
                }
            </style>

            <table class="hellenia-quote-shell" cellpadding="0" cellspacing="0"
                   t-attf-style="min-height: {{ shell_min_height }};">
                <tr>
                    <td>

            <!-- Encabezado -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hellenia-quote-hdr-table">
                <tr>
                    <td class="hellenia-quote-hdr-logo-cell">
                        <img t-if="company.logo"
                             class="hellenia-quote-logo"
                             style="max-height: 68px; max-width: 200px; height: auto; width: auto;"
                             t-att-src="image_data_uri(company.logo)"
                             alt="Hellenia"/>
                    </td>
                    <td class="hellenia-quote-hdr-right">
                        <div class="hellenia-quote-company-name" t-field="company.name"/>
                        <div t-if="company.partner_id.street">
                            <span t-field="company.partner_id.street"/>
                            <t t-if="company.partner_id.city">, <span t-field="company.partner_id.city"/></t>
                        </div>
                        <div t-if="company.vat"><span t-field="company.vat"/></div>
                        <div t-if="company.phone"><span t-field="company.phone"/></div>
                        <div t-if="company.email"><span t-field="company.email"/></div>
                        <div t-if="company.website"><span t-field="company.website"/></div>
                    </td>
                </tr>
            </table>

            <!-- Banda -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hellenia-quote-band">
                <tr>
                    <td class="hellenia-quote-band-title">COTIZACIÓN</td>
                    <td align="right">
                        <span class="hellenia-quote-num-box">No. <span t-field="doc.name"/></span>
                    </td>
                </tr>
            </table>

            <!-- Fechas -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hellenia-quote-dates">
                <tr>
                    <td width="50%" t-if="doc.date_order">
                        <span class="hellenia-quote-label">Fecha de cotización </span>
                        <span class="hellenia-quote-value">
                            <span t-out="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                        </span>
                    </td>
                    <td width="50%" align="right" t-if="doc.validity_date">
                        <span class="hellenia-quote-label">Vencimiento </span>
                        <span class="hellenia-quote-value">
                            <span t-out="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''"/>
                        </span>
                    </td>
                </tr>
            </table>

            <!-- Cliente / Vendedor / Pago — bloques sin bordes -->
            <table width="100%" cellpadding="0" cellspacing="0" class="hellenia-quote-meta-row">
                <tr>
                    <td width="50%">
                        <div class="hellenia-quote-block-title">Información del cliente</div>
                        <div class="hellenia-quote-field-value-strong" t-field="doc.partner_id.name"/>
                        <t t-if="doc.partner_id.street or doc.partner_id.city">
                            <div class="hellenia-quote-field-label">Dirección</div>
                            <div class="hellenia-quote-field-value">
                                <span t-if="doc.partner_id.street" t-field="doc.partner_id.street"/>
                                <t t-if="doc.partner_id.street and doc.partner_id.city">, </t>
                                <span t-if="doc.partner_id.city" t-field="doc.partner_id.city"/>
                            </div>
                        </t>
                        <t t-if="doc.partner_id.vat">
                            <div class="hellenia-quote-field-label">RNC</div>
                            <div class="hellenia-quote-field-value" t-field="doc.partner_id.vat"/>
                        </t>
                        <t t-if="doc.partner_id.phone">
                            <div class="hellenia-quote-field-label">Teléfono</div>
                            <div class="hellenia-quote-field-value" t-field="doc.partner_id.phone"/>
                        </t>
                        <t t-if="doc.partner_id.email">
                            <div class="hellenia-quote-field-label">Correo</div>
                            <div class="hellenia-quote-field-value" t-field="doc.partner_id.email"/>
                        </t>
                    </td>
                    <td width="50%">
                        <div class="hellenia-quote-block-title">Información del vendedor</div>
                        <t t-if="doc.user_id">
                            <div class="hellenia-quote-field-value-strong" t-field="doc.user_id.name"/>
                        </t>
                        <t t-if="sp and sp.phone">
                            <div class="hellenia-quote-field-label">Teléfono</div>
                            <div class="hellenia-quote-field-value" t-field="sp.phone"/>
                        </t>
                        <t t-if="doc.user_id and doc.user_id.email">
                            <div class="hellenia-quote-field-label">Correo</div>
                            <div class="hellenia-quote-field-value" t-field="doc.user_id.email"/>
                        </t>
                        <div class="hellenia-quote-block-title" style="margin-top: 10px;">Términos de pago</div>
                        <div class="hellenia-quote-field-value-strong" t-out="doc.get_hellenia_payment_term_display()"/>
                    </td>
                </tr>
            </table>

            <!-- Productos -->
            <table class="hellenia-quote-items" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th class="num">#</th>
                        <th>Descripción</th>
                        <th class="qty">Cant.</th>
                        <th class="price">P. unit.</th>
                        <th class="sub">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="product_line_num" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-if="line.display_type == 'line_section'">
                            <tr>
                                <td colspan="5" style="font-weight: bold; color: #3E4827; font-size: 8pt; padding-top: 8px;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td colspan="5" style="font-style: italic; color: #8a8a8a; font-size: 7.5pt;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="not line.display_type and not line.is_downpayment">
                            <t t-set="product_line_num" t-value="product_line_num + 1"/>
                            <tr>
                                <td class="num"><span t-out="product_line_num"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="qty">
                                    <span t-field="line.product_uom_qty"/>
                                    <t t-if="line.product_uom_id"> <span t-field="line.product_uom_id"/></t>
                                </td>
                                <td class="price">
                                    <span t-field="line.price_unit"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="sub">
                                    <span t-field="line.price_subtotal"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- Totales -->
            <table class="hellenia-quote-totals" cellpadding="0" cellspacing="0" align="right">
                <tr>
                    <td class="lbl">Subtotal</td>
                    <td class="val">
                        <span t-field="doc.amount_untaxed"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="lbl">ITBIS</td>
                    <td class="val">
                        <span t-field="doc.amount_tax"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr class="grand">
                    <td class="lbl">Total</td>
                    <td class="val">
                        <span t-field="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </table>

            <div style="clear: both; height: 1px; line-height: 1px; font-size: 1px;">&#160;</div>

                    </td>
                </tr>
                <tr>
                    <td class="hellenia-quote-bottom-cell">

            <!-- Condiciones -->
            <div class="hellenia-quote-conditions">
                <div class="hellenia-quote-conditions-title">Condiciones</div>
                <t t-if="doc.note">
                    <div class="hellenia-quote-conditions-body" t-field="doc.note"/>
                </t>
                <t t-else="">
                    <div class="hellenia-quote-conditions-body"
                         t-out="company.hellenia_quotation_terms or hellenia_default_quotation_terms"/>
                </t>
            </div>

            <!-- Firmas corporativas -->
            <table class="hellenia-quote-signatures" cellpadding="0" cellspacing="0">
                <tr>
                    <td width="48%" class="hellenia-quote-sig-block">
                        <div class="hellenia-quote-sig-label">Entregado por</div>
                        <div class="hellenia-quote-sig-line">&#160;</div>
                    </td>
                    <td width="4%"></td>
                    <td width="48%">
                        <div class="hellenia-quote-sig-label">Recibido por</div>
                        <div class="hellenia-quote-sig-line">&#160;</div>
                    </td>
                </tr>
                <tr>
                    <td colspan="3">
                        <div class="hellenia-quote-sig-label hellenia-quote-sig-date">Fecha</div>
                        <div class="hellenia-quote-sig-line hellenia-quote-sig-date">&#160;</div>
                    </td>
                </tr>
            </table>

            <!-- Pie -->
            <div class="hellenia-quote-footer">
                <t t-if="company.phone"><span t-field="company.phone"/></t>
                <t t-if="company.email"> | <span t-field="company.email"/></t>
                <t t-if="company.website"> | <span t-field="company.website"/></t>
            </div>

                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_saleorder_raw_hellenia_quotation" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace">
            <t t-if="doc.state in ['draft', 'sent']"
               t-call="hellenia_reports.hellenia_quotation_document"
               t-lang="doc.partner_id.lang"/>
            <t t-else=""
               t-call="sale.report_saleorder_document"
               t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

</odoo>
