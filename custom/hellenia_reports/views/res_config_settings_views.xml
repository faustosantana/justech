<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hellenia_quotation_terms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hellenia.quotation.terms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="hellenia_quotation_terms_setting"
                         string="Términos y Condiciones"
                         company_dependent="1"
                         help="Texto precargado automáticamente en cada cotización nueva. Las cotizaciones ya creadas conservan su propia versión.">
                    <div class="content-group mt16">
                        <field name="hellenia_quotation_terms"
                                 widget="html"
                               class="o_light_label"
                               nolabel="1"
                               placeholder="Escriba aquí los términos que aparecerán en las cotizaciones…"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
