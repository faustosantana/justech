<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HELLENIA-PURCHASE-UX-1 — Hub Compras (acciones estándar, sin lógica nueva) -->

    <menuitem id="menu_purchase_vendors_root"
              name="Proveedores"
              parent="purchase.menu_purchase_root"
              sequence="30"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_vendors_list"
              name="Proveedores"
              parent="menu_purchase_vendors_root"
              action="account.res_partner_action_supplier"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_vendor_bills"
              name="Facturas de proveedor"
              parent="menu_purchase_vendors_root"
              action="account.action_move_in_invoice"
              sequence="20"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_vendor_refunds"
              name="Notas de crédito"
              parent="menu_purchase_vendors_root"
              action="account.action_move_in_refund_type"
              sequence="30"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_vendor_withholding"
              name="Retenciones"
              parent="menu_purchase_vendors_root"
              action="justech_l10n_do_payments_withholding.action_justech_withholding_catalog"
              sequence="40"
              groups="account.group_account_invoice"/>

    <menuitem id="menu_purchase_payments_root"
              name="Pagos"
              parent="purchase.menu_purchase_root"
              sequence="40"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_payments_vendor"
              name="Pagos de proveedores"
              parent="menu_purchase_payments_root"
              action="account.action_account_payments_payable"
              sequence="10"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_open_payments_vendor"
              name="Pagos abiertos"
              parent="menu_purchase_payments_root"
              action="justech_l10n_do_treasury.action_treasury_open_payments_vendor"
              sequence="20"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_bank_reconciliation"
              name="Conciliación bancaria"
              parent="menu_purchase_payments_root"
              action="hellenia_ui.action_hellenia_bank_reconciliation"
              sequence="30"
              groups="account.group_account_user"/>

    <menuitem id="menu_purchase_payments_withholding"
              name="Retenciones"
              parent="menu_purchase_payments_root"
              action="justech_l10n_do_payments_withholding.action_justech_withholding_catalog"
              sequence="40"
              groups="account.group_account_invoice"/>

    <record id="action_purchase_orders_late_receipt" model="ir.actions.act_window">
        <field name="name">Órdenes con recepción atrasada</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="domain">[('state', 'in', ['purchase', 'done'])]</field>
        <field name="context">{'search_default_late_receipt': 1}</field>
        <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
    </record>

    <menuitem id="menu_purchase_orders_late_receipt"
              name="Recepciones atrasadas"
              parent="purchase.menu_procurement_management"
              action="action_purchase_orders_late_receipt"
              sequence="8"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_receipts"
              name="Recepciones"
              parent="purchase.menu_procurement_management"
              action="stock.action_picking_tree_incoming"
              sequence="9"
              groups="purchase.group_purchase_user"/>

    <menuitem id="menu_purchase_report_aged_payable"
              name="Antigüedad de saldos (proveedores)"
              parent="purchase.purchase_report_main"
              action="account_reports.action_account_report_ap"
              sequence="20"
              groups="purchase.group_purchase_manager"/>

    <menuitem id="menu_purchase_report_dgii_606"
              name="606 — Compras (DGII)"
              parent="purchase.purchase_report_main"
              action="justech_l10n_do_reports.action_justech_do_report_606"
              sequence="30"
              groups="purchase.group_purchase_manager"/>

    <menuitem id="menu_purchase_config_payment_terms"
              name="Términos de pago"
              parent="purchase.menu_purchase_config"
              action="account.action_payment_term_form"
              sequence="5"
              groups="purchase.group_purchase_manager"/>

    <menuitem id="menu_purchase_config_incoterms"
              name="Incoterms"
              parent="purchase.menu_purchase_config"
              action="account.action_incoterms_tree"
              sequence="6"
              groups="purchase.group_purchase_manager"/>

</odoo>
