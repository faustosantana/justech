<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_hellenia_labels" model="ir.ui.view">
        <field name="name">account.move.form.hellenia.labels</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="string">Fecha de factura</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="string">Fecha de vencimiento</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="string">Diario</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="string">Referencia</attribute>
            </xpath>
        </field>
    </record>
</odoo>
