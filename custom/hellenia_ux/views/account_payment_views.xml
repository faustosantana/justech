<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_hellenia_ux" model="ir.ui.view">
        <field name="name">account.payment.form.hellenia.ux</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="string">Diario</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="string">Método de pago</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="string">Cuenta bancaria de la empresa</attribute>
            </xpath>
            <xpath expr="//sheet/group" position="inside">
                <field name="hellenia_is_card" invisible="1"/>
                <field name="hellenia_is_check" invisible="1"/>
                <field name="hellenia_payment_reference" string="Referencia"
                       invisible="not hellenia_is_card and not hellenia_is_check"/>
                <field name="hellenia_card_auth" string="Autorización" invisible="not hellenia_is_card"/>
                <field name="hellenia_card_batch" string="Lote" invisible="not hellenia_is_card"/>
                <field name="hellenia_check_bank_id" string="Banco" invisible="not hellenia_is_check"/>
                <field name="hellenia_check_number" string="Número de cheque" invisible="not hellenia_is_check"/>
                <field name="hellenia_check_date" string="Fecha del cheque" invisible="not hellenia_is_check"/>
            </xpath>
        </field>
    </record>
</odoo>
