<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_ncf_void_wizard_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.void.wizard.form</field>
        <field name="model">justech.do.ncf.void.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular comprobante fiscal">
                <group>
                    <field name="move_id"/>
                    <field name="ncf"/>
                    <field name="void_reason" placeholder="Indique el motivo de anulación fiscal..."/>
                </group>
                <footer>
                    <button name="action_confirm_void" string="Confirmar anulación" type="object" class="btn-danger"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
