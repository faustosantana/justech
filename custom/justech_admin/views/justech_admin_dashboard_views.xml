<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_justech_admin_dashboard_open" model="ir.actions.server">
        <field name="name">Abrir Centro de Control</field>
        <field name="model_id" ref="justech_modules.model_justech_admin_access_service"/>
        <field name="state">code</field>
        <field name="code">action = env["justech.admin.access.service"].action_open_admin_dashboard()</field>
    </record>
    <record id="action_justech_admin_dashboard" model="ir.actions.act_window">
        <field name="name">Centro de Control</field>
        <field name="res_model">justech.admin.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
