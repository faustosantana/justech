<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_client_module_control_form" model="ir.ui.view">
        <field name="name">justech.client.module.control.form</field>
        <field name="model">justech.client.module.control</field>
        <field name="arch" type="xml">
            <form string="Módulos del Cliente" create="false" edit="false" delete="false" class="justech-cc-admin-form justech-cc-real-only">
                <header>
                    <button name="action_create_admin_key" type="object"
                            string="Crear Clave Administrativa"
                            class="btn-primary"
                            invisible="has_admin_key"/>
                    <button name="action_refresh" type="object" string="Actualizar"/>
                </header>
                <sheet>
                    <field name="has_admin_key" invisible="1"/>
                    <field name="show_key_banner" invisible="1"/>
                    <field name="show_client_selector" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="client_name" invisible="1"/>
                    <field name="key_banner_html" nolabel="1" invisible="not show_key_banner"/>
                    <field name="header_html" nolabel="1"/>
                    <group col="4" class="justech-cc-filters-row">
                        <field name="license_id" string="Cliente"
                               invisible="not show_client_selector"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="search_text" placeholder="Buscar categoría..."/>
                        <field name="filter_mode" string="Estado"/>
                        <button name="action_apply_filters" type="object" string="Aplicar" class="btn-secondary"/>
                    </group>
                    <field name="line_ids" nolabel="1" mode="kanban">
                        <kanban create="false" edit="false" delete="false"
                                class="justech-cc-modules-kanban">
                            <field name="name"/>
                            <field name="status_label"/>
                            <field name="paid_label"/>
                            <field name="active_label"/>
                            <field name="companies_enabled_text"/>
                            <field name="license_label"/>
                            <field name="includes_summary"/>
                            <field name="status"/>
                            <field name="main_module_code"/>
                            <field name="product_code"/>
                            <templates>
                                <t t-name="card">
                                    <div class="justech-cc-module-card">
                                        <div class="justech-cc-module-card-head">
                                            <strong class="justech-cc-module-card-title">
                                                <field name="name"/>
                                            </strong>
                                            <span t-attf-class="justech-cc-status justech-cc-status-#{record.status.raw_value}">
                                                <field name="status_label"/>
                                            </span>
                                        </div>
                                        <div class="justech-cc-module-card-meta">
                                            <span>Pagado: <field name="paid_label"/></span>
                                            <span>Activo: <field name="active_label"/></span>
                                        </div>
                                        <div class="justech-cc-module-card-meta">
                                            <span>Empresas: <field name="companies_enabled_text"/></span>
                                            <span>Licencia: <field name="license_label"/></span>
                                        </div>
                                        <div class="justech-cc-module-card-includes">
                                            Incluye: <field name="includes_summary"/>
                                        </div>
                                        <div class="justech-cc-module-card-actions">
                                            <button name="action_open_administrar" type="object"
                                                    string="Administrar" class="btn btn-sm btn-primary"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_manage_menu_form" model="ir.ui.view">
        <field name="name">justech.client.module.manage.menu.form</field>
        <field name="model">justech.client.module.manage.menu</field>
        <field name="arch" type="xml">
            <form string="Administrar">
                <sheet>
                    <div class="oe_title justech-cc-manage-title">
                        <h2><field name="module_name" readonly="1"/></h2>
                        <div class="justech-cc-manage-meta">
                            <span>Estado: <field name="status_label" readonly="1"/></span>
                            <span>Pagado: <field name="paid_label" readonly="1"/></span>
                            <span>Activo: <field name="active_label" readonly="1"/></span>
                        </div>
                    </div>
                    <field name="line_id" invisible="1"/>
                    <field name="is_paid" invisible="1"/>
                    <field name="is_active" invisible="1"/>
                    <field name="is_blocked" invisible="1"/>
                    <field name="license_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group string="Qué incluye">
                        <field name="includes_html" nolabel="1"/>
                    </group>
                    <group string="Licencia">
                        <field name="license_html" nolabel="1"/>
                    </group>
                    <group string="Empresas habilitadas">
                        <field name="companies_html" nolabel="1"/>
                    </group>
                    <group string="Auditoría reciente">
                        <field name="audit_html" nolabel="1"/>
                    </group>
                    <group string="Acciones" col="2">
                        <button name="action_activate" type="object" string="Activar"
                                invisible="is_active or not is_paid"/>
                        <button name="action_deactivate" type="object" string="Desactivar"
                                invisible="not is_active"/>
                        <button name="action_mark_paid" type="object" string="Marcar como pagado"
                                invisible="is_paid"/>
                        <button name="action_mark_unpaid" type="object" string="Marcar como no pagado"
                                invisible="not is_paid"/>
                        <button name="action_add_company" type="object" string="Agregar empresa"/>
                        <button name="action_remove_company" type="object" string="Quitar empresa"/>
                        <button name="action_change_license" type="object" string="Cambiar licencia"/>
                        <button name="action_block" type="object" string="Bloquear" invisible="is_blocked"/>
                        <button name="action_unblock" type="object" string="Desbloquear" invisible="not is_blocked"/>
                        <button name="action_view_audit" type="object" string="Ver auditoría completa"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_action_wizard_form" model="ir.ui.view">
        <field name="name">justech.client.module.action.wizard.form</field>
        <field name="model">justech.client.module.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Clave Administrativa Justech">
                <sheet>
                    <p>Ingrese la Clave Administrativa Justech para confirmar esta acción crítica.</p>
                    <field name="license_info_html" nolabel="1"
                           invisible="action_type not in ('add_company', 'remove_company', 'change_license')"/>
                    <group>
                        <field name="control_id" invisible="1"/>
                        <field name="line_id" invisible="1"/>
                        <field name="license_id" invisible="1"/>
                        <field name="product_code" invisible="1"/>
                        <field name="action_type" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="target_company_id" string="Empresa"
                                invisible="action_type not in ('add_company', 'remove_company')"
                                options="{'no_create': True}"/>
                        <field name="new_tier" invisible="action_type != 'change_license'"/>
                        <field name="admin_key" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancelar" special="cancel"/>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_audit_list" model="ir.ui.view">
        <field name="name">justech.client.module.audit.list</field>
        <field name="model">justech.client.module.audit</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="Fecha"/>
                <field name="user_id" string="Usuario"/>
                <field name="client_name" string="Cliente"/>
                <field name="company_id" string="Empresa"/>
                <field name="commercial_name" string="Categoría"/>
                <field name="action" string="Acción"/>
                <field name="state_before" string="Estado anterior"/>
                <field name="state_after" string="Estado nuevo"/>
                <field name="result" string="Resultado"/>
                <field name="reason" string="Motivo"/>
                <field name="ip_address" string="IP"/>
            </list>
        </field>
    </record>

    <record id="action_justech_client_module_control_open" model="ir.actions.server">
        <field name="name">Abrir Módulos del Cliente</field>
        <field name="model_id" ref="justech_modules.model_justech_admin_access_service"/>
        <field name="state">code</field>
        <field name="code">action = env["justech.client.module.control"].action_open()</field>
    </record>
</odoo>
