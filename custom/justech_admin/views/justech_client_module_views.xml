<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_client_module_control_form" model="ir.ui.view">
        <field name="name">justech.client.module.control.form</field>
        <field name="model">justech.client.module.control</field>
        <field name="arch" type="xml">
            <form string="Módulos del Cliente" create="false" edit="false" delete="false" class="justech-cc-admin-form justech-cc-real-only">
                <header>
                    <button name="action_create_admin_key" type="object"
                            string="Crear Clave Administrativa"
                            class="btn-primary"
                            invisible="has_admin_key"/>
                    <button name="action_refresh" type="object" string="Actualizar"/>
                </header>
                <sheet>
                    <field name="has_admin_key" invisible="1"/>
                    <field name="show_key_banner" invisible="1"/>
                    <field name="show_client_selector" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="client_name" invisible="1"/>
                    <field name="key_banner_html" nolabel="1" invisible="not show_key_banner"/>
                    <field name="header_html" nolabel="1"/>
                    <group col="4" class="justech-cc-filters-row">
                        <field name="license_id" string="Cliente"
                               invisible="not show_client_selector"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="search_text" placeholder="Buscar personalización..."/>
                        <field name="filter_mode" string="Estado"/>
                        <button name="action_apply_filters" type="object" string="Aplicar" class="btn-secondary"/>
                    </group>
                    <field name="line_ids" nolabel="1" mode="kanban">
                        <kanban create="false" edit="false" delete="false"
                                class="justech-cc-modules-kanban">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="status_label"/>
                            <field name="paid_label"/>
                            <field name="active_label"/>
                            <field name="companies_enabled_text"/>
                            <field name="last_modified_display"/>
                            <field name="includes_summary"/>
                            <field name="status"/>
                            <templates>
                                <t t-name="card">
                                    <div class="justech-cc-module-card">
                                        <strong class="justech-cc-module-card-title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="justech-cc-module-card-desc">
                                            <field name="description"/>
                                        </div>
                                        <div class="justech-cc-module-card-meta">
                                            <span>Estado: <field name="status_label"/></span>
                                            <span>Pagado: <field name="paid_label"/></span>
                                            <span>Activo: <field name="active_label"/></span>
                                        </div>
                                        <div class="justech-cc-module-card-meta">
                                            <span>Empresas: <field name="companies_enabled_text"/></span>
                                            <span>Modificado: <field name="last_modified_display"/></span>
                                        </div>
                                        <div class="justech-cc-module-card-includes">
                                            Incluye: <field name="includes_summary"/>
                                        </div>
                                        <div class="justech-cc-module-card-actions">
                                            <button name="action_open_administrar" type="object"
                                                    string="Administrar" class="btn btn-sm btn-primary"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_admin_panel_form" model="ir.ui.view">
        <field name="name">justech.client.module.admin.panel.form</field>
        <field name="model">justech.client.module.admin.panel</field>
        <field name="arch" type="xml">
            <form string="Administrar personalización" create="false" delete="false"
                  class="justech-cc-admin-dashboard o_form_nosheet">
                <field name="line_id" invisible="1"/>
                <field name="control_id" invisible="1"/>
                <field name="customization_code" invisible="1"/>
                <field name="product_code" invisible="1"/>
                <field name="is_paid" invisible="1"/>
                <field name="is_active" invisible="1"/>
                <field name="is_blocked" invisible="1"/>
                <field name="allow_license_actions" invisible="1"/>
                <field name="license_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="has_pending_changes" invisible="1"/>
                <field name="active_features_count" invisible="1"/>
                <field name="total_features_count" invisible="1"/>
                <field name="features_summary" invisible="1"/>
                <field name="status_label" invisible="1"/>
                <field name="paid_label" invisible="1"/>
                <field name="active_label" invisible="1"/>
                <field name="license_label" invisible="1"/>
                <field name="companies_enabled_text" invisible="1"/>
                <field name="last_modified_display" invisible="1"/>
                <field name="last_modified_by_name" invisible="1"/>
                <div class="justech-dash-shell">
                    <div class="justech-dash-hero">
                        <p class="justech-dash-eyebrow">Administrar personalización</p>
                        <h1 class="justech-dash-title"><field name="module_name" readonly="1" nolabel="1"/></h1>
                        <p class="justech-dash-subtitle"><field name="description" readonly="1" nolabel="1"/></p>
                    </div>
                    <field name="dashboard_header_html" nolabel="1"/>
                    <div class="justech-dash-section">
                        <h3 class="justech-dash-section-title">Funciones incluidas</h3>
                        <field name="feature_line_ids" nolabel="1" mode="kanban">
                            <kanban create="false" delete="false" default_group_by="section_label"
                                    class="justech-dash-feature-kanban o_kanban_mobile">
                                <field name="section_label"/>
                                <field name="section_sequence"/>
                                <field name="sequence"/>
                                <field name="label"/>
                                <field name="description"/>
                                <field name="is_active"/>
                                <field name="initial_active"/>
                                <field name="feature_key"/>
                                <field name="control_type"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="justech-dash-feature-card">
                                            <div class="justech-dash-feature-card-head">
                                                <strong class="justech-dash-feature-name">
                                                    <field name="label"/>
                                                </strong>
                                                <field name="is_active" widget="boolean_toggle"/>
                                            </div>
                                            <p class="justech-dash-feature-desc">
                                                <field name="description"/>
                                            </p>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>
                    <div class="justech-dash-section">
                        <h3 class="justech-dash-section-title">Empresas habilitadas</h3>
                        <field name="companies_dashboard_html" nolabel="1"/>
                        <field name="company_line_ids" invisible="1"/>
                    </div>
                    <div class="justech-dash-section">
                        <h3 class="justech-dash-section-title">Últimos movimientos</h3>
                        <field name="audit_html" nolabel="1"/>
                    </div>
                </div>
                <footer class="justech-dash-footer">
                    <div class="justech-dash-actions-primary">
                        <button name="action_save_changes" type="object" string="Guardar cambios"
                                class="btn btn-primary" invisible="not has_pending_changes"/>
                        <button name="action_activate" type="object" string="Activar personalización"
                                class="btn btn-secondary"
                                invisible="not allow_license_actions or is_active or not is_paid"/>
                        <button name="action_mark_paid" type="object" string="Marcar como pagado"
                                class="btn btn-secondary"
                                invisible="not allow_license_actions or is_paid"/>
                        <button name="action_add_company" type="object" string="Agregar empresa"
                                class="btn btn-secondary"
                                invisible="not allow_license_actions"/>
                        <button name="action_view_audit" type="object" string="Ver auditoría"
                                class="btn btn-link"/>
                    </div>
                    <div class="justech-dash-actions-danger">
                        <button name="action_deactivate" type="object" string="Desactivar personalización"
                                class="btn btn-outline-danger"
                                invisible="not allow_license_actions or not is_active"/>
                        <button name="action_mark_unpaid" type="object" string="Marcar como no pagado"
                                class="btn btn-outline-danger"
                                invisible="not allow_license_actions or not is_paid"/>
                        <button name="action_remove_company" type="object" string="Quitar empresa"
                                class="btn btn-outline-danger"
                                invisible="not allow_license_actions"/>
                    </div>
                    <button string="Cerrar" special="cancel" class="btn btn-light justech-dash-close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_manage_menu_form" model="ir.ui.view">
        <field name="name">justech.client.module.manage.menu.form</field>
        <field name="model">justech.client.module.manage.menu</field>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <form string="Administrar personalización (legacy)" create="false" delete="false">
                <sheet>
                    <p class="text-muted">Use el panel comercial desde Módulos del Cliente.</p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_action_wizard_form" model="ir.ui.view">
        <field name="name">justech.client.module.action.wizard.form</field>
        <field name="model">justech.client.module.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Clave Administrativa Justech">
                <sheet>
                    <p>Ingrese la Clave Administrativa Justech para confirmar esta acción crítica.</p>
                    <field name="action_summary_html" nolabel="1"
                           invisible="action_type != 'save_features'"/>
                    <field name="license_info_html" nolabel="1"
                           invisible="action_type not in ('add_company', 'remove_company', 'change_license')"/>
                    <group>
                        <field name="control_id" invisible="1"/>
                        <field name="panel_id" invisible="1"/>
                        <field name="line_id" invisible="1"/>
                        <field name="license_id" invisible="1"/>
                        <field name="product_code" invisible="1"/>
                        <field name="customization_code" invisible="1"/>
                        <field name="feature_changes" invisible="1"/>
                        <field name="action_type" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="target_company_id" string="Empresa"
                                invisible="action_type not in ('add_company', 'remove_company')"
                                options="{'no_create': True}"/>
                        <field name="new_tier" invisible="action_type != 'change_license'"/>
                        <field name="admin_key" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancelar" special="cancel"/>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_client_module_audit_list" model="ir.ui.view">
        <field name="name">justech.client.module.audit.list</field>
        <field name="model">justech.client.module.audit</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="Fecha"/>
                <field name="user_id" string="Usuario"/>
                <field name="client_name" string="Cliente"/>
                <field name="company_id" string="Empresa"/>
                <field name="commercial_name" string="Personalización"/>
                <field name="action" string="Acción"/>
                <field name="state_before" string="Valor anterior"/>
                <field name="state_after" string="Valor nuevo"/>
                <field name="result" string="Resultado"/>
                <field name="reason" string="Motivo"/>
                <field name="ip_address" string="IP"/>
            </list>
        </field>
    </record>

    <record id="action_justech_client_module_control_open" model="ir.actions.server">
        <field name="name">Abrir Módulos del Cliente</field>
        <field name="model_id" ref="model_justech_client_module_control"/>
        <field name="state">code</field>
        <field name="code">action = env["justech.client.module.control"].action_open()</field>
    </record>
</odoo>
