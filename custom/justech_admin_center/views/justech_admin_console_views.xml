<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_console_form" model="ir.ui.view">
        <field name="name">justech.admin.console.form</field>
        <field name="model">justech.admin.console</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center" create="0" delete="0">
                <header>
                    <button name="action_sync_catalog" type="object" string="Sincronizar catálogo" class="btn-secondary"/>
                    <button name="action_run_diagnostics" type="object" string="Ejecutar diagnóstico" class="btn-primary"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_reauth" type="object" string="Reautenticar" class="btn-secondary"/>
                    <field name="session_ok" invisible="1"/>
                    <field name="last_sync_at" string="Última sincronización"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Productos"/>
                        </button>
                        <button name="action_open_modules" type="object" class="oe_stat_button" icon="fa-puzzle-piece">
                            <field name="installed_count" widget="statinfo" string="Módulos instalados"/>
                        </button>
                        <button name="action_open_company_matrix" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="active_count" widget="statinfo" string="Activaciones"/>
                        </button>
                        <button name="action_open_warnings" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="warning_count" widget="statinfo" string="Advertencias"/>
                        </button>
                        <button name="action_open_errors" type="object" class="oe_stat_button" icon="fa-times-circle">
                            <field name="error_count" widget="statinfo" string="Errores"/>
                        </button>
                        <button name="action_open_companies" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="company_count" widget="statinfo" string="Empresas"/>
                        </button>
                        <button name="action_open_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="justech_user_count" widget="statinfo" string="Usuarios Justech"/>
                        </button>
                        <button name="action_open_uat_users" type="object" class="oe_stat_button" icon="fa-user-secret">
                            <field name="uat_user_count" widget="statinfo" string="Usuarios de prueba"/>
                        </button>
                        <button name="action_open_health" type="object" class="oe_stat_button" icon="fa-heartbeat">
                            <field name="open_finding_count" widget="statinfo" string="Revisiones pendientes"/>
                        </button>
                    </div>
                    <field name="header_html" nolabel="1" colspan="2"/>
                    <group>
                        <group>
                            <field name="search_text" placeholder="Buscar producto o submódulo..."/>
                        </group>
                        <group>
                            <field name="filter_company_id"/>
                        </group>
                    </group>
                    <div class="o_jac_section_title">Productos principales</div>
                    <p class="o_jac_section_hint">
                        Administración Justech → Producto → Submódulo → Acción (máximo tres clics).
                    </p>
                    <field name="product_ids" mode="kanban" nolabel="1"
                             options="{'no_create': True, 'no_open': True}"
                             context="{'kanban_view_ref': 'justech_admin_center.view_justech_admin_product_kanban'}"/>
                    <notebook>
                        <page string="Usuarios de prueba" name="uat">
                            <p class="o_jac_section_hint">
                                Cuentas UAT/TEST solo para pruebas controladas. No deben copiarse a Producción.
                                Los usuarios reales se administran por separado.
                            </p>
                            <div class="o_jac_action_row">
                                <button name="action_open_uat_users" type="object" class="btn btn-secondary"
                                        string="Ver usuarios de prueba"/>
                                <button name="action_archive_uat_users" type="object" class="btn btn-warning"
                                        string="Archivar usuarios de prueba"
                                        groups="justech_admin_center.group_justech_admin_center_manager"/>
                                <button name="action_open_users" type="object" class="btn btn-primary"
                                        string="Usuarios reales y roles"/>
                            </div>
                            <field name="uat_user_ids" mode="list" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name" string="Nombre"/>
                                    <field name="login" string="Usuario"/>
                                    <field name="justech_test_role_label" string="Rol probado"/>
                                    <field name="justech_test_classification" string="Clasificación"/>
                                    <field name="company_id" string="Empresa"/>
                                    <field name="login_date" string="Última actividad"/>
                                    <field name="active" string="Activo"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accesos rápidos" name="quick">
                            <div class="o_jac_action_row">
                                <button name="action_open_products" type="object" class="btn btn-primary" string="Catálogo de productos"/>
                                <button name="action_open_modules" type="object" class="btn btn-secondary" string="Todos los submódulos"/>
                                <button name="action_open_company_matrix" type="object" class="btn btn-secondary" string="Estados por empresa"/>
                                <button name="action_open_users" type="object" class="btn btn-secondary" string="Usuarios y roles"/>
                                <button name="action_open_permission_matrix" type="object" class="btn btn-secondary" string="Matriz de permisos"/>
                                <button name="action_open_health" type="object" class="btn btn-secondary" string="Estado del sistema"/>
                                <button name="action_open_audit" type="object" class="btn btn-secondary" string="Auditoría"/>
                            </div>
                        </page>
                        <page string="Información técnica" name="advanced" groups="base.group_system">
                            <group>
                                <field name="company_id"/>
                                <field name="name"/>
                                <field name="recent_audit_count"/>
                            </group>
                            <p class="o_jac_section_hint">Datos técnicos visibles solo para Administrador del Sistema.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_console" model="ir.actions.server">
        <field name="name">Administración Justech</field>
        <field name="model_id" ref="model_justech_admin_console"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_console()</field>
    </record>
</odoo>
