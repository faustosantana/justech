<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_console_form" model="ir.ui.view">
        <field name="name">justech.admin.console.form</field>
        <field name="model">justech.admin.console</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center" create="0" delete="0">
                <header>
                    <button name="action_sync_catalog" type="object" string="Sincronizar catálogo" class="btn-secondary"/>
                    <button name="action_run_diagnostics" type="object" string="Ejecutar diagnóstico" class="btn-primary"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <field name="last_sync_at"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Administración Justech</h1>
                        <p class="text-muted">Consola central del ecosistema Justech — módulos, roles, salud y auditoría.</p>
                    </div>
                    <field name="kpi_summary" nolabel="1"/>
                    <div class="o_jac_action_row">
                        <button name="action_open_modules" type="object" class="btn btn-primary" string="Catálogo de módulos"/>
                        <button name="action_open_users" type="object" class="btn btn-secondary" string="Usuarios y roles"/>
                        <button name="action_open_companies" type="object" class="btn btn-secondary" string="Empresas"/>
                        <button name="action_open_permission_matrix" type="object" class="btn btn-secondary" string="Matriz de permisos"/>
                        <button name="action_open_health" type="object" class="btn btn-secondary" string="Health Check"/>
                        <button name="action_open_audit" type="object" class="btn btn-secondary" string="Auditoría"/>
                    </div>
                    <notebook>
                        <page string="Resumen" name="summary">
                            <group>
                                <group>
                                    <field name="installed_count"/>
                                    <field name="active_count"/>
                                    <field name="warning_count"/>
                                    <field name="error_count"/>
                                </group>
                                <group>
                                    <field name="company_count"/>
                                    <field name="justech_user_count"/>
                                    <field name="open_finding_count"/>
                                    <field name="recent_audit_count"/>
                                </group>
                            </group>
                        </page>
                        <page string="Módulos instalados" name="installed">
                            <field name="module_ids" mode="kanban"
                                     domain="[('technical_state', '=', 'installed')]"
                                     context="{'kanban_view_ref': 'justech_admin_center.view_justech_admin_module_kanban'}"/>
                        </page>
                        <page string="Catálogo" name="catalog">
                            <field name="module_ids" mode="kanban"/>
                        </page>
                        <page string="Configuración avanzada" name="advanced" groups="base.group_system">
                            <group>
                                <field name="company_id"/>
                                <field name="name"/>
                            </group>
                            <p class="text-muted">Datos técnicos visibles solo para Administrador del Sistema.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_console" model="ir.actions.server">
        <field name="name">Administración Justech</field>
        <field name="model_id" ref="model_justech_admin_console"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_console()</field>
    </record>
</odoo>
