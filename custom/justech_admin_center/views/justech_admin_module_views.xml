<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_module_kanban" model="ir.ui.view">
        <field name="name">justech.admin.module.kanban</field>
        <field name="model">justech.admin.module</field>
        <field name="arch" type="xml">
            <kanban class="o_jac_module_kanban" default_group_by="category">
                <field name="id"/>
                <field name="functional_name"/>
                <field name="short_description"/>
                <field name="version"/>
                <field name="category"/>
                <field name="technical_state"/>
                <field name="functional_state"/>
                <field name="status_visual"/>
                <field name="icon"/>
                <field name="dependency_names"/>
                <field name="supports_activate"/>
                <field name="supports_deactivate"/>
                <templates>
                    <t t-name="card">
                        <div class="o_jac_card" t-attf-class="o_jac_tone_#{record.status_visual.raw_value}">
                            <div class="o_jac_card_head">
                                <i t-attf-class="fa #{record.icon.raw_value or 'fa-cube'}"/>
                                <strong><field name="functional_name"/></strong>
                            </div>
                            <div class="o_jac_card_body text-muted">
                                <field name="short_description"/>
                            </div>
                            <div class="o_jac_card_meta">
                                <span class="badge text-bg-secondary"><field name="version"/></span>
                                <span class="badge text-bg-light"><field name="technical_state"/></span>
                                <span class="badge text-bg-info"><field name="functional_state"/></span>
                            </div>
                            <div class="o_jac_card_actions">
                                <button name="action_open_detail" type="object" class="btn btn-link btn-sm">Detalles</button>
                                <button name="action_prepare_install" type="object" class="btn btn-primary btn-sm"
                                        invisible="technical_state != 'not_installed'">Instalar</button>
                                <button name="action_prepare_activate" type="object" class="btn btn-success btn-sm"
                                        invisible="technical_state != 'installed' or functional_state == 'active' or not supports_activate">Activar</button>
                                <button name="action_prepare_deactivate" type="object" class="btn btn-warning btn-sm"
                                        invisible="technical_state != 'installed' or functional_state != 'active' or not supports_deactivate">Desactivar</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_justech_admin_module_list" model="ir.ui.view">
        <field name="name">justech.admin.module.list</field>
        <field name="model">justech.admin.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="functional_name"/>
                <field name="category"/>
                <field name="version"/>
                <field name="technical_state"/>
                <field name="functional_state"/>
                <field name="status_visual" widget="badge"
                         decoration-success="status_visual == 'green'"
                         decoration-warning="status_visual == 'yellow'"
                         decoration-danger="status_visual == 'red'"
                         decoration-info="status_visual == 'blue'"/>
            </list>
        </field>
    </record>

    <record id="view_justech_admin_module_form" model="ir.ui.view">
        <field name="name">justech.admin.module.form</field>
        <field name="model">justech.admin.module</field>
        <field name="arch" type="xml">
            <form class="o_jac_module_form" create="0" delete="0">
                <header>
                    <button name="action_prepare_install" type="object" string="Instalar" class="btn-primary"
                            invisible="technical_state != 'not_installed'"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_prepare_activate" type="object" string="Activar" class="btn-success"
                            invisible="technical_state != 'installed' or functional_state == 'active' or not supports_activate"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_prepare_deactivate" type="object" string="Desactivar" class="btn-warning"
                            invisible="technical_state != 'installed' or functional_state != 'active' or not supports_deactivate"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_run_health" type="object" string="Health Check"/>
                    <button name="action_open_module" type="object" string="Abrir módulo"/>
                    <field name="status_visual" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="functional_name" readonly="1"/></h1>
                        <h3 class="text-muted"><field name="short_description" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Resumen">
                            <field name="category"/>
                            <field name="version"/>
                            <field name="technical_state"/>
                            <field name="functional_state"/>
                            <field name="last_health_at"/>
                            <field name="last_health_summary"/>
                        </group>
                        <group string="Dependencias">
                            <field name="dependency_names"/>
                            <field name="company_active_count"/>
                            <field name="company_ids_display"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuración" name="config">
                            <group>
                                <field name="supports_activate"/>
                                <field name="supports_deactivate"/>
                                <field name="is_critical"/>
                                <field name="feature_flag_codes"/>
                            </group>
                        </page>
                        <page string="Health Check" name="health">
                            <field name="finding_ids">
                                <list>
                                    <field name="severity"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Auditoría" name="audit">
                            <field name="audit_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="summary"/>
                                    <field name="result"/>
                                    <field name="executed_by"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información técnica" name="tech" groups="base.group_system">
                            <group>
                                <field name="technical_name"/>
                                <field name="ir_module_id"/>
                                <field name="open_action_xmlid"/>
                                <field name="health_method"/>
                                <field name="icon"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_module" model="ir.actions.act_window">
        <field name="name">Catálogo de módulos</field>
        <field name="res_model">justech.admin.module</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
