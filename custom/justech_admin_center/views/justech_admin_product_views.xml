<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_product_kanban" model="ir.ui.view">
        <field name="name">justech.admin.product.kanban</field>
        <field name="model">justech.admin.product</field>
        <field name="arch" type="xml">
            <kanban class="o_jac_product_kanban" create="0" records_draggable="0">
                <field name="name"/>
                <field name="short_description"/>
                <field name="icon"/>
                <field name="module_count"/>
                <field name="installed_count"/>
                <field name="active_company_count"/>
                <field name="meta_label"/>
                <field name="estado_general"/>
                <field name="status_visual"/>
                <templates>
                    <t t-name="card">
                        <div class="o_jac_product_card o_jac_card_interactive"
                             t-attf-class="o_jac_tone_#{record.status_visual.raw_value}">
                            <div class="o_jac_product_head">
                                <i t-attf-class="fa #{record.icon.raw_value or 'fa-cube'}" aria-hidden="true"/>
                                <strong><field name="name"/></strong>
                                <span class="o_jac_estado_pill"><field name="estado_general"/></span>
                            </div>
                            <p class="o_jac_product_desc"><field name="short_description"/></p>
                            <div class="o_jac_product_meta">
                                <span><field name="meta_label"/></span>
                            </div>
                            <div class="o_jac_card_actions">
                                <button name="action_open_detail" type="object"
                                        class="btn btn-primary btn-sm o_jac_stretched"
                                        title="Administrar producto">
                                    Administrar
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_justech_admin_product_list" model="ir.ui.view">
        <field name="name">justech.admin.product.list</field>
        <field name="model">justech.admin.product</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="meta_label"/>
                <field name="estado_general"/>
                <field name="status_visual" widget="badge"
                         decoration-success="status_visual == 'green'"
                         decoration-warning="status_visual == 'yellow'"
                         decoration-danger="status_visual == 'red'"/>
            </list>
        </field>
    </record>

    <record id="view_justech_admin_product_form" model="ir.ui.view">
        <field name="name">justech.admin.product.form</field>
        <field name="model">justech.admin.product</field>
        <field name="arch" type="xml">
            <form class="o_jac_product_form o_justech_admin_center" create="0" delete="0">
                <header>
                    <button name="action_open_detail" type="object" string="Administrar" class="btn-primary"/>
                    <button name="action_run_diagnostics" type="object" string="Diagnosticar" class="btn-secondary"/>
                    <button name="action_open_company_matrix" type="object" string="Empresas" class="btn-secondary"/>
                    <button name="action_open_users" type="object" string="Usuarios" class="btn-secondary"/>
                    <button name="action_open_audit" type="object" string="Auditoría" class="btn-secondary"/>
                    <field name="status_visual" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <p class="o_jac_product_lead"><field name="short_description" readonly="1"/></p>
                    <group>
                        <group string="Estado">
                            <field name="estado_general" string="Estado general"/>
                            <field name="meta_label" string="Resumen"/>
                        </group>
                        <group string="Cobertura">
                            <field name="module_count" string="Submódulos"/>
                            <field name="installed_count" string="Instalados"/>
                            <field name="active_company_count" string="Activaciones por empresa"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resumen" name="summary">
                            <field name="long_description" nolabel="1"/>
                            <separator string="Capacidades incluidas"/>
                            <field name="capabilities_text" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Submódulos" name="modules">
                            <field name="empty_modules_html" nolabel="1" invisible="module_count"/>
                            <field name="module_ids" mode="kanban,list" invisible="not module_count"
                                     context="{'default_product_id': id}">
                                <kanban create="0" class="o_jac_module_kanban">
                                    <field name="functional_name"/>
                                    <field name="short_description"/>
                                    <field name="status_visual"/>
                                    <field name="estado_general"/>
                                    <field name="coverage_label"/>
                                    <field name="icon"/>
                                    <field name="company_active_count"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_jac_card o_jac_card_interactive"
                                                 t-attf-class="o_jac_tone_#{record.status_visual.raw_value}">
                                                <div class="o_jac_card_head">
                                                    <i t-attf-class="fa #{record.icon.raw_value or 'fa-cube'}"/>
                                                    <strong><field name="functional_name"/></strong>
                                                </div>
                                                <div class="o_jac_card_body">
                                                    <field name="short_description"/>
                                                </div>
                                                <div class="o_jac_card_meta">
                                                    <span><field name="estado_general"/></span>
                                                    <span><field name="coverage_label"/></span>
                                                </div>
                                                <div class="o_jac_card_actions">
                                                    <button name="action_open_admin" type="object"
                                                            class="btn btn-primary btn-sm o_jac_stretched">Administrar</button>
                                                    <button name="action_configure" type="object"
                                                            class="btn btn-link btn-sm">Configurar</button>
                                                    <button name="action_view_status" type="object"
                                                            class="btn btn-link btn-sm">Ver estado</button>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <list create="0">
                                    <field name="functional_name"/>
                                    <field name="estado_general"/>
                                    <field name="company_active_count" string="Empresas activas"/>
                                    <field name="status_visual" widget="badge"/>
                                    <button name="action_open_detail" type="object" string="Administrar" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Empresas" name="companies">
                            <p class="o_jac_section_hint">
                                La instalación técnica es global. La activación y el motor se administran por empresa.
                            </p>
                            <field name="company_line_ids" mode="list">
                                <list create="0" delete="0">
                                    <field name="company_id"/>
                                    <field name="module_id" string="Submódulo"/>
                                    <field name="functional_state" string="Estado"/>
                                    <field name="fiscal_engine" string="Motor / configuración"/>
                                    <field name="notes" string="Alertas"/>
                                    <field name="is_global" column_invisible="1"/>
                                    <button name="action_prepare_activate" type="object" string="Activar" class="btn-link"
                                            invisible="functional_state == 'active' or is_global"/>
                                    <button name="action_prepare_deactivate" type="object" string="Desactivar" class="btn-link"
                                            invisible="functional_state != 'active' or is_global"/>
                                    <button name="action_prepare_engine_change" type="object" string="Cambiar motor" class="btn-link"
                                            invisible="is_global"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuración" name="config">
                            <p class="o_jac_section_hint">
                                Use los submódulos y la pestaña Empresas para configurar cada capacidad por compañía.
                                No se muestran códigos técnicos aquí.
                            </p>
                            <button name="action_open_company_matrix" type="object"
                                    string="Abrir matriz completa por empresa" class="btn-secondary"/>
                        </page>
                        <page string="Usuarios y roles" name="users">
                            <p class="o_jac_section_hint">Gestione quién puede administrar este producto.</p>
                            <button name="action_open_users" type="object"
                                    string="Abrir usuarios y roles" class="btn-secondary"/>
                        </page>
                        <page string="Permisos" name="perms">
                            <p class="o_jac_section_hint">
                                Los permisos detallados se administran desde la matriz de permisos de la consola.
                            </p>
                        </page>
                        <page string="Estado del sistema" name="health">
                            <p class="o_jac_section_hint">Ejecute el diagnóstico del producto para revisar alertas abiertas.</p>
                            <button name="action_run_diagnostics" type="object"
                                    string="Ejecutar diagnóstico" class="btn-primary"/>
                        </page>
                        <page string="Auditoría" name="audit">
                            <button name="action_open_audit" type="object"
                                    string="Ver auditoría del producto" class="btn-secondary"/>
                        </page>
                        <page string="Información técnica" name="tech" groups="base.group_system">
                            <group>
                                <field name="code"/>
                                <field name="icon"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_product" model="ir.actions.act_window">
        <field name="name">Productos Justech</field>
        <field name="res_model">justech.admin.product</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
