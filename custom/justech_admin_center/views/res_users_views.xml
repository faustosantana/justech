<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_form_justech_admin_center" model="ir.ui.view">
        <field name="name">res.users.form.justech.admin.center</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Permisos Justech" name="justech_admin_center_perms"
                       groups="base.group_system,justech_admin_center.group_justech_admin_center_manager">
                    <group>
                        <field name="justech_admin_center_role"/>
                        <field name="justech_cap_admin_console"/>
                        <field name="justech_cap_install_modules"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
