<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_company_activation_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.company.activation.wizard.form</field>
        <field name="model">justech.admin.company.activation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar cambio por empresa">
                <group>
                    <field name="line_id" readonly="1"/>
                    <field name="operation" readonly="1"/>
                    <field name="new_engine" invisible="operation != 'engine' and operation != 'activate'"/>
                </group>
                <group string="Estado actual">
                    <field name="preview_before" nolabel="1" colspan="2"/>
                </group>
                <group string="Estado nuevo">
                    <field name="preview_after" nolabel="1" colspan="2"/>
                </group>
                <group string="Impacto">
                    <field name="risks" nolabel="1" colspan="2"/>
                </group>
                <group string="No afecta">
                    <field name="no_impact" nolabel="1" colspan="2"/>
                </group>
                <group string="Rollback">
                    <field name="rollback_notes" nolabel="1" colspan="2"/>
                </group>
                <group>
                    <field name="confirmation"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
