<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_admin_hub_form" model="ir.ui.view">
    <field name="name">justech.ecf.admin.hub.form</field>
    <field name="model">justech.ecf.admin.hub</field>
    <field name="arch" type="xml">
      <form class="o_justech_admin_center o_jac_hub_form o_jac_ecf_hub o_jac_product_shell" create="0" delete="0">
        <header>
          <button name="action_open_setup" type="object"
                  string="Configurar"
                  class="btn-primary"
                  title="Guía paso a paso para configurar e-CF por empresa"/>
          <button name="action_open_certificates" type="object"
                  string="Cargar certificado"
                  class="btn-secondary"
                  title="Administrar certificados P12/PFX"/>
          <button name="action_diagnose" type="object"
                  string="Diagnosticar"
                  class="btn-secondary"/>
          <div class="o_jac_header_more dropdown">
            <button type="button" class="btn btn-secondary dropdown-toggle"
                    data-bs-toggle="dropdown" aria-expanded="false">
              Más
            </button>
            <div class="dropdown-menu">
              <button name="action_open_permissions" type="object"
                      string="Permisos" class="dropdown-item"/>
              <button name="action_open_dashboard" type="object"
                      string="Información técnica" class="dropdown-item"/>
            </div>
          </div>
        </header>
        <sheet>
          <div class="oe_title o_jac_product_title">
            <span class="o_jac_hierarchy_badge o_jac_hierarchy_lg">1.3</span>
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <field name="intro_html" nolabel="1" widget="html"/>

          <div class="o_jac_status_strip o_jac_ecf_status">
            <div><span class="o_jac_muted">Empresa activa</span><strong><field name="company_id" readonly="1"/></strong></div>
            <div><span class="o_jac_muted">Ambiente</span><strong><field name="fiscal_mode_label" readonly="1"/></strong></div>
            <div><span class="o_jac_muted">Certificado</span><strong><field name="certificate_label" readonly="1"/></strong></div>
            <div><span class="o_jac_muted">Conexión DGII</span><strong><field name="dgii_label" readonly="1"/></strong></div>
            <div><span class="o_jac_muted">Cola</span><strong><field name="queue_label" readonly="1"/></strong></div>
            <div><span class="o_jac_muted">Errores</span><strong><field name="errors_label" readonly="1"/></strong></div>
            <div><span class="o_jac_muted">Última transmisión</span><strong><field name="last_tx_label" readonly="1"/></strong></div>
          </div>

          <field name="recommended_html" nolabel="1" widget="html"/>
          <div class="o_jac_ecf_action_cards">
            <div class="o_jac_ecf_action_card">
              <button name="action_load_certificate" type="object" class="btn btn-link p-0 text-start w-100">
                <strong>Cargar certificado</strong>
                <span>Asigne el P12/PFX de la empresa activa.</span>
              </button>
            </div>
            <div class="o_jac_ecf_action_card">
              <button name="action_switch_certification" type="object" class="btn btn-link p-0 text-start w-100">
                <strong>Cambiar a certificación</strong>
                <span>Configure el modo fiscal e-CF por empresa.</span>
              </button>
            </div>
            <div class="o_jac_ecf_action_card">
              <button name="action_test_signature" type="object" class="btn btn-link p-0 text-start w-100">
                <strong>Ejecutar prueba de firma</strong>
                <span>Abre el asistente de implementación.</span>
              </button>
            </div>
            <div class="o_jac_ecf_action_card">
              <button name="action_check_dgii" type="object" class="btn btn-link p-0 text-start w-100">
                <strong>Revisar conexión DGII</strong>
                <span>Ejecuta diagnóstico de conectividad y módulos.</span>
              </button>
            </div>
          </div>

          <field name="stats_html" nolabel="1" widget="html"/>
          <div class="o_jac_action_row">
            <button name="action_open_pending_kpi" type="object" class="btn btn-secondary btn-sm"
                    title="Abrir cola de pendientes">
              Pendientes (<field name="pending_count" readonly="1"/>)
            </button>
            <button name="action_open_sent_kpi" type="object" class="btn btn-secondary btn-sm"
                    title="Ver documentos enviados">
              Enviados (<field name="sent_count" readonly="1"/>)
            </button>
            <button name="action_open_accepted_kpi" type="object" class="btn btn-secondary btn-sm"
                    title="Ver documentos aceptados">
              Aceptados (<field name="accepted_count" readonly="1"/>)
            </button>
            <button name="action_open_rejected_kpi" type="object" class="btn btn-secondary btn-sm"
                    title="Ver documentos rechazados">
              Rechazados (<field name="rejected_count" readonly="1"/>)
            </button>
          </div>

          <div class="o_jac_shell_body">
            <notebook class="o_jac_side_notebook">
              <page string="Resumen" name="summary">
                <p class="o_jac_section_hint">Estado general de la empresa activa. Cambie de empresa desde el selector de Odoo.</p>
              </page>
              <page string="Empresas" name="companies">
                <button name="action_open_config" type="object"
                        string="Administrar empresas"
                        class="btn-primary"
                        title="Configuración e-CF por empresa"/>
              </page>
              <page string="Implementación" name="setup">
                <button name="action_open_setup" type="object"
                        string="Abrir asistente de implementación"
                        class="btn-primary"/>
              </page>
              <page string="Certificados" name="certs">
                <button name="action_open_certificates" type="object"
                        string="Administrar certificados"
                        class="btn-primary"/>
              </page>
              <page string="Documentos" name="docs">
                <button name="action_open_documents" type="object"
                        string="Abrir documentos e-CF"
                        class="btn-primary"/>
              </page>
              <page string="Recepción" name="inbound">
                <button name="action_open_inbound" type="object"
                        string="Recepción de proveedores"
                        class="btn-secondary"/>
              </page>
              <page string="Colas" name="queue">
                <button name="action_open_queue" type="object"
                        string="Abrir cola de envíos"
                        class="btn-primary"/>
              </page>
              <page string="Diagnóstico" name="diag">
                <button name="action_diagnose" type="object"
                        string="Ejecutar diagnóstico e-CF"
                        class="btn-primary"/>
              </page>
            </notebook>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_justech_ecf_admin_hub" model="ir.actions.server">
    <field name="name">Facturación electrónica e-CF</field>
    <field name="model_id" ref="model_justech_ecf_admin_hub"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open()</field>
  </record>
</odoo>
