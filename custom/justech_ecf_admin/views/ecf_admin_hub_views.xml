<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_admin_hub_form" model="ir.ui.view">
    <field name="name">justech.ecf.admin.hub.form</field>
    <field name="model">justech.ecf.admin.hub</field>
    <field name="arch" type="xml">
      <form class="o_justech_admin_center o_jac_hub_form" create="0" delete="0">
        <header>
          <button name="action_open_setup" type="object" string="Asistente de implementación" class="btn-primary"/>
          <button name="action_diagnose" type="object" string="Diagnosticar" class="btn-secondary"/>
          <button name="action_open_dashboard" type="object" string="Dashboard" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <field name="intro_html" nolabel="1"/>
          <separator string="Administración"/>
          <div class="o_jac_action_row">
            <button name="action_open_config" type="object" class="btn btn-secondary" string="Empresas / modo fiscal"/>
            <button name="action_open_certificates" type="object" class="btn btn-secondary" string="Certificados"/>
            <button name="action_open_documents" type="object" class="btn btn-secondary" string="Documentos"/>
            <button name="action_open_queue" type="object" class="btn btn-secondary" string="Cola y reintentos"/>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_justech_ecf_admin_hub" model="ir.actions.server">
    <field name="name">Justech e-CF</field>
    <field name="model_id" ref="model_justech_ecf_admin_hub"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open()</field>
  </record>
</odoo>
