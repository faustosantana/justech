<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_dashboard_form" model="ir.ui.view">
    <field name="name">justech.ecf.dashboard.form</field>
    <field name="model">justech.ecf.dashboard</field>
    <field name="arch" type="xml">
      <form class="o_justech_admin_center o_jac_hub_form" create="0" delete="0">
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <field name="company_id"/>
            <field name="environment_label"/>
            <field name="cert_label"/>
          </group>
          <field name="summary_html" nolabel="1"/>
          <div class="o_jac_action_row">
            <button name="action_open_accepted" type="object" class="btn btn-secondary"
                    string="Aceptados" icon="fa-check"/>
            <field name="count_accepted" class="oe_inline"/>
            <button name="action_open_rejected" type="object" class="btn btn-secondary" string="Rechazados"/>
            <field name="count_rejected"/>
            <button name="action_open_pending" type="object" class="btn btn-secondary" string="Pendientes"/>
            <field name="count_pending"/>
            <button name="action_open_contingency" type="object" class="btn btn-secondary" string="Contingencia"/>
            <field name="count_contingency"/>
            <button name="action_open_queue" type="object" class="btn btn-primary" string="Cola"/>
            <field name="count_queue"/>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_justech_ecf_dashboard" model="ir.actions.server">
    <field name="name">Dashboard e-CF</field>
    <field name="model_id" ref="model_justech_ecf_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open()</field>
  </record>
</odoo>
