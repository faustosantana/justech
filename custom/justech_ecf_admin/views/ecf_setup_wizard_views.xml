<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_setup_wizard_form" model="ir.ui.view">
    <field name="name">justech.ecf.setup.wizard.form</field>
    <field name="model">justech.ecf.setup.wizard</field>
    <field name="arch" type="xml">
      <form string="Implementación Justech e-CF">
        <group>
          <field name="step"/>
          <field name="company_id"/>
          <field name="fiscal_mode"/>
          <field name="dgii_environment"/>
        </group>
        <field name="checklist_html" nolabel="1"/>
        <field name="result_message" invisible="not result_message"/>
        <footer>
          <button name="action_back" type="object" string="Volver" class="btn-secondary"/>
          <button name="action_next" type="object" string="Continuar" class="btn-primary"/>
          <button name="action_activate" type="object" string="Activar" class="btn-primary"/>
          <button string="Cerrar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
