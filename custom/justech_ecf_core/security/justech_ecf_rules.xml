<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ecf_config_company" model="ir.rule">
        <field name="name">e-CF config multiempresa</field>
        <field name="model_id" ref="model_justech_ecf_company_config"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecf_readonly'))]"/>
    </record>
    <record id="rule_ecf_cert_company" model="ir.rule">
        <field name="name">e-CF certificado multiempresa</field>
        <field name="model_id" ref="model_justech_ecf_certificate"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecf_readonly'))]"/>
    </record>
    <record id="rule_ecf_doc_company" model="ir.rule">
        <field name="name">e-CF documento multiempresa</field>
        <field name="model_id" ref="model_justech_ecf_document"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecf_readonly'))]"/>
    </record>
    <record id="rule_ecf_evt_company" model="ir.rule">
        <field name="name">e-CF evento multiempresa</field>
        <field name="model_id" ref="model_justech_ecf_document_event"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecf_readonly'))]"/>
    </record>
</odoo>
