<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_certificate_form" model="ir.ui.view">
    <field name="name">justech.ecf.certificate.form</field>
    <field name="model">justech.ecf.certificate</field>
    <field name="arch" type="xml">
      <form string="Certificado e-CF">
        <header>
          <button name="action_validate_certificate" type="object" string="Validar / cargar" class="btn-primary"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="company_id"/>
              <field name="p12_filename"/>
              <field name="alert_days_before_expiry"/>
            </group>
            <group>
              <field name="subject_cn"/>
              <field name="subject_rnc"/>
              <field name="serial_number"/>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="fingerprint_sha256"/>
            </group>
          </group>
          <field name="last_validation_message"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_justech_ecf_certificate_list" model="ir.ui.view">
    <field name="name">justech.ecf.certificate.list</field>
    <field name="model">justech.ecf.certificate</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="company_id"/>
        <field name="state"/>
        <field name="subject_rnc"/>
        <field name="date_end"/>
      </list>
    </field>
  </record>
  <record id="action_justech_ecf_certificate" model="ir.actions.act_window">
    <field name="name">Certificados e-CF</field>
    <field name="res_model">justech.ecf.certificate</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
