<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_document_event_list" model="ir.ui.view">
    <field name="name">justech.ecf.document.event.list</field>
    <field name="model">justech.ecf.document.event</field>
    <field name="arch" type="xml">
      <list create="0" delete="0">
        <field name="create_date"/>
        <field name="company_id"/>
        <field name="document_id"/>
        <field name="event_type"/>
        <field name="result"/>
        <field name="message"/>
        <field name="user_id"/>
      </list>
    </field>
  </record>
  <record id="action_justech_ecf_document_event" model="ir.actions.act_window">
    <field name="name">Eventos e-CF</field>
    <field name="res_model">justech.ecf.document.event</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
