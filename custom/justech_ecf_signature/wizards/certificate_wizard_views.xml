<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_justech_ecf_certificate_wizard_form" model="ir.ui.view">
    <field name="name">justech.ecf.certificate.wizard.form</field>
    <field name="model">justech.ecf.certificate.wizard</field>
    <field name="arch" type="xml">
      <form string="Cargar certificado e-CF">
        <group>
          <field name="company_id"/>
          <field name="p12_file" filename="p12_filename"/>
          <field name="p12_filename" invisible="1"/>
          <field name="password" password="True"/>
        </group>
        <group invisible="not validation_message">
          <field name="state"/>
          <field name="subject_cn"/>
          <field name="date_end"/>
          <field name="validation_message"/>
        </group>
        <footer>
          <button name="action_validate_and_store" type="object" string="Validar y guardar cifrado" class="btn-primary"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
