<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_justech_fiscal_admin_user" model="res.groups">
        <field name="name">Fiscal Admin / Usuario</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('justech_l10n_do_base.group_justech_do_fiscal_user'))]"/>
    </record>
    <record id="group_justech_fiscal_admin_manager" model="res.groups">
        <field name="name">Fiscal Admin / Administrador</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_justech_fiscal_admin_user'))]"/>
    </record>
    <!-- Visibilidad sin modo desarrollador: contadores y administradores del sistema -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_justech_fiscal_admin_manager'))]"/>
    </record>
    <record id="justech_l10n_do_base.group_justech_do_fiscal_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_justech_fiscal_admin_manager'))]"/>
    </record>
</odoo>
