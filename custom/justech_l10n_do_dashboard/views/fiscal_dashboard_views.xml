<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_dashboard_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.dashboard.form</field>
        <field name="model">justech.do.fiscal.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Fiscal" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_justech_do_fiscal_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Fiscal</field>
        <field name="res_model">justech.do.fiscal.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" ref="fiscal_dashboard_main_company"/>
    </record>
</odoo>
