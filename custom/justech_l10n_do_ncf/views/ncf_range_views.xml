<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_ncf_range_tree" model="ir.ui.view">
        <field name="name">justech.do.ncf.range.list</field>
        <field name="model">justech.do.ncf.range</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="prefix"/>
                <field name="next_sequence"/>
                <field name="sequence_end"/>
                <field name="remaining_count"/>
                <field name="date_to"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_justech_do_ncf_range_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.range.form</field>
        <field name="model">justech.do.ncf.range</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled', 'depleted', 'expired')"/>
                    <button name="action_set_draft" string="Set Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_type_id"/>
                            <field name="prefix"/>
                            <field name="authorization_number"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="journal_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Sequence">
                        <field name="sequence_start"/>
                        <field name="sequence_end"/>
                        <field name="next_sequence"/>
                        <field name="remaining_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_justech_do_ncf_range" model="ir.actions.act_window">
        <field name="name">Rangos NCF</field>
        <field name="res_model">justech.do.ncf.range</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
