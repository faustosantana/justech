<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_ncf_void_wizard_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.void.wizard.form</field>
        <field name="model">justech.do.ncf.void.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular comprobante fiscal">
                <div class="alert alert-info" role="alert" invisible="not help_note">
                    <field name="help_note" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not payment_warning">
                    <field name="payment_warning" nolabel="1"/>
                </div>
                <group>
                    <group string="Documento">
                        <field name="move_id"/>
                        <field name="company_id"/>
                        <field name="partner_id"/>
                        <field name="document_type_id"/>
                        <field name="ncf"/>
                        <field name="invoice_date"/>
                        <field name="state"/>
                        <field name="payment_state"/>
                    </group>
                    <group string="Anulación">
                        <field name="cancel_type"/>
                        <field name="observation"
                               placeholder="Detalle del motivo (obligatorio si Motivo = Otro)..."/>
                        <field name="requester_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm_void"
                            string="Confirmar anulación"
                            type="object"
                            class="btn-danger"
                            data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
