<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_justech_wh" model="ir.ui.view">
        <field name="name">account.payment.form.justech.wh</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_justech_view_related_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="justech_related_invoice_count == 0">
                    <field name="justech_related_invoice_count" widget="statinfo" string="Facturas"/>
                </button>
                <button name="action_justech_view_payment_move"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="not move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Asiento</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Facturas relacionadas" name="justech_related_invoices"
                      invisible="not reconciled_invoice_ids and not reconciled_bill_ids and not justech_application_line_ids">
                    <group>
                        <field name="reconciled_invoice_ids" string="Facturas de cliente"
                               widget="many2many_tags" readonly="1"
                               invisible="not reconciled_invoice_ids"/>
                        <field name="reconciled_bill_ids" string="Facturas de proveedor"
                               widget="many2many_tags" readonly="1"
                               invisible="not reconciled_bill_ids"/>
                    </group>
                    <field name="justech_application_line_ids" readonly="1"
                           invisible="not justech_application_line_ids">
                        <list>
                            <field name="move_id" string="Factura"/>
                            <field name="ncf"/>
                            <field name="invoice_date"/>
                            <field name="invoice_total"/>
                            <field name="applied_amount"/>
                            <field name="withholding_amount"/>
                            <field name="net_amount"/>
                            <field name="reconciliation_state" string="Estado pago factura"/>
                        </list>
                    </field>
                </page>
                <page string="Retenciones aplicadas" name="justech_withholding"
                      invisible="not justech_withholding_line_ids">
                    <group>
                        <field name="justech_applied_amount" readonly="1"/>
                        <field name="justech_withholding_total" readonly="1"/>
                        <field name="justech_net_transfer" readonly="1"/>
                    </group>
                    <field name="justech_withholding_line_ids" readonly="1">
                        <list>
                            <field name="move_id" string="Factura"/>
                            <field name="ncf"/>
                            <field name="label" string="Retención"/>
                            <field name="withholding_type" string="Tipo" optional="show"/>
                            <field name="base_amount" string="Base"/>
                            <field name="rate" string="%"/>
                            <field name="amount" string="Importe"/>
                            <field name="dgii_withholding_code" string="Código DGII"/>
                            <field name="fiscal_report_codes" string="Reportes"/>
                            <field name="date" string="Fecha"/>
                            <field name="account_id" optional="hide"/>
                            <field name="state" string="Estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_justech_wh" model="ir.ui.view">
        <field name="name">account.move.form.justech.wh</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_justech_view_withholdings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-percent"
                        invisible="justech_withholding_count == 0">
                    <field name="justech_withholding_count" widget="statinfo" string="Retenciones"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Retenciones" name="justech_withholding"
                      invisible="not justech_withholding_line_ids">
                    <field name="justech_withholding_line_ids" readonly="1">
                        <list>
                            <field name="payment_id" string="Pago"/>
                            <field name="label" string="Retención"/>
                            <field name="amount" string="Importe"/>
                            <field name="date" string="Fecha"/>
                            <field name="dgii_withholding_code" string="Código DGII"/>
                            <field name="fiscal_report_codes" string="Reporte DGII"/>
                            <field name="state" string="Estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
