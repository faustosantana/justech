<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_payment_partner_wizard_form" model="ir.ui.view">
        <field name="name">justech.payment.partner.wizard.form</field>
        <field name="model">justech.payment.partner.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar pago">
                <group>
                    <group string="Contacto y moneda">
                        <field name="partner_type" invisible="1"/>
                        <field name="partner_id"
                               string="Cliente"
                               invisible="partner_type != 'customer'"
                               options="{'no_create': True}"/>
                        <field name="partner_id"
                               string="Proveedor"
                               invisible="partner_type != 'supplier'"
                               options="{'no_create': True}"/>
                        <field name="currency_id"/>
                        <field name="payment_date"/>
                        <field name="communication" string="Concepto de pago"/>
                    </group>
                    <group string="Banco y totales">
                        <field name="journal_id" string="Banco"/>
                        <field name="payment_method_line_id" string="Método de pago"/>
                        <field name="payment_total" readonly="1" string="Total bruto"/>
                        <field name="withholding_total" readonly="1" string="Total retenido"/>
                        <field name="amount_after_withholding" readonly="1" string="Neto a transferir"/>
                    </group>
                </group>

                <group string="Facturas pendientes">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="apply" string="Aplicar" force_save="1"/>
                            <field name="invoice_name" string="Factura"/>
                            <field name="ncf" string="NCF"/>
                            <field name="invoice_date" string="Fecha"/>
                            <field name="date_maturity" string="Vencimiento"/>
                            <field name="amount_total" string="Total"/>
                            <field name="amount_untaxed" string="Base imponible" optional="show"/>
                            <field name="amount_tax" string="ITBIS" optional="show"/>
                            <field name="amount_residual" string="Pendiente"/>
                            <field name="amount_to_pay" string="Monto a aplicar" force_save="1"
                                   readonly="not apply"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="move_scope_filter" column_invisible="1"/>
                            <field name="withholding_catalog_ids"
                                   string="Retenciones"
                                   widget="many2many_tags"
                                   readonly="not apply"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('active', '=', True), ('code', 'not in', ['RET-NONE', 'wh_none']), ('partner_scope', 'in', [parent.partner_type, 'both']), ('move_scope', 'in', [move_scope_filter, 'both']), ('company_id', '=', company_id), ('account_id', '!=', False)]"/>
                            <field name="withholding_summary" string="Resumen" readonly="1" optional="show"/>
                            <field name="withholding_amount" string="Retenido" readonly="1"/>
                            <field name="net_after_withholding" string="Neto" readonly="1" optional="show"/>
                            <field name="move_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>

                <group string="Detalle de retenciones" invisible="not withholding_line_ids">
                    <field name="withholding_line_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="invoice_name" string="Factura"/>
                            <field name="label" string="Retención"/>
                            <field name="base_label" string="Tipo de base"/>
                            <field name="base_amount" string="Base"/>
                            <field name="rate" string="Porcentaje"/>
                            <field name="amount" string="Monto retenido"/>
                            <field name="account_id" string="Cuenta contable"/>
                        </list>
                    </field>
                </group>

                <group string="Datos del método de pago">
                    <field name="justech_show_card_fields" invisible="1"/>
                    <field name="justech_show_check_fields" invisible="1"/>
                    <field name="justech_payment_reference" string="Referencia"/>
                    <field name="justech_card_auth" string="Autorización"
                           invisible="not justech_show_card_fields"/>
                    <field name="justech_card_batch" string="Lote"
                           invisible="not justech_show_card_fields"/>
                    <field name="justech_check_bank_id" string="Banco emisor"
                           invisible="not justech_show_check_fields"/>
                    <field name="justech_check_number" string="Número de cheque"
                           invisible="not justech_show_check_fields"/>
                    <field name="justech_check_date" string="Fecha del cheque"
                           invisible="not justech_show_check_fields"/>
                </group>

                <footer>
                    <button name="action_register_payments" type="object"
                            string="Registrar pago" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_register_customer_payment" model="ir.actions.act_window">
        <field name="name">Registrar cobro</field>
        <field name="res_model">justech.payment.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_type': 'customer'}</field>
    </record>

    <record id="action_justech_register_vendor_payment" model="ir.actions.act_window">
        <field name="name">Registrar pago</field>
        <field name="res_model">justech.payment.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_type': 'supplier'}</field>
    </record>

    <record id="view_account_payment_tree_customer_justech" model="ir.ui.view">
        <field name="name">account.payment.tree.customer.justech</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(justech_l10n_do_payments_withholding.action_justech_register_customer_payment)d"
                            type="action" string="Registrar cobro" class="btn-primary" display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_vendor_justech" model="ir.ui.view">
        <field name="name">account.payment.tree.vendor.justech</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(justech_l10n_do_payments_withholding.action_justech_register_vendor_payment)d"
                            type="action" string="Registrar pago" class="btn-primary" display="always"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
