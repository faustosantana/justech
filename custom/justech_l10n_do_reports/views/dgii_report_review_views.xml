<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_report_line_review_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.line.review.list</field>
        <field name="model">justech.do.fiscal.report.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0"
                  decoration-success="fiscal_state == 'valid' and include_in_report"
                  decoration-warning="fiscal_state == 'incomplete'"
                  decoration-muted="fiscal_state in ('excluded', 'cancelled') or not include_in_report">
                <field name="include_in_report" readonly="1"/>
                <field name="fiscal_state" widget="badge"
                       decoration-success="fiscal_state == 'valid'"
                       decoration-warning="fiscal_state == 'incomplete'"
                       decoration-danger="fiscal_state == 'excluded'"
                       decoration-muted="fiscal_state == 'cancelled'"/>
                <field name="move_name" string="Documento"/>
                <field name="document_type"/>
                <field name="ncf"/>
                <field name="ncf_modified" optional="show"/>
                <field name="partner_name" string="Cliente / Proveedor"/>
                <field name="partner_vat" string="RNC / Cédula"/>
                <field name="document_date" string="Fecha"/>
                <field name="invoice_date_due" string="Vencimiento" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount_total" string="Total"/>
                <field name="amount_tax" string="ITBIS"/>
                <field name="amount_withholding" string="Retenciones" optional="show"/>
                <field name="payment_method_code" string="Forma pago" optional="show"/>
                <field name="exclusion_reason" optional="show"/>
                <field name="manual_exclusion" column_invisible="1"/>
                <field name="line_approval_state" optional="show"/>
                <field name="approved_by_id" optional="hide"/>
                <field name="approved_at" optional="hide"/>
                <field name="error_message" optional="hide"/>
                <field name="move_id" column_invisible="1"/>
                    <button name="action_open_move" type="object" icon="fa-external-link"
                            title="Abrir documento"/>
                    <button name="action_exclude_line" type="object" icon="fa-ban"
                            title="Excluir de DGII"
                            invisible="not include_in_report"/>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_report_line_search" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.line.search</field>
        <field name="model">justech.do.fiscal.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_name"/>
                <field name="partner_name"/>
                <field name="ncf"/>
                <filter name="filter_valid" string="Válidos"
                        domain="[('fiscal_state', '=', 'valid'), ('include_in_report', '=', True)]"/>
                <filter name="filter_incomplete" string="Incompletos"
                        domain="[('fiscal_state', '=', 'incomplete')]"/>
                <filter name="filter_excluded" string="Excluidos"
                        domain="['|', ('fiscal_state', '=', 'excluded'), ('include_in_report', '=', False)]"/>
                <filter name="filter_cancelled" string="Anulados"
                        domain="[('fiscal_state', '=', 'cancelled')]"/>
                <filter name="filter_manual" string="Exclusión manual"
                        domain="[('manual_exclusion', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_justech_do_fiscal_report_review_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.review.form</field>
        <field name="model">justech.do.fiscal.report</field>
        <field name="inherit_id" ref="justech_l10n_do_reports.view_justech_do_fiscal_report_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">1</attribute>
            </xpath>
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_load_review_lines" string="Cargar período" type="object"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_validate_period" string="Validar período" type="object"
                            invisible="state not in ('draft', 'rejected') or not line_ids"/>
                    <button name="action_submit_for_approval" string="Enviar a aprobación" type="object"
                            invisible="state != 'validated' or manual_exclusion_count == 0"/>
                    <button name="action_approve_report" string="Aprobar exclusiones" type="object"
                            invisible="state != 'pending_approval'"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_reject_report" string="Rechazar exclusiones" type="object"
                            invisible="state != 'pending_approval'"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_generate_dgii_export" string="Generar Excel DGII" type="object"
                            class="btn-primary"
                            invisible="state != 'validated' or manual_exclusion_count != 0"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_generate_dgii_export" string="Generar Excel DGII" type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_download_errors" string="Descargar errores" type="object"
                            invisible="not error_report_file"/>
                    <button name="action_reopen_report" string="Reabrir" type="object"
                            invisible="state not in ('generated', 'done')"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,pending_approval,approved,generated"/>
                </header>
            </xpath>
            <xpath expr="//group[@string='Totales del período']" position="before">
                <group string="Resumen revisión">
                    <group>
                        <field name="review_line_count" readonly="1"/>
                        <field name="review_valid_count" readonly="1"/>
                        <field name="review_incomplete_count" readonly="1"/>
                        <field name="review_excluded_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="manual_exclusion_count" readonly="1"/>
                        <field name="pending_approval_count" readonly="1"/>
                        <field name="validated_by_id" readonly="1"/>
                        <field name="validated_at" readonly="1"/>
                        <field name="approved_by_id" readonly="1"/>
                        <field name="export_file_hash" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@string='Líneas']" position="attributes">
                <attribute name="string">Revisión en línea</attribute>
            </xpath>
            <xpath expr="//page[@string='Revisión en línea']//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}</attribute>
            </xpath>
            <xpath expr="//page[@string='Revisión en línea']//field[@name='line_ids']/list" position="replace">
                <list editable="bottom" create="0" delete="0">
                    <field name="include_in_report" readonly="1"/>
                    <field name="fiscal_state"/>
                    <field name="move_name"/>
                    <field name="document_type"/>
                    <field name="ncf"/>
                    <field name="ncf_modified"/>
                    <field name="partner_name"/>
                    <field name="partner_vat"/>
                    <field name="document_date"/>
                    <field name="invoice_date_due"/>
                    <field name="currency_id"/>
                    <field name="amount_total"/>
                    <field name="amount_tax"/>
                    <field name="amount_withholding"/>
                    <field name="payment_method_code"/>
                    <field name="exclusion_reason"/>
                    <field name="approved_by_id"/>
                    <field name="approved_at"/>
                    <button name="action_open_move" type="object" icon="fa-external-link"/>
                </list>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Aprobaciones" invisible="not approval_ids">
                    <field name="approval_ids" readonly="1">
                        <list>
                            <field name="line_id"/>
                            <field name="state"/>
                            <field name="exclusion_reason"/>
                            <field name="requested_by_id"/>
                            <field name="reviewed_by_id"/>
                            <field name="reviewed_at"/>
                            <field name="comment"/>
                        </list>
                    </field>
                </page>
                <page string="Bitácora">
                    <field name="audit_ids" readonly="1">
                        <list>
                            <field name="create_date"/>
                            <field name="event_type"/>
                            <field name="user_id"/>
                            <field name="move_id"/>
                            <field name="description"/>
                            <field name="file_hash"/>
                            <field name="file_name"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="view_justech_do_dgii_report_exclude_wizard" model="ir.ui.view">
        <field name="name">justech.do.dgii.report.exclude.wizard.form</field>
        <field name="model">justech.do.dgii.report.exclude.wizard</field>
        <field name="arch" type="xml">
            <form string="Excluir de DGII">
                <group>
                    <field name="report_id" readonly="1"/>
                    <field name="line_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Motivo obligatorio de exclusión fiscal..."/>
                </group>
                <footer>
                    <button name="action_confirm_exclude" string="Confirmar exclusión" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_do_dgii_report_reject_wizard" model="ir.ui.view">
        <field name="name">justech.do.dgii.report.reject.wizard.form</field>
        <field name="model">justech.do.dgii.report.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar exclusiones">
                <group>
                    <field name="report_id" readonly="1"/>
                    <field name="comment" placeholder="Indique por qué se rechazan las exclusiones..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Rechazar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_do_fiscal_review" model="ir.actions.act_window">
        <field name="name">Revisión fiscal DGII</field>
        <field name="res_model">justech.do.fiscal.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_report_type': '606', 'default_state': 'draft'}</field>
        <field name="domain">[('report_type', 'in', ('606', '607', '608'))]</field>
    </record>

    <record id="action_justech_do_fiscal_review_pending" model="ir.actions.act_window">
        <field name="name">Pendientes de aprobación</field>
        <field name="res_model">justech.do.fiscal.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending_approval')]</field>
    </record>
</odoo>
