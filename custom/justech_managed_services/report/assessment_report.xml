<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_managed_service_assessment" model="report.paperformat">
        <field name="name">Levantamiento Servicios Administrados</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
    </record>

    <template id="report_managed_service_assessment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="print_sections" t-value="doc.get_form_print_sections()"/>
                <div class="page" style="font-family: DejaVu Sans, Arial, sans-serif; font-size: 11px; color: #1f2937;">
                    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                    <div style="text-align:center; margin-bottom: 20px;">
                        <img t-att-src="'/logo.png?company=%s' % doc.company_id.id" style="max-height: 60px;" alt="Logo"/>
                        <h2 style="color:#1a4f8c; margin: 12px 0 4px;">Levantamiento de Servicios Administrados</h2>
                        <p><strong><t t-esc="doc.partner_id.display_name"/></strong></p>
                    </div>
                    <table style="width:100%; margin-bottom: 16px;" class="table table-sm">
                        <tr>
                            <td><strong>Referencia:</strong> <t t-esc="doc.name"/></td>
                            <td><strong>Estado:</strong> <t t-esc="dict(doc._fields['state'].selection).get(doc.state)"/></td>
                        </tr>
                        <tr>
                            <td><strong>Consultor:</strong> <t t-esc="doc.consultant_id.name or ''"/></td>
                            <td><strong>Completado:</strong> <t t-esc="doc.date_done or ''"/></td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <strong>Responsable:</strong>
                                <t t-esc="doc.completed_by_name or doc.org_responsible or ''"/>
                                —
                                <t t-esc="doc.completed_by_job or doc.org_job or ''"/>
                            </td>
                        </tr>
                    </table>
                    <t t-if="doc.summary">
                        <h3 style="color:#1a4f8c;">Resumen ejecutivo</h3>
                        <p t-esc="doc.summary"/>
                    </t>
                    <t t-foreach="print_sections" t-as="section">
                        <h3 style="color:#1a4f8c; border-bottom: 1px solid #d8e2ef; padding-bottom: 4px; margin-top: 14px;" t-esc="section['heading']"/>
                        <t t-if="section['rows']">
                            <t t-foreach="section['rows']" t-as="row">
                                <p>
                                    <strong t-esc="row['label']"/>:
                                    <t t-esc="row['value']"/>
                                </p>
                            </t>
                        </t>
                        <t t-else="">
                            <p style="color:#6b7280;"><em>Sin respuestas registradas en esta sección.</em></p>
                        </t>
                    </t>
                    <div style="margin-top: 24px; border-top: 1px solid #d8e2ef; padding-top: 10px; text-align: center; font-size: 10px; color: #6b7280;">
                        Documento generado por Justech — Servicios Administrados — <t t-esc="doc.name"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
