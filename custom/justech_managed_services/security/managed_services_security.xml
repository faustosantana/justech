<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_justech_managed_services" model="ir.module.category">
        <field name="name">Justech Servicios Administrados</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_justech_managed_services" model="res.groups.privilege">
        <field name="name">Servicios Administrados</field>
        <field name="category_id" ref="module_category_justech_managed_services"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_ms_user" model="res.groups">
        <field name="name">Usuario de Servicios Administrados</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_managed_services"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Crea y gestiona levantamientos y servicios asignados.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_ms_commercial" model="res.groups">
        <field name="name">Comercial de Servicios Administrados</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_managed_services"/>
        <field name="implied_ids" eval="[(4, ref('group_ms_user'))]"/>
        <field name="comment">Gestiona levantamientos, oportunidades y cotizaciones.</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_ms_technician" model="res.groups">
        <field name="name">Técnico de Servicios Administrados</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_managed_services"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Consulta servicios y gestiona tickets; sin fees ni contratos.</field>
        <field name="sequence">12</field>
    </record>

    <record id="group_ms_manager" model="res.groups">
        <field name="name">Administrador de Servicios Administrados</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_managed_services"/>
        <field name="implied_ids" eval="[(4, ref('group_ms_commercial')), (4, ref('group_ms_technician'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Acceso completo funcional al módulo.</field>
        <field name="sequence">20</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ms_manager'))]"/>
    </record>

    <!-- Levantamientos -->
    <record id="rule_ms_assessment_user" model="ir.rule">
        <field name="name">Levantamientos: usuario asignado</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">['|', ('consultant_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ms_user'))]"/>
    </record>
    <record id="rule_ms_assessment_technician" model="ir.rule">
        <field name="name">Levantamientos: técnico lectura amplia</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_ms_technician'))]"/>
    </record>
    <record id="rule_ms_assessment_manager" model="ir.rule">
        <field name="name">Levantamientos: administrador total</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ms_manager'))]"/>
    </record>
    <record id="rule_ms_assessment_company" model="ir.rule">
        <field name="name">Levantamientos: multi-compañía</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Servicios -->
    <record id="rule_ms_service_user" model="ir.rule">
        <field name="name">Servicios: usuario asignado</field>
        <field name="model_id" ref="model_justech_managed_service"/>
        <field name="domain_force">['|', '|', ('salesperson_id', '=', user.id), ('technician_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ms_user'))]"/>
    </record>
    <record id="rule_ms_service_commercial" model="ir.rule">
        <field name="name">Servicios: comercial (todos de la compañía)</field>
        <field name="model_id" ref="model_justech_managed_service"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ms_commercial'))]"/>
    </record>
    <record id="rule_ms_service_technician" model="ir.rule">
        <field name="name">Servicios: técnico (lectura todos; ACL sin escritura)</field>
        <field name="model_id" ref="model_justech_managed_service"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ms_technician'))]"/>
    </record>
    <record id="rule_ms_service_manager" model="ir.rule">
        <field name="name">Servicios: administrador total</field>
        <field name="model_id" ref="model_justech_managed_service"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ms_manager'))]"/>
    </record>
    <record id="rule_ms_service_company" model="ir.rule">
        <field name="name">Servicios: multi-compañía</field>
        <field name="model_id" ref="model_justech_managed_service"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
