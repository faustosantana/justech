<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_justech_managed_services" model="ir.module.category">
        <field name="name">Justech Servicios Administrados</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_justech_managed_services" model="res.groups.privilege">
        <field name="name">Servicios Administrados</field>
        <field name="category_id" ref="module_category_justech_managed_services"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_ms_user" model="res.groups">
        <field name="name">Usuario de Servicios Administrados</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_managed_services"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Crea y gestiona levantamientos asignados.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_ms_manager" model="res.groups">
        <field name="name">Administrador de Servicios Administrados</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_managed_services"/>
        <field name="implied_ids" eval="[(4, ref('group_ms_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Administra todos los levantamientos y puede eliminar borradores.</field>
        <field name="sequence">20</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ms_manager'))]"/>
    </record>

    <record id="rule_ms_assessment_user" model="ir.rule">
        <field name="name">Levantamientos: usuario asignado</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">['|', ('consultant_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ms_user'))]"/>
    </record>

    <record id="rule_ms_assessment_manager" model="ir.rule">
        <field name="name">Levantamientos: administrador total</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ms_manager'))]"/>
    </record>

    <record id="rule_ms_assessment_company" model="ir.rule">
        <field name="name">Levantamientos: multi-compañía</field>
        <field name="model_id" ref="model_justech_managed_service_assessment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
