<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_ms_assessment" model="ir.ui.view">
        <field name="name">crm.lead.form.ms.assessment</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_justech_ms_assessments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-clipboard">
                    <field name="justech_ms_assessment_count" widget="statinfo" string="Levantamientos"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
