<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_form_justech_ms" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.justech.ms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="justech_managed_service_id"
                         groups="justech_managed_services.group_ms_user,justech_managed_services.group_ms_technician"/>
            </xpath>
        </field>
    </record>
</odoo>
