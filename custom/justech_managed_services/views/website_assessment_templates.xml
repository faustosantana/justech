<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assessment_public_error" name="Levantamiento — Error">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <link rel="stylesheet" type="text/css" href="/justech_managed_services/static/src/css/assessment_public.css"/>
            <div class="jt-ms-wrap jt-ms-error-page">
                <img src="/web/binary/company_logo" alt="Justech" class="jt-ms-logo" onerror="this.src='/justech_managed_services/static/description/icon.png'"/>
                <h1>Enlace no disponible</h1>
                <t t-if="error_code == 'invalid'">
                    <p>El enlace que intenta utilizar no es válido. Verifique la URL o solicite un nuevo enlace a su consultor Justech.</p>
                </t>
                <t t-elif="error_code == 'expired'">
                    <p>El plazo para completar este levantamiento ha vencido. Contacte a su consultor Justech para solicitar una extensión o un nuevo enlace.</p>
                </t>
                <t t-elif="error_code == 'inactive'">
                    <p>Este enlace ha sido desactivado. Si necesita acceso, comuníquese con su consultor Justech.</p>
                </t>
                <t t-elif="error_code == 'cancelled'">
                    <p>Este levantamiento fue cancelado y ya no está disponible.</p>
                </t>
                <t t-elif="error_code == 'submitted'">
                    <p>Este levantamiento ya fue enviado. Si requiere realizar cambios, solicite la reapertura a su consultor Justech.</p>
                </t>
                <t t-else="">
                    <p>No es posible acceder al formulario en este momento.</p>
                </t>
            </div>
        </t>
    </template>

