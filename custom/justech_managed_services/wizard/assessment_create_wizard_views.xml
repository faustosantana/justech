<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_ms_assessment_create_wizard" model="ir.ui.view">
        <field name="name">justech.ms.assessment.create.wizard.form</field>
        <field name="model">justech.ms.assessment.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Nuevo levantamiento" class="jt-ms-wizard">
                <field name="step" invisible="1"/>
                <field name="assessment_id" invisible="1"/>
                <div class="jt-ms-wizard-steps mb-3">
                    <span class="badge text-bg-primary" invisible="step != 'client'">1 · Cliente</span>
                    <span class="badge text-bg-secondary" invisible="step == 'client'">1 · Cliente</span>
                    <span class="mx-1">→</span>
                    <span class="badge text-bg-primary" invisible="step != 'questions'">2 · Preguntas</span>
                    <span class="badge text-bg-secondary" invisible="step == 'questions'">2 · Preguntas</span>
                    <span class="mx-1">→</span>
                    <span class="badge text-bg-primary" invisible="step != 'link'">3 · Enlace</span>
                    <span class="badge text-bg-secondary" invisible="step == 'link'">3 · Enlace</span>
                    <span class="mx-1">→</span>
                    <span class="badge text-bg-primary" invisible="step != 'send'">4 · Envío</span>
                    <span class="badge text-bg-secondary" invisible="step == 'send'">4 · Envío</span>
                </div>

                <group invisible="step != 'client'" string="Paso 1 — Selección">
                    <group>
                        <field name="partner_id" options="{'no_create_edit': False}"
                                context="{'default_is_company': True, 'show_vat': True}"/>
                        <field name="contact_id"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <group>
                        <field name="consultant_id" widget="many2one_avatar_user"/>
                        <field name="template_id"/>
                        <field name="title"/>
                        <field name="date_deadline"/>
                    </group>
                </group>

                <group invisible="step != 'questions'" string="Paso 2 — Preguntas y categorías">
                    <div class="alert alert-info" role="alert" colspan="2">
                        Marque las preguntas a incluir. Puede reordenar y definir obligatorias.
                    </div>
                    <field name="line_ids" nolabel="1" colspan="2">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="selected"/>
                            <field name="category_name"/>
                            <field name="question_label"/>
                            <field name="required"/>
                            <field name="visible"/>
                            <field name="question_id" column_invisible="1"/>
                            <field name="category_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>

                <group invisible="step != 'link'" string="Paso 3 — Generar enlace">
                    <div class="alert alert-warning" role="alert" colspan="2">
                        Pulse <strong>Siguiente</strong> para generar el enlace seguro del levantamiento.
                    </div>
                    <field name="assessment_id" readonly="1"/>
                    <field name="public_url" widget="CopyClipboardChar" readonly="1"/>
                </group>

                <group invisible="step != 'send'" string="Paso 4 — Enviar o compartir">
                    <field name="public_url" widget="CopyClipboardChar" readonly="1"/>
                    <field name="invite_subject"/>
                    <field name="invite_body" colspan="2"/>
                </group>

                <footer>
                    <button name="action_back" type="object" string="Atrás"
                            invisible="step == 'client'" class="btn-secondary"/>
                    <button name="action_next" type="object" string="Siguiente"
                            class="btn-primary" invisible="step == 'send'"/>
                    <button name="action_prepare_email" type="object" string="Preparar correo"
                            class="btn-primary" invisible="step != 'send'"/>
                    <button name="action_copy_link" type="object" string="Copiar enlace"
                            invisible="step != 'send'"/>
                    <button name="action_copy_message" type="object" string="Copiar mensaje"
                            invisible="step != 'send'"/>
                    <button name="action_open_assessment" type="object" string="Abrir ficha"
                            class="btn-secondary" invisible="not assessment_id"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_ms_assessment_create_wizard" model="ir.actions.act_window">
        <field name="name">Nuevo levantamiento</field>
        <field name="res_model">justech.ms.assessment.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
