<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- UX-1: tasas bajo Contabilidad → Configuración (estándar Odoo) -->
    <menuitem id="menu_justech_multicurrency_rates"
              name="Tasas de cambio"
              parent="account.menu_finance_configuration"
              action="action_justech_multicurrency_rates"
              sequence="35"
              groups="account.group_account_manager"/>

    <!-- Sin menú superior Justech / Multimoneda para usuarios operativos -->
    <record id="menu_justech_platform_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_justech_multicurrency_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_justech_multicurrency_dashboard" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Política comercial: solo administración interna (reparent en hook/menu customizer) -->
    <menuitem id="menu_justech_multicurrency_policy"
              name="Configuración comercial"
              parent="base.menu_administration"
              action="action_justech_multicurrency_policy"
              sequence="96"
              groups="base.group_system,base.group_erp_manager"/>
</odoo>
