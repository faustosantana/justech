<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_multicurrency_policy_list" model="ir.ui.view">
        <field name="name">justech.multicurrency.policy.list</field>
        <field name="model">justech.multicurrency.policy</field>
        <field name="arch" type="xml">
            <list string="Política Multimoneda">
                <field name="company_id"/>
                <field name="commercial_currency_id"/>
                <field name="accounting_currency_id"/>
                <field name="default_pricelist_id"/>
                <field name="pricelist_count"/>
            </list>
        </field>
    </record>

    <record id="view_justech_multicurrency_policy_form" model="ir.ui.view">
        <field name="name">justech.multicurrency.policy.form</field>
        <field name="model">justech.multicurrency.policy</field>
        <field name="arch" type="xml">
            <form string="Configuración comercial">
                <header>
                    <button name="action_open_dashboard" type="object" string="Ver dashboard" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="company_id" options="{'no_create': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Monedas">
                            <field name="accounting_currency_id"/>
                            <field name="commercial_currency_id"/>
                        </group>
                        <group string="Defaults comerciales">
                            <field name="default_pricelist_id"/>
                            <field name="default_customer_currency_id"/>
                            <field name="default_supplier_currency_id"/>
                            <field name="default_product_pricelist_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notas internas de política comercial..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_multicurrency_policy" model="ir.actions.act_window">
        <field name="name">Configuración comercial</field>
        <field name="res_model">justech.multicurrency.policy</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_company_id': allowed_company_ids[0] if allowed_company_ids else False}</field>
    </record>
</odoo>
