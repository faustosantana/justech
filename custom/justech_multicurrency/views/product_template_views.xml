<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_justech_commercial" model="ir.ui.view">
        <field name="name">product.template.form.justech.commercial</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="before">
                <group string="Precio comercial Justech" name="justech_commercial_pricing">
                    <group>
                        <field name="justech_sale_price"/>
                        <field name="justech_sale_currency_id" options="{'no_create': True}"/>
                        <field name="justech_accounting_sale_price" readonly="1"
                               string="Equivalente contable (venta)"/>
                    </group>
                    <group>
                        <field name="justech_purchase_price"/>
                        <field name="justech_purchase_currency_id" options="{'no_create': True}"/>
                        <field name="justech_accounting_purchase_price" readonly="1"
                               string="Equivalente contable (compra)"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Restricción adicional de menús vía post_init_hook para IDs variables de sale -->
</odoo>
