<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_justech_fee" model="ir.ui.view">
        <field name="name">account.move.form.justech.fee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="justech_fee_id" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="justech_fee_period_from" readonly="1"
                       invisible="not justech_fee_id"/>
                <field name="justech_fee_period_to" readonly="1"
                       invisible="not justech_fee_id"/>
                <field name="justech_fee_cycle_number" readonly="1"
                       invisible="not justech_fee_id"/>
            </xpath>
        </field>
    </record>
</odoo>
