<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_recurring_fee_reactivate_wizard" model="ir.ui.view">
        <field name="name">justech.recurring.fee.reactivate.wizard.form</field>
        <field name="model">justech.recurring.fee.reactivate.wizard</field>
        <field name="arch" type="xml">
            <form string="Reactivar fee">
                <group>
                    <field name="fee_id" readonly="1"/>
                    <field name="keep_next_date"/>
                    <field name="next_generation_date"
                           invisible="keep_next_date"
                           required="not keep_next_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reactivar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
