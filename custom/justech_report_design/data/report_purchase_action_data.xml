<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_hellenia_purchase_order" model="report.paperformat">
        <field name="name">Justech Orden de Compra</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Definición base del reporte Justech (menú oficial vía purchase.action_report_purchase_order) -->
    <record id="action_report_justech_purchase_order" model="ir.actions.report">
        <field name="name">Orden de Compra Hellenia</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">justech_report_design.report_justech_purchase_order_document</field>
        <field name="report_file">justech_report_design.report_justech_purchase_order_document</field>
        <field name="print_report_name">'Orden de Compra - %s' % (object.name)</field>
        <field name="paperformat_id" ref="justech_report_design.paperformat_hellenia_purchase_order"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
