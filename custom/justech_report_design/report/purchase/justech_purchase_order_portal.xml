<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista previa nativa: iframe reporte Hellenia + sidebar descargar/imprimir -->
    <template id="portal_my_purchase_order_jt_preview"
              inherit_id="purchase.portal_my_purchase_order"
              name="Purchase Order Portal — Justech preview">

        <t t-call="portal.portal_layout" position="inside">
            <t t-if="jt_report_preview">
                <t t-set="o_portal_fullwidth_alert" groups="purchase.group_purchase_manager">
                    <t t-call="portal.portal_back_in_edit_mode">
                        <t t-set="backend_url" t-value="'/odoo/action-purchase.purchase_rfq/%s' % (order.id)"/>
                    </t>
                </t>
            </t>
        </t>

        <xpath expr="//div[@id='portal_purchase_content']" position="replace">
            <t t-if="jt_report_preview">
                <div class="o_portal_html_view position-relative bg-white shadow overflow-hidden">
                    <div class="o_portal_html_loader text-center">
                        <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>
                    </div>
                    <iframe id="purchase_order_html"
                            class="position-relative d-block"
                            width="100%"
                            height="100%"
                            frameborder="0"
                            scrolling="no"
                            t-att-src="jt_report_html_url"/>
                </div>
            </t>
            <t t-else="">
                <div>
                    <t t-call="purchase.purchase_order_portal_content"/>
                </div>
            </t>
        </xpath>

        <xpath expr="//a[@id='print_invoice_report']" position="replace">
            <t t-if="jt_report_preview">
                <div class="d-flex flex-column gap-2">
                    <a class="btn btn-light o_download_btn flex-grow-1"
                       t-att-href="jt_report_pdf_download_url"
                       title="Descargar"
                       role="button">
                        <i class="fa fa-download"/> Descargar
                    </a>
                    <a class="btn btn-secondary o_portal_po_print flex-grow-1"
                       t-att-href="jt_report_pdf_url"
                       title="Imprimir"
                       role="button">
                        <i class="fa fa-print"/> Imprimir
                    </a>
                </div>
            </t>
            <t t-else="">
                <a class="btn btn-secondary o_print_btn o_portal_invoice_print"
                   t-att-href="order.get_portal_url(report_type='pdf')"
                   id="print_invoice_report"
                   title="View Details"
                   role="button"
                   target="_blank">
                    <i class="fa fa-print me-1"/>Download / Print
                </a>
            </t>
        </xpath>

        <xpath expr="//div[@id='purchase_order_communication']" position="attributes">
            <attribute name="t-if">not jt_report_preview</attribute>
        </xpath>

    </template>

</odoo>
