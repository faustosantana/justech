<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Página portal dedicada — vista previa nativa OC Hellenia -->
    <template id="justech_purchase_order_portal_preview_page" name="Purchase Order Hellenia Preview">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url" t-value="'/odoo/action-purchase.purchase_rfq/%s' % (order.id)"/>
                </t>
            </t>

            <div class="row o_portal_purchase_sidebar o_portal_purchase_preview">
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>
                    <t t-set="title">
                        <h2 t-field="order.amount_total" class="mb-0 text-break"/>
                    </t>
                    <t t-set="entries">
                        <div class="d-flex flex-column gap-4 mt-3">
                            <div class="d-flex flex-column gap-2">
                                <a class="btn btn-light o_download_btn flex-grow-1"
                                   t-att-href="jt_report_pdf_download_url"
                                   title="Descargar"
                                   role="button">
                                    <i class="fa fa-download"/> Descargar
                                </a>
                                <a class="btn btn-secondary o_portal_po_print flex-grow-1"
                                   t-att-href="jt_report_pdf_url"
                                   title="Imprimir"
                                   role="button">
                                    <i class="fa fa-print"/> Imprimir
                                </a>
                            </div>
                        </div>
                    </t>
                </t>

                <div id="purchase_order_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div class="o_portal_html_view position-relative bg-white shadow overflow-hidden">
                        <div class="o_portal_html_loader text-center">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/>
                        </div>
                        <iframe id="purchase_order_html"
                                class="position-relative d-block"
                                width="100%"
                                height="100%"
                                frameborder="0"
                                scrolling="no"
                                t-att-src="jt_report_html_url"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
