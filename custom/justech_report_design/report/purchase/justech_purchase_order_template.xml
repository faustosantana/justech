<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="justech_purchase_order_body">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="vendor" t-value="doc.get_jt_po_vendor_partner()"/>
        <t t-set="lines_to_report" t-value="doc._jt_po_reportable_lines()"/>
        <t t-set="has_discount" t-value="doc.get_jt_po_has_discount()"/>
        <t t-set="show_discount_totals" t-value="doc.get_jt_po_show_discount_totals()"/>
        <t t-set="addr_lines" t-value="doc.get_jt_partner_address_lines(vendor)"/>

        <div class="jt-hq-hdr">
            <div class="jt-hq-hdr-logo">
                <img t-if="company.logo" class="jt-hq-logo"
                     t-att-src="image_data_uri(company.logo)" alt="Hellenia"/>
            </div>
            <div class="jt-hq-co">
                <div class="jt-hq-co-name"><span t-field="company.name"/></div>
                <div t-if="company.street">
                    <span t-field="company.street"/>
                    <t t-if="company.city">, <span t-field="company.city"/></t>
                </div>
                <div t-if="company.vat">
                    <span class="jt-hq-co-lbl">RNC: </span><span t-field="company.vat"/>
                </div>
                <div t-if="company.phone">
                    <span class="jt-hq-co-lbl">Tel.: </span><span t-field="company.phone"/>
                </div>
                <div t-if="company.email">
                    <span class="jt-hq-co-lbl">Correo: </span><span t-field="company.email"/>
                </div>
                <div t-if="company.website">
                    <span class="jt-hq-co-lbl">Web: </span><span t-field="company.website"/>
                </div>
            </div>
        </div>

        <div class="jt-po-band">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" class="jt-po-band-layout">
                <tr>
                    <td width="34%" valign="middle" class="jt-po-band-title-cell">
                        <span class="jt-po-band-title">ORDEN DE COMPRA</span>
                    </td>
                    <td width="66%" valign="top" class="jt-po-band-meta-cell">
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" class="jt-po-band-cols">
                            <tr>
                                <td width="50%" valign="top" class="jt-po-band-col">
                                    <div class="jt-po-meta-row">
                                        <span class="jt-po-label">No. Orden:</span>
                                        <span class="jt-po-val" t-field="doc.name"/>
                                    </div>
                                    <div class="jt-po-meta-row">
                                        <span class="jt-po-label">Estado:</span>
                                        <span class="jt-po-val" t-out="doc.get_jt_po_state_display()"/>
                                    </div>
                                    <div class="jt-po-meta-row">
                                        <span class="jt-po-label">Comprador:</span>
                                        <span class="jt-po-val" t-out="doc.get_jt_po_buyer_display()"/>
                                    </div>
                                </td>
                                <td width="50%" valign="top" class="jt-po-band-col jt-po-band-col-r">
                                    <div class="jt-po-meta-row">
                                        <span class="jt-po-label">Moneda:</span>
                                        <span class="jt-po-val" t-out="doc.get_jt_po_currency_display()"/>
                                    </div>
                                    <div class="jt-po-meta-row">
                                        <span class="jt-po-label">Fecha de Orden:</span>
                                        <span class="jt-po-val" t-out="doc.get_jt_po_order_date_display()"/>
                                    </div>
                                    <div class="jt-po-meta-row">
                                        <span class="jt-po-label">Fecha Esperada:</span>
                                        <span class="jt-po-val" t-out="doc.get_jt_po_expected_date_display()"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>

        <hr class="jt-hq-line-soft"/>

        <table width="100%" cellpadding="0" cellspacing="0" class="jt-hq-cards">
            <tr>
                <td width="49%" class="jt-hq-card">
                    <div class="jt-hq-card-title">Información del Proveedor</div>
                    <div class="jt-hq-meta-row">
                        <span class="jt-hq-lbl">Nombre</span>
                        <span class="jt-hq-val"><span t-field="vendor.name"/></span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="vendor.vat">
                        <span class="jt-hq-lbl">RNC</span>
                        <span class="jt-hq-val"><span t-field="vendor.vat"/></span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="addr_lines">
                        <span class="jt-hq-lbl">Dirección</span>
                        <span class="jt-hq-val">
                            <t t-foreach="addr_lines" t-as="addr_line">
                                <div t-out="addr_line"/>
                            </t>
                        </span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="vendor.phone">
                        <span class="jt-hq-lbl">Teléfono</span>
                        <span class="jt-hq-val"><span t-field="vendor.phone"/></span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="vendor.email">
                        <span class="jt-hq-lbl">Correo</span>
                        <span class="jt-hq-val"><span t-field="vendor.email"/></span>
                    </div>
                </td>
                <td class="jt-hq-vdiv">&#160;</td>
                <td width="49%" class="jt-hq-card jt-hq-card-r">
                    <div class="jt-hq-card-title">Información de Compra</div>
                    <div class="jt-hq-meta-row">
                        <span class="jt-hq-lbl">Comprador</span>
                        <span class="jt-hq-val" t-out="doc.get_jt_po_buyer_display()"/>
                    </div>
                    <div class="jt-hq-meta-row">
                        <span class="jt-hq-lbl">Condiciones de pago</span>
                        <span class="jt-hq-val" t-out="doc.get_jt_payment_term_display()"/>
                    </div>
                    <div class="jt-hq-meta-row" t-if="doc.incoterm_id">
                        <span class="jt-hq-lbl">Incoterm</span>
                        <span class="jt-hq-val" t-out="doc.get_jt_po_incoterm_display()"/>
                    </div>
                    <div class="jt-hq-meta-row" t-if="doc.partner_ref">
                        <span class="jt-hq-lbl">Ref. proveedor</span>
                        <span class="jt-hq-val"><span t-field="doc.partner_ref"/></span>
                    </div>
                </td>
            </tr>
        </table>

        <table class="jt-hq-items jt-po-items" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th class="c-num">#</th>
                    <th class="c-code">CÓDIGO</th>
                    <th>DESCRIPCIÓN</th>
                    <th class="c-qty">CANTIDAD</th>
                    <th class="c-uom">UNIDAD</th>
                    <th class="c-price">P. UNITARIO</th>
                    <th t-if="has_discount" class="c-disc">DESCUENTO</th>
                    <th class="c-tax">IMPUESTO</th>
                    <th class="c-sub">SUBTOTAL</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="n" t-value="0"/>
                <t t-foreach="lines_to_report" t-as="line">
                    <t t-set="n" t-value="n + 1"/>
                    <tr>
                        <td class="c-num"><span t-out="n"/></td>
                        <td class="c-code">
                            <span t-out="line.product_id.default_code or '—'"/>
                        </td>
                        <td><span t-field="line.name"/></td>
                        <td class="c-qty"><span t-field="line.product_qty"/></td>
                        <td class="c-uom">
                            <span t-field="line.product_uom_id" t-if="line.product_uom_id"/>
                            <t t-else="">—</t>
                        </td>
                        <td class="c-price">
                            <span t-field="line.price_unit"
                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </td>
                        <td t-if="has_discount" class="c-disc">
                            <t t-if="(line.discount or 0) > 0">
                                <span t-out="doc.format_jt_discount_percent(line.discount)"/>
                            </t>
                            <t t-else="">—</t>
                        </td>
                        <td class="c-tax">
                            <span t-out="doc.get_jt_line_tax_display(line)"/>
                        </td>
                        <td class="c-sub">
                            <span t-field="line.price_subtotal"
                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

        <div class="jt-hq-totals-wrap">
            <table width="280" cellpadding="0" cellspacing="0" border="0" class="jt-hq-totals">
                <t t-if="show_discount_totals">
                    <tr>
                        <td class="t-lbl">Subtotal bruto</td>
                        <td class="t-val">
                            <span t-out="doc.format_jt_monetary(doc.get_jt_po_gross_subtotal())"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="t-lbl">Descuento</td>
                        <td class="t-val">
                            <span t-out="doc.format_jt_monetary(doc.get_jt_po_discount_total())"/>
                        </td>
                    </tr>
                </t>
                <tr>
                    <td class="t-lbl">Subtotal</td>
                    <td class="t-val">
                        <span t-field="doc.amount_untaxed"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="t-lbl">Impuestos</td>
                    <td class="t-val">
                        <span t-field="doc.amount_tax"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr class="grand">
                    <td class="t-lbl">TOTAL</td>
                    <td class="t-val">
                        <span t-field="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
            </table>
        </div>

        <div class="jt-hq-clear"/>

        <div class="jt-hq-cond" t-if="doc.jt_show_po_observations()">
            <div class="jt-hq-cond-title">OBSERVACIONES</div>
            <div class="jt-hq-cond-body" t-field="doc.note"/>
        </div>

        <div class="jt-hq-sigs-zone">
            <div class="jt-hq-sig-grow">&#160;</div>
            <div class="jt-hq-sigs jt-po-sigs">
                <div class="jt-hq-sig-col">
                    <div class="jt-hq-sig-head">ENTREGADO POR</div>
                    <hr class="jt-hq-sig-line"/>
                    <div class="jt-hq-sig-date-lbl">Fecha:</div>
                    <hr class="jt-hq-sig-line jt-hq-sig-line-date"/>
                </div>
                <div class="jt-hq-sig-col">
                    <div class="jt-hq-sig-head">AUTORIZADO POR</div>
                    <hr class="jt-hq-sig-line"/>
                    <div class="jt-hq-sig-date-lbl">Fecha:</div>
                    <hr class="jt-hq-sig-line jt-hq-sig-line-date"/>
                </div>
                <div class="jt-hq-sig-col">
                    <div class="jt-hq-sig-head">PROVEEDOR</div>
                    <hr class="jt-hq-sig-line"/>
                    <div class="jt-hq-sig-date-lbl">Fecha:</div>
                    <hr class="jt-hq-sig-line jt-hq-sig-line-date"/>
                </div>
            </div>
        </div>
    </template>

    <template id="report_justech_purchase_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-set="company" t-value="doc.company_id"/>
                <div class="article page jt-hq-page jt-po-page"
                     style="border: none !important; border-top: none !important;"
                     t-att-data-oe-model="doc._name"
                     t-att-data-oe-id="doc.id"
                     t-att-data-oe-lang="doc.env.context.get('lang')">
                    <t t-call="justech_report_design.justech_purchase_order_body"/>
                </div>
                <div class="footer jt-hq-footer-pdf">
                    <div class="jt-hq-foot-row">
                        <t t-if="company.phone"><span class="jt-hq-foot-item" t-field="company.phone"/></t>
                        <t t-if="company.email">
                            <span class="jt-hq-foot-sep">|</span>
                            <span class="jt-hq-foot-item" t-field="company.email"/>
                        </t>
                        <t t-if="company.website">
                            <span class="jt-hq-foot-sep">|</span>
                            <span class="jt-hq-foot-item" t-field="company.website"/>
                        </t>
                        <span class="jt-hq-foot-sep">|</span>
                        <span class="jt-hq-foot-item jt-hq-foot-page">
                            Página <span class="page"></span> de <span class="topage"></span>
                        </span>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
