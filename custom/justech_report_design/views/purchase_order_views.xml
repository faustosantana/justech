<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_jt_po_report" model="ir.ui.view">
        <field name="name">purchase.order.form.jt.po.report</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_jt_print_purchase_order"
                        type="object"
                        string="Orden de Compra PDF"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>

</odoo>
