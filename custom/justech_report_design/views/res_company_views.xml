<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_jt_quotation_terms" model="ir.ui.view">
        <field name="name">res.company.form.jt.quotation.terms</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Cotizaciones PDF" name="jt_quotation_terms_group">
                    <field name="jt_quotation_terms" colspan="2" nolabel="1"
                           placeholder="Condiciones copiadas automáticamente a cada cotización nueva."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
