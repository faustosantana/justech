<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_jt_delivery_conduce" model="ir.ui.view">
        <field name="name">sale.order.form.jt.delivery.conduce</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_jt_print_delivery_conduce"
                        type="object"
                        string="Conduce de Entrega"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_jt_view_delivery_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="state == 'cancel'">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="jt_delivery_picking_count" readonly="1" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">
                            <field name="jt_delivery_stat_label" readonly="1" nolabel="1"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
