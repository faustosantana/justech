<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_jt_quotation_terms" model="ir.ui.view">
        <field name="name">sale.order.form.jt.quotation.terms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="attributes">
                <attribute name="string">Condiciones (PDF Cotización)</attribute>
                <attribute name="placeholder">Términos y condiciones que aparecerán en el PDF de cotización Hellenia. Si se deja vacío, se usan las condiciones por defecto.</attribute>
            </xpath>
        </field>
    </record>
</odoo>
