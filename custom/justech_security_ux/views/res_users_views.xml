<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_operational_permissions" model="ir.ui.view">
        <field name="name">res.users.form.justech.enterprise.permissions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="attributes">
                <attribute name="string">Permisos Avanzados</attribute>
                <attribute name="groups">base.group_system</attribute>
            </xpath>
            <xpath expr="//page[@name='access_rights']" position="inside">
                <div class="alert alert-warning justech-ent-advanced-warning mb-3" role="alert"
                     groups="base.group_system">
                    <strong>PERMISOS AVANZADOS</strong>
                    <p class="mb-0">
                        Grupos técnicos de Odoo. Configure usuarios normalmente desde «Permisos Justech».
                    </p>
                </div>
            </xpath>

            <xpath expr="//page[@name='access_rights']" position="before">
                <page string="Permisos Justech" name="justech_enterprise_permissions"
                      groups="base.group_system,justech_admin_center.group_justech_admin_center_manager">
                    <div class="alert alert-info justech-ent-banner" role="note">
                        <field name="op_enterprise_help" nolabel="1" readonly="1"/>
                    </div>

                    <separator string="ÁREAS DE RESPONSABILIDAD (selección múltiple)"/>
                    <group col="4" class="justech-ent-area-chips">
                        <field name="op_area_commercial" widget="boolean"/>
                        <field name="op_area_purchase" widget="boolean"/>
                        <field name="op_area_inventory" widget="boolean"/>
                        <field name="op_area_finance" widget="boolean"/>
                        <field name="op_area_accounting" widget="boolean"/>
                        <field name="op_area_fiscal" widget="boolean"/>
                        <field name="op_area_ecf" widget="boolean"/>
                        <field name="op_area_warranty" widget="boolean"/>
                        <field name="op_area_hr" widget="boolean"/>
                        <field name="op_area_crm" widget="boolean"/>
                        <field name="op_area_admin" widget="boolean"/>
                    </group>
                    <!-- open flags technical -->
                    <group invisible="1">
                        <field name="op_area_open_commercial"/>
                        <field name="op_area_open_purchase"/>
                        <field name="op_area_open_inventory"/>
                        <field name="op_area_open_finance"/>
                        <field name="op_area_open_accounting"/>
                        <field name="op_area_open_fiscal"/>
                        <field name="op_area_open_ecf"/>
                        <field name="op_area_open_warranty"/>
                        <field name="op_area_open_hr"/>
                        <field name="op_area_open_crm"/>
                        <field name="op_area_open_admin"/>
                    </group>

                    <!-- COMERCIAL -->
                    <div invisible="not op_area_commercial" class="justech-ent-panel">
                        <separator string="✓ COMERCIAL"/>
                        <group col="2">
                            <field name="op_role_commercial" widget="radio" string="Rol"/>
                            <field name="op_role_card_commercial" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                        <separator string="Permisos Comercial"/>
                        <group col="2">
                            <field name="op_act_so_quote"/>
                            <field name="op_act_so_approve"/>
                            <field name="op_act_so_confirm"/>
                            <field name="op_act_so_invoice"/>
                            <field name="op_act_so_credit"/>
                            <field name="op_act_so_discount"/>
                            <field name="op_act_so_delete_inv"/>
                            <field name="op_act_so_edit_posted"/>
                        </group>
                    </div>

                    <!-- COMPRAS -->
                    <div invisible="not op_area_purchase" class="justech-ent-panel">
                        <separator string="✓ COMPRAS"/>
                        <group col="2">
                            <field name="op_role_purchase" widget="radio" string="Rol"/>
                            <field name="op_role_card_purchase" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                        <separator string="Permisos Compras"/>
                        <group col="2">
                            <field name="op_act_po_request"/>
                            <field name="op_act_po_approve_req"/>
                            <field name="op_act_po_order"/>
                            <field name="op_act_po_approve_order"/>
                            <field name="op_act_po_vendor_bill"/>
                            <field name="op_act_po_received"/>
                            <field name="op_act_po_b11"/>
                            <field name="op_act_po_b13"/>
                            <field name="op_act_po_b17"/>
                            <field name="op_act_po_cancel"/>
                            <field name="op_act_po_delete"/>
                        </group>
                    </div>

                    <!-- INVENTARIO -->
                    <div invisible="not op_area_inventory" class="justech-ent-panel">
                        <separator string="✓ INVENTARIO"/>
                        <group col="2">
                            <field name="op_role_inventory" widget="radio" string="Rol"/>
                            <field name="op_role_card_inventory" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                        <separator string="Permisos Inventario"/>
                        <group col="2">
                            <field name="op_act_stk_in"/>
                            <field name="op_act_stk_out"/>
                            <field name="op_act_stk_adj"/>
                            <field name="op_act_stk_tr"/>
                            <field name="op_act_stk_count"/>
                            <field name="op_act_stk_val"/>
                        </group>
                    </div>

                    <!-- FINANZAS -->
                    <div invisible="not op_area_finance" class="justech-ent-panel">
                        <separator string="✓ FINANZAS"/>
                        <group col="2">
                            <field name="op_role_finance" widget="radio" string="Rol"/>
                            <field name="op_role_card_finance" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                        <separator string="Permisos Finanzas"/>
                        <group col="2">
                            <field name="op_act_fin_register_in"/>
                            <field name="op_act_fin_register_out"/>
                            <field name="op_act_fin_apply"/>
                            <field name="op_act_fin_reconcile"/>
                            <field name="op_act_fin_unreconcile"/>
                            <field name="op_act_fin_approve"/>
                            <field name="op_act_fin_bank_create"/>
                            <field name="op_act_fin_bank_edit"/>
                            <field name="op_act_fin_export"/>
                            <field name="op_act_fin_reports"/>
                        </group>
                    </div>

                    <!-- CONTABILIDAD -->
                    <div invisible="not op_area_accounting" class="justech-ent-panel">
                        <separator string="✓ CONTABILIDAD"/>
                        <group col="2">
                            <field name="op_role_accounting" widget="radio" string="Rol"/>
                            <field name="op_role_card_accounting" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                    </div>

                    <!-- FISCAL -->
                    <div invisible="not op_area_fiscal" class="justech-ent-panel">
                        <separator string="✓ FISCAL"/>
                        <group col="2">
                            <field name="op_role_fiscal" widget="radio" string="Rol"/>
                            <field name="op_role_card_fiscal" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                        <separator string="Permisos Fiscal"/>
                        <group col="2">
                            <field name="op_act_fis_void"/>
                            <field name="op_act_fis_606"/>
                            <field name="op_act_fis_607"/>
                            <field name="op_act_fis_608"/>
                            <field name="op_act_fis_ranges"/>
                        </group>
                    </div>

                    <!-- e-CF -->
                    <div invisible="not op_area_ecf" class="justech-ent-panel">
                        <separator string="✓ e-CF"/>
                        <group col="2">
                            <field name="op_role_ecf" widget="radio" string="Rol"/>
                            <field name="op_role_card_ecf" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                    </div>

                    <!-- GARANTÍAS -->
                    <div invisible="not op_area_warranty" class="justech-ent-panel">
                        <separator string="✓ GARANTÍAS"/>
                        <group col="2">
                            <field name="op_role_warranty" widget="radio" string="Rol"/>
                            <field name="op_role_card_warranty" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                        <separator string="Permisos Garantías"/>
                        <group col="2">
                            <field name="op_act_war_create"/>
                            <field name="op_act_war_edit"/>
                            <field name="op_act_war_process"/>
                            <field name="op_act_war_history"/>
                        </group>
                    </div>

                    <!-- RRHH -->
                    <div invisible="not op_area_hr" class="justech-ent-panel">
                        <separator string="✓ RECURSOS HUMANOS"/>
                        <group col="2">
                            <field name="op_role_hr" widget="radio" string="Rol"/>
                            <field name="op_role_card_hr" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                    </div>

                    <!-- CRM -->
                    <div invisible="not op_area_crm" class="justech-ent-panel">
                        <separator string="✓ CRM"/>
                        <group col="2">
                            <field name="op_role_crm" widget="radio" string="Rol"/>
                            <field name="op_role_card_crm" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                    </div>

                    <!-- ADMIN -->
                    <div invisible="not op_area_admin" class="justech-ent-panel">
                        <separator string="✓ ADMINISTRACIÓN JUSTECH"/>
                        <group col="2">
                            <field name="op_role_admin" widget="radio" string="Rol"/>
                            <field name="op_role_card_admin" nolabel="1" readonly="1" class="justech-ent-role-card"/>
                        </group>
                    </div>

                    <separator string="RESUMEN GENERAL"/>
                    <group col="1">
                        <group string="Áreas activas">
                            <field name="op_summary_areas" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Puede">
                            <field name="op_summary_can" nolabel="1" readonly="1"/>
                        </group>
                        <group string="No puede">
                            <field name="op_summary_cannot" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_hide_duplicate_justech_role_blocks" model="ir.ui.view">
        <field name="name">res.users.form.hide.duplicate.justech.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="justech_admin_center.view_res_users_form_justech_admin_center"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='justech_admin_center_perms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
