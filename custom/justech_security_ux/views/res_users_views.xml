<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Permisos Operativos: capa UX sobre res.groups.
      No modifica ACL / ir.rule / grupos.
    -->
    <record id="view_users_form_operational_permissions" model="ir.ui.view">
        <field name="name">res.users.form.justech.operational.permissions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <!-- Renombrar pestaña técnica estándar -->
            <xpath expr="//page[@name='access_rights']" position="attributes">
                <attribute name="string">Permisos de acceso (Avanzado)</attribute>
            </xpath>

            <xpath expr="//page[@name='access_rights']" position="before">
                <page string="Permisos Operativos" name="justech_operational_permissions"
                      groups="base.group_system,justech_admin_center.group_justech_admin_center_manager">
                    <div class="alert alert-info justech-op-perm-banner" role="note">
                        <field name="op_perm_help" nolabel="1" readonly="1"/>
                    </div>

                    <separator string="CONTABILIDAD"/>
                    <group col="2">
                        <field name="op_perm_acc_view"/>
                        <field name="op_perm_acc_create"/>
                        <field name="op_perm_acc_post"/>
                        <field name="op_perm_acc_cancel"/>
                        <field name="op_perm_acc_delete_draft"/>
                    </group>

                    <separator string="PAGOS"/>
                    <group col="2">
                        <field name="op_perm_pay_view"/>
                        <field name="op_perm_pay_register"/>
                        <field name="op_perm_pay_apply"/>
                        <field name="op_perm_pay_reconcile"/>
                        <field name="op_perm_pay_unreconcile"/>
                        <field name="op_perm_pay_cancel"/>
                        <field name="op_perm_pay_delete"/>
                        <field name="op_perm_pay_bank_admin"/>
                    </group>

                    <separator string="FACTURACIÓN"/>
                    <group col="2">
                        <field name="op_perm_inv_view"/>
                        <field name="op_perm_inv_create"/>
                        <field name="op_perm_inv_edit_draft"/>
                        <field name="op_perm_inv_post"/>
                        <field name="op_perm_inv_cancel"/>
                        <field name="op_perm_inv_credit_note"/>
                    </group>

                    <separator string="COMPRAS"/>
                    <group col="2">
                        <field name="op_perm_po_create"/>
                        <field name="op_perm_po_approve"/>
                        <field name="op_perm_po_confirm"/>
                        <field name="op_perm_po_bill"/>
                        <field name="op_perm_po_received"/>
                        <field name="op_perm_po_issued"/>
                    </group>

                    <separator string="FISCAL"/>
                    <group col="2">
                        <field name="op_perm_fis_rnc"/>
                        <field name="op_perm_fis_docs"/>
                        <field name="op_perm_fis_void_ncf"/>
                        <field name="op_perm_fis_606"/>
                        <field name="op_perm_fis_607"/>
                        <field name="op_perm_fis_608"/>
                        <field name="op_perm_fis_ranges"/>
                        <field name="op_perm_fis_ecf"/>
                    </group>

                    <separator string="RETENCIONES"/>
                    <group col="2">
                        <field name="op_perm_wh_register"/>
                        <field name="op_perm_wh_apply"/>
                        <field name="op_perm_wh_approve"/>
                        <field name="op_perm_wh_admin"/>
                    </group>

                    <separator string="GARANTÍAS"/>
                    <group col="2">
                        <field name="op_perm_war_create"/>
                        <field name="op_perm_war_edit"/>
                        <field name="op_perm_war_approve"/>
                        <field name="op_perm_war_admin"/>
                    </group>

                    <separator string="RESUMEN DE PERMISOS"/>
                    <group col="2">
                        <group string="Puede">
                            <field name="op_perm_summary_can" nolabel="1" readonly="1"
                                   widget="text" class="justech-op-perm-summary-can"/>
                        </group>
                        <group string="No puede">
                            <field name="op_perm_summary_cannot" nolabel="1" readonly="1"
                                   widget="text" class="justech-op-perm-summary-cannot"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Aviso en pestaña avanzada -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <div class="alert alert-warning justech-op-perm-advanced-warning mb-3" role="alert"
                     groups="base.group_system,justech_admin_center.group_justech_admin_center_manager">
                    Esta sección contiene los grupos técnicos de Odoo.
                    Normalmente los permisos deben administrarse desde «Permisos Operativos».
                </div>
            </xpath>
        </field>
    </record>

    <!-- Evitar dos UI de roles en Avanzado: dejar la operativa como principal -->
    <record id="view_users_form_hide_duplicate_justech_role_blocks" model="ir.ui.view">
        <field name="name">res.users.form.hide.duplicate.justech.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="justech_admin_center.view_res_users_form_justech_admin_center"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='justech_admin_center_perms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
