<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_operational_permissions" model="ir.ui.view">
        <field name="name">res.users.form.justech.permissions.modules</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="attributes">
                <attribute name="string">Permisos Avanzados</attribute>
                <attribute name="groups">base.group_system</attribute>
            </xpath>
            <xpath expr="//page[@name='access_rights']" position="inside">
                <div class="alert alert-warning justech-jx-advanced-warning mb-3" role="alert"
                     groups="base.group_system">
                    <strong>Configuración técnica.</strong>
                    <p class="mb-0">
                        Para la operación normal utilice «Permisos Justech».
                        Esta matriz modifica grupos Odoo directamente.
                    </p>
                </div>
            </xpath>

            <xpath expr="//page[@name='access_rights']" position="before">
                <page string="Permisos Justech" name="justech_enterprise_permissions"
                      groups="base.group_system,justech_admin_center.group_justech_admin_center_manager">
                    <div class="alert alert-info justech-jx-banner" role="note">
                        <field name="jx_help" nolabel="1" readonly="1"/>
                    </div>

                    <!-- visibility helpers -->
                    <group invisible="1">
                        <field name="jx_show_sales"/>
                        <field name="jx_show_purchase"/>
                        <field name="jx_show_inventory"/>
                        <field name="jx_show_accounting"/>
                        <field name="jx_show_fiscal"/>
                        <field name="jx_show_payments"/>
                        <field name="jx_show_withholding"/>
                        <field name="jx_show_ecf"/>
                        <field name="jx_show_warranty"/>
                        <field name="jx_show_fees"/>
                        <field name="jx_show_crm"/>
                        <field name="jx_show_hr"/>
                        <field name="jx_show_admin"/>
                    </group>

                    <!-- VENTAS -->
                    <group string="1. Ventas" invisible="not jx_show_sales" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_sales" widget="radio"/>
                            <field name="jx_card_sales" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                        <group string="Capacidades adicionales" col="2">
                            <field name="jx_cap_so_discount"/>
                            <field name="jx_cap_so_credit_note"/>
                            <field name="jx_cap_so_cancel_fiscal"/>
                        </group>
                    </group>

                    <!-- COMPRAS -->
                    <group string="2. Compras" invisible="not jx_show_purchase" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_purchase" widget="radio"/>
                            <field name="jx_card_purchase" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- INVENTARIO -->
                    <group string="3. Inventario" invisible="not jx_show_inventory" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_inventory" widget="radio"/>
                            <field name="jx_card_inventory" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                        <group string="Capacidades adicionales" col="2">
                            <field name="jx_cap_stk_lots"/>
                        </group>
                    </group>

                    <!-- CONTABILIDAD -->
                    <group string="4. Contabilidad" invisible="not jx_show_accounting" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_accounting" widget="radio"/>
                            <field name="jx_card_accounting" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- FISCAL -->
                    <group string="5. Fiscal República Dominicana" invisible="not jx_show_fiscal" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_fiscal" widget="radio"/>
                            <field name="jx_card_fiscal" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- PAGOS -->
                    <group string="6. Pagos y Bancos" invisible="not jx_show_payments" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_card_payments" nolabel="1" readonly="1" colspan="2" class="justech-jx-card"/>
                            <field name="jx_cap_pay_invoice_access"/>
                            <field name="jx_cap_pay_bank_validate"/>
                        </group>
                    </group>

                    <!-- RETENCIONES -->
                    <group string="7. Retenciones" invisible="not jx_show_withholding" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_withholding" widget="radio"/>
                            <field name="jx_card_withholding" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- e-CF -->
                    <group string="8. e-CF" invisible="not jx_show_ecf" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_ecf" widget="radio"/>
                            <field name="jx_card_ecf" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                        <group string="Capacidades adicionales" col="2">
                            <field name="jx_cap_ecf_auditor"/>
                        </group>
                    </group>

                    <!-- GARANTÍAS -->
                    <group string="9. Garantías" invisible="not jx_show_warranty" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_warranty" widget="radio"/>
                            <field name="jx_card_warranty" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- FEES -->
                    <group string="10. Fees recurrentes" invisible="not jx_show_fees" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_fees" widget="radio"/>
                            <field name="jx_card_fees" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- CRM -->
                    <group string="11. CRM" invisible="not jx_show_crm" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_crm" widget="radio"/>
                            <field name="jx_card_crm" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- RRHH -->
                    <group string="12. Recursos Humanos" invisible="not jx_show_hr" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_hr" widget="radio"/>
                            <field name="jx_card_hr" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <!-- ADMIN -->
                    <group string="13. Administración Justech" invisible="not jx_show_admin" class="justech-jx-section">
                        <group col="2">
                            <field name="jx_lvl_admin" widget="radio"/>
                            <field name="jx_card_admin" nolabel="1" readonly="1" class="justech-jx-card"/>
                        </group>
                    </group>

                    <separator string="RESUMEN GENERAL (efectivo)"/>
                    <group col="2">
                        <group string="Módulos con acceso">
                            <field name="jx_summary_modules" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Advertencias">
                            <field name="jx_summary_warnings" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Puede">
                            <field name="jx_summary_can" nolabel="1" readonly="1"/>
                        </group>
                        <group string="No puede">
                            <field name="jx_summary_cannot" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ver implementación técnica" groups="base.group_system">
                        <field name="jx_tech_detail" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_hide_duplicate_justech_role_blocks" model="ir.ui.view">
        <field name="name">res.users.form.hide.duplicate.justech.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="justech_admin_center.view_res_users_form_justech_admin_center"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='justech_admin_center_perms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
