<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_justech_ms" model="ir.ui.view">
        <field name="name">sale.order.form.justech.ms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_justech_managed_service" type="object"
                        class="oe_stat_button" icon="fa-cogs"
                        invisible="not justech_managed_service_id"
                        groups="justech_managed_services.group_ms_user">
                    <div class="o_stat_info"><span class="o_stat_text">Servicio Adm.</span></div>
                </button>
            </div>
        </field>
    </record>
</odoo>
