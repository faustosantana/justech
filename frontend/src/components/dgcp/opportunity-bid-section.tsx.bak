"use client";

import {
  AlertTriangle,
  Bell,
  ClipboardCheck,
  Download,
  FileStack,
  Loader2,
  Mail,
  Package,
  RefreshCw,
} from "lucide-react";
import Link from "next/link";
import { useCallback, useEffect, useMemo, useState } from "react";

import { DgcpAnalysisProgressPanel } from "@/components/dgcp/dgcp-analysis-progress";
import { DgcpReanalyzeModal } from "@/components/dgcp/dgcp-reanalyze-modal";
import {
  DgcpUserMessageBanner,
  dgcpErrorFromUnknown,
  type DgcpUserMessage,
} from "@/components/dgcp/dgcp-user-message";
import { DgcpAutofillDocumentPanel } from "@/components/dgcp/dgcp-autofill-document-panel";
import { DgcpOfferPreparationCenter } from "@/components/dgcp/dgcp-offer-preparation-center";
import { DgcpProcessUpdatesPanel } from "@/components/dgcp/dgcp-process-updates-panel";
import { DgcpExpedienteTechnicalIntelligencePanel } from "@/components/dgcp/dgcp-expediente-technical-intelligence-panel";
import { DgcpTechnicalSheetsPanel } from "@/components/dgcp/dgcp-technical-sheets-panel";
import { DgcpCompanyProfileTab } from "@/components/dgcp/dgcp-company-profile-tab";
import { DocumentPreviewModal } from "@/components/dgcp/document-preview-modal";
import { DocumentViewButton } from "@/components/documents/document-view-button";
import { DGCPFinalizationPanel } from "@/components/dgcp/dgcp-finalization-panel";
import { DGCPPriceAnalysisPanel } from "@/components/dgcp/dgcp-price-analysis-panel";
import { RealExpedientePanel } from "@/components/dgcp/real-expediente-panel";
import { M365DocumentPicker } from "@/components/m365/m365-document-picker";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { apiClient } from "@/lib/api";
import { dgcpExpedienteTechnicalIntelligenceEnabled, dgcpOfferPreparationCenterEnabled, dgcpProcessUpdatesEnabled, dgcpSmartAutofillEnabled, dgcpTechSheetsEnabled, UNIFIED_STATUS_LABELS } from "@/lib/dgcp-feature-flags";
import {
  CHECKLIST_STATUS_LABELS,
  COMPLIANCE_STATUS_LABELS,
  EXPEDIENTE_STATUS_LABELS,
  PROCESS_DOC_ROLE_LABELS,
  PROCESS_PRIORITY_LABELS,
  REQUIREMENT_TYPE_LABELS,
  type DGCPChecklist,
  type DGCPChecklistItem,
  type DGCPBidAlerts,
  type DGCPBidPackage,
  type DGCPDocumentMatches,
  type DGCPDocumentValidation,
  type DGCPExpedienteStatus,
  type DGCPFormPreview,
  type DGCPProcessDocuments,
  type DGCPRequirements,
  type DGCPOpportunity,
  type DGCPAnalysisJob,
  type DGCPAnalyzeResult,
  type DGCPEconomicOfferStatus,
  isDGCPOperationalInterest,
} from "@/lib/dgcp";
import { ApiError } from "@/lib/api";
import { dgcpCompanyM365Folder, isPathLikeM365Query } from "@/lib/m365-query-utils";
import { cn } from "@/lib/utils";

const PROCESS_DOC_SOURCES = new Set(["portal", "dgcp_api", "portal_text", "process_file", "reference"]);
const PLIEGO_ROLES = new Set(["pliego", "tdr", "terminos_referencia", "ficha_tecnica", "anexo"]);

function hasChecklistEvidence(item: DGCPChecklistItem): boolean {
  return Boolean(
    item.document_id ||
      item.knowledge_asset_id ||
      item.process_document_id ||
      item.status === "no_aplica",
  );
}

function effectiveChecklistStatus(item: DGCPChecklistItem): string {
  if (
    (item.status === "validado_manual" || item.status === "encontrado_vigente") &&
    !hasChecklistEvidence(item)
  ) {
    return "faltante";
  }
  return item.status;
}

function formatNoteTimestamp(iso: string): string {
  try {
    return new Intl.DateTimeFormat("es-DO", { dateStyle: "short", timeStyle: "short" }).format(
      new Date(iso),
    );
  } catch {
    return iso;
  }
}

function analysisErrorMessage(err: unknown): DgcpUserMessage {
  return dgcpErrorFromUnknown(err, {
    title: "No se pudo analizar los requisitos",
    fallbackCause: "El servidor no pudo procesar el análisis en este momento.",
    nextStep: "Espere unos segundos y pulse «Reanalizar requisitos» o «Actualizar».",
  });
}

interface Props {
  opportunity: DGCPOpportunity;
  activeTab: string;
  interested: boolean;
  autofillFormTypeHint?: string;
  onNavigateTab?: (tab: string, options?: { formType?: string }) => void;
  onOpportunityUpdated?: (opportunity: DGCPOpportunity) => void;
  onAnalysisUpdate?: (
    bid: DGCPBidPackage,
    checklist: DGCPChecklist,
    status: string | null,
  ) => void;
}

function InterestGate() {
  return (
    <Card className="border-warning/30 bg-amber-500/10">
      <CardContent className="py-6 text-sm space-y-2">
        <p className="font-medium">Análisis operativo no habilitado</p>
        <p className="text-muted-foreground">
        En la cabecera del proceso, pulse <strong>Marcar interés</strong> antes de
          analizar requisitos, ver documentos del proceso, validar, agregar notas o crear tareas.
        </p>
      </CardContent>
    </Card>
  );
}

export function OpportunityBidSection({
  opportunity,
  activeTab,
  interested,
  autofillFormTypeHint,
  onNavigateTab,
  onOpportunityUpdated,
  onAnalysisUpdate,
}: Props) {
  const [requirements, setRequirements] = useState<DGCPRequirements | null>(null);
  const [checklist, setChecklist] = useState<DGCPChecklist | null>(null);
  const [bidPackage, setBidPackage] = useState<DGCPBidPackage | null>(null);
  const [matches, setMatches] = useState<DGCPDocumentMatches | null>(null);
  const [formPreview, setFormPreview] = useState<DGCPFormPreview | null>(null);
  const [processDocs, setProcessDocs] = useState<DGCPProcessDocuments | null>(null);
  const [alerts, setAlerts] = useState<DGCPBidAlerts | null>(null);
  const [expedienteStatus, setExpedienteStatus] = useState<DGCPExpedienteStatus | null>(null);
  const [analysisWarnings, setAnalysisWarnings] = useState<string[]>([]);
  const [selectedFormType, setSelectedFormType] = useState("");
  const [loading, setLoading] = useState(false);
  const [analyzing, setAnalyzing] = useState(false);
  const [expedienteBusy, setExpedienteBusy] = useState(false);
  const [userMessage, setUserMessage] = useState<DgcpUserMessage | null>(null);
  const [reanalyzeOpen, setReanalyzeOpen] = useState(false);
  const [previewItemId, setPreviewItemId] = useState<string | null>(null);
  const [validationItemId, setValidationItemId] = useState<string | null>(null);
  const [validationNote, setValidationNote] = useState("");
  const [validationStatus, setValidationStatus] = useState("validado_manual");
  const [validationExpiry, setValidationExpiry] = useState("");
  const [validationBusy, setValidationBusy] = useState(false);
  const [taskBusyId, setTaskBusyId] = useState<string | null>(null);
  const [noteItemId, setNoteItemId] = useState<string | null>(null);
  const [noteText, setNoteText] = useState("");
  const [noteBusy, setNoteBusy] = useState(false);
  const [actionSuccess, setActionSuccess] = useState<string | null>(null);
  const [associateItemId, setAssociateItemId] = useState<string | null>(null);
  const [m365PickerOpen, setM365PickerOpen] = useState(false);
  const [associateBusy, setAssociateBusy] = useState(false);
  const [economicOfferStatus, setEconomicOfferStatus] = useState<DGCPEconomicOfferStatus | null>(null);
  const [docValidation, setDocValidation] = useState<DGCPDocumentValidation | null>(null);
  const [alertsUnavailable, setAlertsUnavailable] = useState(false);
  const [analysisJob, setAnalysisJob] = useState<DGCPAnalysisJob | null>(null);

  const applyAnalyzeResult = useCallback(
    async (result: DGCPAnalyzeResult) => {
      setRequirements(result.requirements);
      setChecklist(result.checklist);
      setBidPackage(result.bid_package);
      setMatches(result.document_matches);
      if (result.process_documents && Array.isArray(result.process_documents)) {
        setProcessDocs({
          opportunity_id: opportunity.id,
          items: result.process_documents as DGCPProcessDocuments["items"],
          total: result.process_documents.length,
        });
      }
      if (result.alerts && Array.isArray(result.alerts)) {
        setAlerts({
          opportunity_id: opportunity.id,
          alerts: result.alerts as DGCPBidAlerts["alerts"],
          total: result.alerts.length,
        });
      }
      if (result.analysis_warnings && Array.isArray(result.analysis_warnings)) {
        setAnalysisWarnings(result.analysis_warnings);
      }
      const [exp, eco] = await Promise.all([
        apiClient.getDGCPExpedienteStatus(opportunity.id).catch(() => null),
        apiClient.getDGCPEconomicOfferStatus(opportunity.id).catch(() => null),
      ]);
      if (exp) setExpedienteStatus(exp);
      if (eco) setEconomicOfferStatus(eco);
      onAnalysisUpdate?.(result.bid_package, result.checklist, exp?.expediente_status ?? null);
    },
    [onAnalysisUpdate, opportunity.id],
  );

  const refreshAnalysisJob = useCallback(async () => {
    try {
      const status = await apiClient.getDGCPAnalysisStatus(opportunity.id);
      const job = status.job;
      if (!job) {
        const wasTrackingJob = analysisJob?.status === "in_progress";
        setAnalysisJob(null);
        if (wasTrackingJob) {
          const [req, chk, pkg, mat] = await Promise.all([
            apiClient.getDGCPRequirements(opportunity.id),
            apiClient.getDGCPChecklist(opportunity.id),
            apiClient.getDGCPBidPackage(opportunity.id),
            apiClient.getDGCPDocumentMatches(opportunity.id),
          ]);
          setRequirements(req);
          setChecklist(chk);
          setBidPackage(pkg);
          setMatches(mat);
          if (req.analyzed_at ?? pkg.analyzed_at) {
            setUserMessage({
              variant: "success",
              title: "Análisis completado",
              cause: "Los requisitos, checklist y documentos fueron actualizados.",
              nextStep: "Revise Requisitos o Checklist para validar los resultados.",
            });
            setActionSuccess("Análisis completado — resultados actualizados.");
          }
        }
        setAnalyzing(false);
        return status;
      }
      if (job.status === "in_progress") {
        setAnalysisJob(job);
        setAnalyzing(true);
        return status;
      }
      if (job.status === "completed" && job.result) {
        await applyAnalyzeResult(job.result);
        setAnalysisJob(null);
        setAnalyzing(false);
        setUserMessage({
          variant: "success",
          title: "Análisis completado",
          cause: "Los requisitos, checklist y documentos fueron actualizados.",
          nextStep: "Revise Requisitos o Checklist para validar los resultados.",
        });
        setActionSuccess("Análisis completado — resultados actualizados.");
        return status;
      }
      if (job.status === "error") {
        const detail = job.error?.trim() || job.message?.trim() || "Ocurrió un error durante el procesamiento.";
        setAnalysisJob(null);
        setAnalyzing(false);
        setUserMessage({
          variant: "error",
          title: "No se pudo completar el análisis",
          cause: detail.toLowerCase() === "error" ? "El análisis se interrumpió antes de terminar." : detail,
          nextStep: "Pulse «Reanalizar requisitos» para volver a intentar.",
        });
        return status;
      }
      setAnalysisJob(null);
      setAnalyzing(false);
      return status;
    } catch {
      return null;
    }
  }, [analysisJob?.status, applyAnalyzeResult, opportunity.id]);

  const analyzed = Boolean(requirements?.analyzed_at ?? bidPackage?.analyzed_at);

  const associateChecklistItem = useMemo(
    () => checklist?.items.find((i) => i.id === associateItemId) ?? null,
    [checklist, associateItemId],
  );

  const m365FolderQuery = useMemo(
    () => dgcpCompanyM365Folder(opportunity.company || "justech"),
    [opportunity.company],
  );

  useEffect(() => {
    if (autofillFormTypeHint) setSelectedFormType(autofillFormTypeHint);
  }, [autofillFormTypeHint]);

  const load = useCallback(async () => {
    if (!interested) return;
    setLoading(true);
    setUserMessage(null);
    try {
      const [req, chk, pkg, mat] = await Promise.all([
        apiClient.getDGCPRequirements(opportunity.id),
        apiClient.getDGCPChecklist(opportunity.id),
        apiClient.getDGCPBidPackage(opportunity.id),
        apiClient.getDGCPDocumentMatches(opportunity.id),
      ]);
      setRequirements(req);
      setChecklist(chk);
      setBidPackage(pkg);
      setMatches(mat);

      if (req.analyzed_at ?? pkg.analyzed_at) {
        setAlertsUnavailable(false);
        const [proc, alertRes, exp, eco, docVal] = await Promise.all([
          apiClient.getDGCPProcessDocuments(opportunity.id).catch(() => null),
          apiClient.getDGCPAlerts(opportunity.id).catch((err) => {
            if (err instanceof ApiError && err.status === 404) setAlertsUnavailable(true);
            return null;
          }),
          apiClient.getDGCPExpedienteStatus(opportunity.id).catch(() => null),
          apiClient.getDGCPEconomicOfferStatus(opportunity.id).catch(() => null),
          apiClient.getDGCPDocumentValidation(opportunity.id).catch(() => null),
        ]);
        if (proc) setProcessDocs(proc);
        if (alertRes) setAlerts(alertRes);
        else setAlerts(null);
        if (exp) setExpedienteStatus(exp);
        if (eco) setEconomicOfferStatus(eco);
        if (docVal) setDocValidation(docVal);
      } else if (activeTab === "documentos-proceso") {
        const proc = await apiClient.getDGCPProcessDocuments(opportunity.id).catch(() => null);
        if (proc) setProcessDocs(proc);
      }
    } catch (err) {
      const message =
        err instanceof Error && err.message === "UNAUTHORIZED"
          ? {
              variant: "error" as const,
              title: "Sesión expirada",
              cause: "Su sesión ya no es válida.",
              nextStep: "Cierre sesión y vuelva a entrar a JAIOS.",
            }
          : {
              variant: "error" as const,
              title: "No se pudo cargar el análisis",
              cause: "Los datos del expediente no están disponibles todavía.",
              nextStep: "Pulse «Analizar requisitos» para generar el checklist.",
            };
      setUserMessage(message);
    } finally {
      setLoading(false);
    }
  }, [activeTab, interested, opportunity.id]);

  useEffect(() => {
    if (!interested) return;
    if (activeTab !== "resumen" && activeTab !== "historial" && activeTab !== "tareas") {
      void load();
    }
  }, [activeTab, interested, load]);

  useEffect(() => {
    if (!interested) return;
    void refreshAnalysisJob();
  }, [interested, opportunity.id, refreshAnalysisJob]);

  useEffect(() => {
    setUserMessage((prev) => (prev?.variant === "error" || prev?.variant === "info" ? null : prev));
    setReanalyzeOpen(false);
  }, [activeTab]);

  useEffect(() => {
    if (!analysisJob || analysisJob.status !== "in_progress") return;
    const timer = window.setInterval(() => {
      void refreshAnalysisJob();
    }, 2000);
    return () => window.clearInterval(timer);
  }, [analysisJob, refreshAnalysisJob]);

  const runAnalysis = async (force = false) => {
    if (analyzing) return;
    setAnalyzing(true);
    setUserMessage(null);
    setActionSuccess(null);
    try {
      const result = await apiClient.analyzeDGCPRequirements(opportunity.id, {
        force,
        asyncJob: true,
      });
      if ("status" in result && result.status === "in_progress" && result.job_id) {
        const status = await apiClient.getDGCPAnalysisStatus(opportunity.id);
        if (status.job?.status === "completed" && status.job.result) {
          await applyAnalyzeResult(status.job.result);
          setAnalyzing(false);
          setUserMessage({
            variant: "success",
            title: "Análisis completado",
            cause: "Los requisitos y el checklist quedaron actualizados.",
            nextStep: "Revise la pestaña Requisitos para validar cada ítem.",
          });
          setActionSuccess("Análisis completado — resultados actualizados.");
          return;
        }
        if (status.job) {
          setAnalysisJob(status.job);
        } else {
          setAnalysisJob({
            job_id: result.job_id,
            opportunity_id: opportunity.id,
            status: "in_progress",
            stage: result.stage ?? "preparing",
            progress_pct: 5,
            started_at: new Date().toISOString(),
            updated_at: new Date().toISOString(),
            message: result.message,
          });
          void refreshAnalysisJob();
        }
        return;
      }
      await applyAnalyzeResult(result as DGCPAnalyzeResult);
      setAnalyzing(false);
      setUserMessage({
        variant: "success",
        title: "Análisis completado",
        cause: "Los requisitos y el checklist quedaron actualizados.",
        nextStep: "Revise la pestaña Requisitos para validar cada ítem.",
      });
    } catch (err) {
      if (err instanceof ApiError && err.status === 409) {
        const data = err.data as {
          already_analyzed?: boolean;
          analysis_already_running?: boolean;
          job_id?: string;
          message?: string;
        } | undefined;
        if (data?.analysis_already_running) {
          await refreshAnalysisJob();
          setUserMessage({
            variant: "info",
            title: "Análisis en curso",
            cause: "Ya hay un análisis ejecutándose para este expediente.",
            nextStep: "Espere a que termine la barra de progreso.",
          });
          setAnalyzing(false);
          return;
        }
        if (data?.already_analyzed && !force) {
          setAnalyzing(false);
          setAnalysisJob(null);
          setReanalyzeOpen(true);
          return;
        }
      }
      setUserMessage(analysisErrorMessage(err));
      setAnalyzing(false);
    }
  };

  const handleAnalyzeClick = () => {
    if (analyzed) {
      setReanalyzeOpen(true);
      return;
    }
    void runAnalysis(false);
  };

  const handleReanalyzeConfirm = () => {
    setReanalyzeOpen(false);
    void runAnalysis(true);
  };

  const handleCreateTask = async (itemId: string) => {
    setTaskBusyId(itemId);
    setUserMessage(null);
    setActionSuccess(null);
    try {
      const result = await apiClient.createDGCPChecklistTask(opportunity.id, itemId);
      setChecklist((prev) =>
        prev
          ? {
              ...prev,
              items: prev.items.map((item) =>
                item.id === itemId ? { ...item, task_id: result.task_id } : item,
              ),
            }
          : prev,
      );
      setActionSuccess(result.existing ? "Tarea existente — use «Ver tarea»." : "Tarea creada correctamente.");
      await load();
      return result;
    } catch (err) {
      setUserMessage(
        dgcpErrorFromUnknown(err, {
          title: "No se pudo crear la tarea",
          fallbackCause: "El servidor rechazó la creación de la tarea.",
          nextStep: "Verifique que el requisito siga pendiente e intente de nuevo.",
        }),
      );
      throw new Error("task_create_failed");
    } finally {
      setTaskBusyId(null);
    }
  };

  const handleAddNote = async () => {
    if (!noteItemId || !noteText.trim()) return;
    setNoteBusy(true);
    setUserMessage(null);
    setActionSuccess(null);
    try {
      const result = await apiClient.addDGCPChecklistNote(opportunity.id, noteItemId, noteText.trim());
      setChecklist(result.checklist);
      setNoteItemId(null);
      setNoteText("");
      setActionSuccess("Nota guardada en base de datos.");
      await load();
    } catch (err) {
      setUserMessage(
        dgcpErrorFromUnknown(err, {
          title: "No se pudo guardar la nota",
          fallbackCause: "La nota no se guardó en el expediente.",
          nextStep: "Revise su conexión e intente de nuevo.",
        }),
      );
    } finally {
      setNoteBusy(false);
    }
  };

  const handleManualValidation = async () => {
    if (!validationItemId) return;
    setValidationBusy(true);
    setUserMessage(null);
    try {
      const result = await apiClient.manualValidateDGCPRequirement(opportunity.id, validationItemId, {
        status: validationStatus,
        note: validationNote,
        expiration_date: validationExpiry || undefined,
      });
      setChecklist(result.checklist);
      setBidPackage(result.bid_package);
      setExpedienteStatus((prev) =>
        prev ? { ...prev, expediente_status: result.expediente_status } : prev,
      );
      onAnalysisUpdate?.(result.bid_package, result.checklist, result.expediente_status);
      setValidationItemId(null);
      setValidationNote("");
      setValidationExpiry("");
      setActionSuccess(
        `Validación guardada — checklist ${result.bid_package.compliant_count ?? 0}/${result.bid_package.mandatory_requirements ?? result.bid_package.total_requirements ?? "—"}.`,
      );
      await load();
    } catch (err) {
      setUserMessage(
        dgcpErrorFromUnknown(err, {
          title: "No se pudo guardar la validación",
          fallbackCause: "La validación manual no se registró.",
          nextStep: "Adjunte evidencia si falta documento y vuelva a validar.",
        }),
      );
    } finally {
      setValidationBusy(false);
    }
  };

  const handleMarkNoAplica = async (itemId: string) => {
    setUserMessage(null);
    try {
      const result = await apiClient.manualValidateDGCPRequirement(opportunity.id, itemId, {
        status: "no_aplica",
        note: "Marcado como no aplica por el usuario.",
      });
      setChecklist(result.checklist);
      setBidPackage(result.bid_package);
      onAnalysisUpdate?.(result.bid_package, result.checklist, result.expediente_status);
      setActionSuccess("Requisito marcado como no aplica.");
    } catch (err) {
      setUserMessage(
        dgcpErrorFromUnknown(err, {
          title: "No se pudo marcar como no aplica",
          fallbackCause: "El cambio de estado no se guardó.",
          nextStep: "Actualice la página e intente de nuevo.",
        }),
      );
    }
  };

  const handleAssociateDocument = async (documentId?: string, knowledgeAssetId?: string) => {
    if (!associateItemId) return;
    setAssociateBusy(true);
    setUserMessage(null);
    try {
      const result = await apiClient.associateDGCPChecklistDocument(opportunity.id, associateItemId, {
        document_id: documentId,
        knowledge_asset_id: knowledgeAssetId,
      });
      setChecklist(result.checklist);
      setBidPackage(result.bid_package);
      onAnalysisUpdate?.(result.bid_package, result.checklist, result.expediente_status);
      setAssociateItemId(null);
      setActionSuccess("Documento asociado al requisito.");
    } catch (err) {
      setUserMessage(
        dgcpErrorFromUnknown(err, {
          title: "No se pudo asociar el documento",
          fallbackCause: "El vínculo con el repositorio no se completó.",
          nextStep: "Seleccione otro archivo de OneDrive o suba un PDF.",
        }),
      );
    } finally {
      setAssociateBusy(false);
    }
  };

  const handleUploadForRequirement = async (file: File) => {
    if (!associateItemId) return;
    setAssociateBusy(true);
    setUserMessage(null);
    try {
      const result = await apiClient.uploadDGCPChecklistDocument(opportunity.id, associateItemId, file);
      setChecklist(result.checklist);
      setBidPackage(result.bid_package);
      onAnalysisUpdate?.(result.bid_package, result.checklist, result.expediente_status);
      setAssociateItemId(null);
      setActionSuccess("Documento subido y asociado.");
    } catch (err) {
      setUserMessage(
        dgcpErrorFromUnknown(err, {
          title: "No se pudo subir el documento",
          fallbackCause: "El archivo no se adjuntó al requisito.",
          nextStep: "Use un PDF menor a 25 MB e intente de nuevo.",
        }),
      );
    } finally {
      setAssociateBusy(false);
    }
  };

  const handleM365ChecklistAssociated = (result: {
    checklist: DGCPChecklist;
    bid_package: DGCPBidPackage;
    expediente_status: string;
  }) => {
    setChecklist(result.checklist);
    setBidPackage(result.bid_package);
    onAnalysisUpdate?.(result.bid_package, result.checklist, result.expediente_status);
    setAssociateItemId(null);
    setM365PickerOpen(false);
  };

  const handlePreviewSncc = async (formType: string) => {
    const preview = await apiClient.previewDGCPForm(opportunity.id, formType);
    setFormPreview(preview);
  };

  const handleGenerateForm = async () => {
    await apiClient.generateDGCPForm(opportunity.id, selectedFormType);
    await load();
  };

  const handlePrepareExpediente = async () => {
    setExpedienteBusy(true);
    setUserMessage(null);
    try {
      await apiClient.prepareDGCPExpediente(opportunity.id);
      const exp = await apiClient.getDGCPExpedienteStatus(opportunity.id);
      setExpedienteStatus(exp);
      await load();
    } catch (err) {
      if (err instanceof ApiError && err.status === 409 && err.data) {
        setDocValidation(err.data as DGCPDocumentValidation);
        setUserMessage({
          variant: "error",
          title: "Expediente incompleto",
          cause: "Faltan documentos corporativos obligatorios.",
          nextStep: "Complete el checklist antes de preparar el expediente.",
        });
      } else {
        setUserMessage(
          dgcpErrorFromUnknown(err, {
            title: "No se pudo preparar el expediente",
            fallbackCause: "El paquete de licitación no se generó.",
            nextStep: "Revise requisitos pendientes y pulse «Preparar expediente» otra vez.",
          }),
        );
      }
    } finally {
      setExpedienteBusy(false);
    }
  };

  const handleDownloadExpediente = async () => {
    setExpedienteBusy(true);
    try {
      await apiClient.downloadDGCPExpediente(
        opportunity.id,
        expedienteStatus?.opportunity_code
          ? `expediente_${expedienteStatus.opportunity_code}.zip`
          : undefined,
      );
    } catch {
      setUserMessage({
        variant: "error",
        title: "No se pudo descargar el expediente",
        cause: "El archivo no está listo o no tiene permisos.",
        nextStep: "Prepare el expediente primero y vuelva a descargar.",
      });
    } finally {
      setExpedienteBusy(false);
    }
  };

  const handleMarkReady = async () => {
    setExpedienteBusy(true);
    try {
      const exp = await apiClient.markDGCPExpedienteReady(opportunity.id);
      setExpedienteStatus(exp);
    } catch {
      setUserMessage({
        variant: "error",
        title: "Expediente no preparado",
        cause: "Aún no se generó el paquete para revisión.",
        nextStep: "Pulse «Preparar expediente» en la pestaña Expediente.",
      });
    } finally {
      setExpedienteBusy(false);
    }
  };

  if (activeTab === "resumen" || activeTab === "historial" || activeTab === "tareas") {
    return null;
  }

  if (!interested) {
    return <InterestGate />;
  }

  const showAnalysisChrome = new Set([
    "requisitos",
    "checklist",
    "documentos-proceso",
    "documentos",
    "alertas",
    "riesgos",
  ]).has(activeTab);
  const showCrossTabWarnings = showAnalysisChrome && activeTab !== "documentos-proceso";
  const analysisRunning = analyzing || analysisJob?.status === "in_progress";

  return (
    <div className="space-y-4">
      {showAnalysisChrome && analysisJob?.status === "in_progress" ? (
        <DgcpAnalysisProgressPanel job={analysisJob} />
      ) : null}
      {showAnalysisChrome ? (
        <div className="flex flex-wrap gap-2 items-center">
          <Button onClick={handleAnalyzeClick} disabled={analysisRunning || !interested}>
            {analysisRunning ? (
              <Loader2 className="mr-2 h-4 w-4 animate-spin" />
            ) : (
              <RefreshCw className="mr-2 h-4 w-4" />
            )}
            {analysisRunning
              ? "Analizando…"
              : analyzed
                ? "Reanalizar requisitos"
                : "Analizar requisitos"}
          </Button>
          <Button variant="outline" onClick={() => void load()} disabled={loading}>
            Actualizar
          </Button>
          {analyzed && requirements?.analyzed_at ? (
            <span className="text-xs text-muted-foreground">
              Último análisis: {formatNoteTimestamp(requirements.analyzed_at)}
            </span>
          ) : null}
        </div>
      ) : null}

      {showAnalysisChrome && analyzed && activeTab !== "documentos-proceso" && <DGCPPriceAnalysisPanel opportunityId={opportunity.id} />}

      {showAnalysisChrome && analyzed && activeTab !== "documentos-proceso" && economicOfferStatus && (
        <div className="rounded-lg border border-primary/20 bg-primary/5 px-4 py-3 text-sm flex flex-wrap items-center gap-3 justify-between">
          <div>
            <p className="font-medium">Oferta económica — {economicOfferStatus.display_status}</p>
            <p className="text-xs text-muted-foreground mt-0.5">
              {economicOfferStatus.document_title
                ? `Documento: ${economicOfferStatus.document_title}`
                : economicOfferStatus.draft_status
                  ? `Borrador: ${economicOfferStatus.draft_status}`
                  : "Suba la cotización PDF manualmente desde el checklist (Asociar / subir)"}
              {economicOfferStatus.preparation_pct != null
                ? ` · Preparación ${economicOfferStatus.preparation_pct.toFixed(0)}%`
                : ""}
            </p>
          </div>
          <div className="flex flex-wrap gap-2">
            {economicOfferStatus.task_id && (
              <Button size="sm" variant="outline" asChild>
                <Link href={`/tasks/${economicOfferStatus.task_id}`}>Ver tarea</Link>
              </Button>
            )}
          </div>
        </div>
      )}

      {showCrossTabWarnings && analysisWarnings.length > 0 && (
        <div className="rounded-lg border border-warning/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
          {analysisWarnings.map((w) => (
            <p key={w}>{w}</p>
          ))}
        </div>
      )}

      {actionSuccess && (
        <p className="text-sm text-success rounded-lg border border-success/30 px-3 py-2">
          {actionSuccess}
        </p>
      )}

      {userMessage && (
        <DgcpUserMessageBanner
          message={userMessage}
          onDismiss={() => setUserMessage(null)}
        />
      )}

      {loading && !requirements ? (
        <p className="text-sm text-muted-foreground">Cargando análisis…</p>
      ) : (
        <>
          {activeTab === "requisitos" && (
            analyzed && checklist && matches ? (
              <ComplianceBoardTab
                opportunityId={opportunity.id}
                checklist={checklist}
                matches={matches}
                warnings={analysisWarnings}
                onPreview={(itemId) => setPreviewItemId(itemId)}
                onValidate={(itemId) => {
                  setValidationItemId(itemId);
                  setValidationStatus("validado_manual");
                }}
                onCreateTask={handleCreateTask}
                taskBusyId={taskBusyId}
                onAddNote={(itemId) => {
                  setNoteItemId(itemId);
                  setNoteText("");
                }}
                onAssociate={setAssociateItemId}
                onMarkNoAplica={handleMarkNoAplica}
              />
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "documentos-proceso" && (
            <ProcessDocumentsTab
              documents={processDocs}
              opportunityId={opportunity.id}
              analyzed={analyzed}
              onReload={load}
            />
          )}
          {activeTab === "documentos" && matches && (
            analyzed ? (
              <div className="space-y-6">
                <DocumentosJustechTab
                  opportunityId={opportunity.id}
                  matches={matches}
                  checklist={checklist}
                  onPreview={setPreviewItemId}
                  onValidate={(itemId) => {
                    setValidationItemId(itemId);
                    setValidationStatus("validado_manual");
                  }}
                  onAddNote={(itemId) => {
                    setNoteItemId(itemId);
                    setNoteText("");
                  }}
                  onCreateTask={handleCreateTask}
                  taskBusyId={taskBusyId}
                />
                {dgcpSmartAutofillEnabled() && (
                  <div className="border-t pt-6">
                    <p className="mb-3 text-sm font-medium">Perfil empresarial (autollenado)</p>
                    <DgcpCompanyProfileTab companyKey={opportunity.company || "justech"} />
                  </div>
                )}
              </div>
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "checklist" && checklist && (
            analyzed && checklist.total > 0 ? (
              <ChecklistTab
                opportunityId={opportunity.id}
                checklist={checklist}
                onCreateTask={handleCreateTask}
                onPreviewSncc={handlePreviewSncc}
                onGoToAutofill={(formType) =>
                  onNavigateTab?.("autollenado", { formType: formType ?? selectedFormType })
                }
                onPreview={setPreviewItemId}
                onValidate={(itemId) => {
                  setValidationItemId(itemId);
                  setValidationStatus("validado_manual");
                }}
                taskBusyId={taskBusyId}
                onAddNote={(itemId) => {
                  setNoteItemId(itemId);
                  setNoteText("");
                }}
                onAssociate={setAssociateItemId}
                onMarkNoAplica={handleMarkNoAplica}
              />
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "expediente" && bidPackage && (
            analyzed ? (
              <ExpedienteTab
                opportunityId={opportunity.id}
                checklist={checklist}
                bidPackage={bidPackage}
                expedienteStatus={expedienteStatus}
                docValidation={docValidation}
                busy={expedienteBusy}
                onPrepare={() => void handlePrepareExpediente()}
                onDownload={() => void handleDownloadExpediente()}
                onMarkReady={() => void handleMarkReady()}
                onFinalizationUpdated={() => void load()}
                onGoToAutofill={() => onNavigateTab?.("autollenado", { formType: selectedFormType })}
                onNavigateTab={onNavigateTab}
                onRefreshExpediente={() => void load()}
              />
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "autollenado" && (
            analyzed ? (
              <DgcpAutofillDocumentPanel
                opportunityId={opportunity.id}
                formType={selectedFormType}
                onFormTypeChange={setSelectedFormType}
                onGenerated={() => void load()}
                onSendReview={() => void handleMarkReady()}
              />
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "fichas-tecnicas" && dgcpTechSheetsEnabled() && (
            analyzed ? (
              <DgcpTechnicalSheetsPanel opportunityId={opportunity.id} />
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "alertas" && (
            analyzed ? (
              alerts ? (
                <AlertasTab alerts={alerts} />
              ) : alertsUnavailable ? (
                <EmptyAnalysisHint message="Primero debe ejecutar el análisis de requisitos." />
              ) : (
                <AlertasTab alerts={{ alerts: [], total: 0 }} />
              )
            ) : (
              <EmptyAnalysisHint />
            )
          )}
          {activeTab === "riesgos" && checklist && (
            analyzed && checklist.total > 0 ? (
              <RiesgosTab checklist={checklist} opportunity={opportunity} />
            ) : (
              <EmptyAnalysisHint />
            )
          )}
        </>
      )}

      <DgcpReanalyzeModal
        open={reanalyzeOpen}
        processCode={opportunity.code}
        analyzedAt={
          requirements?.analyzed_at
            ? formatNoteTimestamp(requirements.analyzed_at)
            : bidPackage?.analyzed_at
              ? formatNoteTimestamp(bidPackage.analyzed_at)
              : null
        }
        busy={analyzing}
        onCancel={() => setReanalyzeOpen(false)}
        onConfirm={handleReanalyzeConfirm}
      />

      <DocumentPreviewModal
        open={Boolean(previewItemId)}
        onOpenChange={(open) => !open && setPreviewItemId(null)}
        opportunityId={opportunity.id}
        itemId={previewItemId ?? ""}
        checklistItem={checklist?.items.find((i) => i.id === previewItemId) ?? null}
        onValidated={() => void load().then(() => setActionSuccess("Validación guardada desde visor."))}
        onNoted={() => void load().then(() => setActionSuccess("Nota guardada desde visor."))}
        onTaskCreated={() => void load().then(() => setActionSuccess("Tarea creada desde visor."))}
      />

      {associateItemId && !m365PickerOpen && (
        <AssociateDocumentModal
          busy={associateBusy}
          onClose={() => setAssociateItemId(null)}
          onOpenM365={() => {
            setM365PickerOpen(true);
          }}
          onPickKnowledge={(id) => void handleAssociateDocument(undefined, id)}
          onPickDocument={(id) => void handleAssociateDocument(id, undefined)}
          onUpload={(file) => void handleUploadForRequirement(file)}
        />
      )}

      {m365PickerOpen && associateItemId && (
        <M365DocumentPicker
          open={m365PickerOpen}
          onClose={() => {
            setM365PickerOpen(false);
          }}
          entityType="dgcp_opportunity"
          entityId={opportunity.id}
          requirementId={associateChecklistItem?.requirement_key}
          fieldLabel={associateChecklistItem?.requirement}
          initialQuery={m365FolderQuery}
          initialTab={isPathLikeM365Query(m365FolderQuery) ? "browse" : "search"}
          dgcpChecklist={{ opportunityId: opportunity.id, itemId: associateItemId }}
          title="Buscar documento en Microsoft 365"
          onDgcpAssociated={handleM365ChecklistAssociated}
          onLinked={(message) => setActionSuccess(message)}
          onImported={(message) => setActionSuccess(message)}
        />
      )}

      {validationItemId && (() => {
        const validationItem = checklist?.items.find((i) => i.id === validationItemId);
        const lacksDoc = validationItem ? !hasChecklistEvidence(validationItem) : true;
        return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
          <Card className="w-full max-w-lg border-primary/30">
            <CardHeader>
              <CardTitle className="text-base">Validar requisito</CardTitle>
              {validationItem && (
                <p className="text-sm text-muted-foreground">{validationItem.requirement}</p>
              )}
            </CardHeader>
            <CardContent className="space-y-3">
            {lacksDoc && validationStatus === "validado_manual" && (
              <p className="text-sm text-amber-700 dark:text-amber-300 rounded border border-amber-500/30 px-3 py-2">
                No hay documento asociado. Use «No aplica» o adjunte evidencia antes de marcar como validado.
              </p>
            )}
            <div className="grid gap-3 sm:grid-cols-2">
              <div className="space-y-1">
                <Label>Estado</Label>
                <select
                  className="brand-input h-9 py-1"
                  value={validationStatus}
                  onChange={(e) => setValidationStatus(e.target.value)}
                >
                  <option value="validado_manual">Validado manualmente</option>
                  <option value="encontrado_vencido">Marcar vencido</option>
                  <option value="requiere_revision">Requiere revisión</option>
                  <option value="no_aplica">No aplica</option>
                </select>
              </div>
              <div className="space-y-1">
                <Label>Vencimiento (opcional)</Label>
                <Input type="date" value={validationExpiry} onChange={(e) => setValidationExpiry(e.target.value)} />
              </div>
            </div>
            <div className="space-y-1">
              <Label>Nota</Label>
              <Input
                value={validationNote}
                onChange={(e) => setValidationNote(e.target.value)}
                placeholder="Ej.: Revisado por Fausto. Certificación DGII vigente hasta 14/05/2026."
              />
            </div>
            <div className="flex gap-2">
              <Button
                size="sm"
                onClick={() => void handleManualValidation()}
                disabled={validationBusy || (lacksDoc && validationStatus === "validado_manual")}
              >
                Guardar validación
              </Button>
              <Button size="sm" variant="ghost" onClick={() => setValidationItemId(null)}>
                Cancelar
              </Button>
            </div>
          </CardContent>
          </Card>
        </div>
        );
      })()}

      {noteItemId && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
          <Card className="w-full max-w-lg border-primary/30">
            <CardHeader>
              <CardTitle className="text-base">Agregar nota</CardTitle>
            </CardHeader>
            <CardContent className="space-y-3">
            <div className="space-y-1">
              <Label>Nota</Label>
              <Input
                value={noteText}
                onChange={(e) => setNoteText(e.target.value)}
                placeholder="Se guardará con autor, fecha e historial."
              />
            </div>
            <div className="flex gap-2">
              <Button size="sm" onClick={() => void handleAddNote()} disabled={noteBusy || !noteText.trim()}>
                Guardar nota
              </Button>
              <Button size="sm" variant="ghost" onClick={() => setNoteItemId(null)}>
                Cancelar
              </Button>
            </div>
          </CardContent>
          </Card>
        </div>
      )}

      {formPreview && activeTab !== "autollenado" && (
        <Card className="border-primary/30">
          <CardHeader>
            <CardTitle className="text-base">
              Vista previa — {formPreview.form_type}
            </CardTitle>
          </CardHeader>
          <CardContent className="space-y-2 text-sm">
            <p className="text-muted-foreground">{formPreview.note}</p>
            <p className="text-xs">
              Confianza general: {(formPreview.overall_confidence * 100).toFixed(0)}%
            </p>
            <div className="divide-y rounded border">
              {formPreview.fields.map((f) => (
                <div key={f.label} className="flex flex-wrap justify-between gap-2 px-3 py-2">
                  <div>
                    <span className="text-muted-foreground">{f.label}</span>
                    {f.source && (
                      <p className="text-[10px] text-muted-foreground">Fuente: {f.source}</p>
                    )}
                  </div>
                  <div className="text-right">
                    <span className={f.status === "pendiente" ? "text-amber-500" : "font-medium"}>
                      {f.value ?? "Pendiente"}
                    </span>
                    <p className="text-[10px] text-muted-foreground">
                      {(f.confidence * 100).toFixed(0)}% · {f.status}
                    </p>
                  </div>
                </div>
              ))}
            </div>
            {formPreview.warnings.length > 0 && (
              <ul className="text-xs text-warning list-disc pl-4">
                {formPreview.warnings.map((w) => (
                  <li key={w}>{w}</li>
                ))}
              </ul>
            )}
            {formPreview.generate_enabled && (
              <Button variant="outline" size="sm" onClick={() => void handleGenerateForm()}>
                Generar copia controlada
              </Button>
            )}
            {!formPreview.generate_enabled && (
              <Button variant="outline" size="sm" disabled title="Use la pestaña Autollenado para generar">
                Generar documento (Autollenado)
              </Button>
            )}
            <Button variant="ghost" size="sm" onClick={() => setFormPreview(null)}>
              Cerrar vista previa
            </Button>
          </CardContent>
        </Card>
      )}
    </div>
  );
}

function EmptyAnalysisHint({ message }: { message?: string }) {
  return (
    <p className="text-sm text-muted-foreground rounded-lg border px-3 py-4">
      {message ??
        "Aún no hay análisis guardado. Pulse «Analizar requisitos» para generar checklist, expediente y cruces documentales."}
    </p>
  );
}

function ComplianceBoardTab({
  opportunityId,
  checklist,
  matches,
  warnings,
  onPreview,
  onValidate,
  onCreateTask,
  taskBusyId,
  onAddNote,
  onAssociate,
  onMarkNoAplica,
}: {
  opportunityId: string;
  checklist: DGCPChecklist;
  matches: DGCPDocumentMatches;
  warnings: string[];
  onPreview: (itemId: string) => void;
  onValidate: (itemId: string) => void;
  onCreateTask: (itemId: string) => Promise<{ task_id: string; existing?: boolean }>;
  taskBusyId: string | null;
  onAddNote: (itemId: string) => void;
  onAssociate: (itemId: string) => void;
  onMarkNoAplica: (itemId: string) => void;
}) {
  const matchByKey = Object.fromEntries(matches.matches.map((m) => [m.requirement_key, m]));
  const itemByKey = Object.fromEntries(checklist.items.map((i) => [i.requirement_key, i]));

  return (
    <div className="space-y-4">
      <p className="text-sm text-muted-foreground">
        Tablero de cumplimiento — cada fila es un requisito extraído del proceso, no un documento del
        repositorio.
      </p>
      {warnings.length > 0 && (
        <div className="rounded-lg border border-warning/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
          {warnings.map((w) => (
            <p key={w}>{w}</p>
          ))}
        </div>
      )}
      <div className="grid gap-3">
        {checklist.items.map((item) => {
          const match = matchByKey[item.requirement_key];
          return (
            <div
              key={item.id}
              className="rounded-lg border bg-card px-4 py-3 grid gap-3 lg:grid-cols-[1fr_auto] lg:items-start"
            >
              <div className="space-y-2">
                <div className="flex flex-wrap items-center gap-2">
                  <ComplianceIcon status={item.status} item={item} />
                  <p className="font-medium">{item.requirement}</p>
                  <StatusPill status={item.status} item={item} />
                </div>
                <div className="flex flex-wrap gap-3 text-xs text-muted-foreground">
                  <span>{REQUIREMENT_TYPE_LABELS[item.tipo] ?? item.tipo}</span>
                  <span>{item.mandatory ? "Obligatorio" : "Opcional"}</span>
                  {match?.match_source && (
                    <span>
                      Fuente:{" "}
                      {match.match_source === "knowledge_repository"
                        ? "JustechAI"
                        : match.match_source === "knowledge_template"
                          ? "Plantilla"
                          : match.match_source === "document_repository"
                            ? "JAIOS Docs"
                            : "Proceso DGCP"}
                    </span>
                  )}
                </div>
                {(match?.notes ?? item.notes) && (
                  <p className="text-xs rounded bg-muted/50 px-2 py-1">{match?.notes ?? item.notes}</p>
                )}
                {item.manual_validation && typeof item.manual_validation === "object" && (
                  <p className="text-xs text-success ">
                    Validación manual: {(item.manual_validation as { note?: string }).note ?? "Registrada"}
                  </p>
                )}
                {match?.validity_analysis && (
                  <p className="text-xs text-muted-foreground">
                    Evidencia:{" "}
                    {String((match.validity_analysis as { evidence_text?: string }).evidence_text ?? "—")}
                  </p>
                )}
                {item.note_history && item.note_history.length > 0 && (
                  <div className="text-xs space-y-1 rounded bg-muted/30 px-2 py-1">
                    {item.note_history.slice(-3).reverse().map((entry, idx) => (
                      <p key={`${entry.created_at}-${idx}`}>
                        <span className="font-medium">{entry.author}</span>{" "}
                        <span className="text-muted-foreground">
                          {formatNoteTimestamp(entry.created_at)}
                        </span>
                        <br />
                        {entry.note}
                      </p>
                    ))}
                  </div>
                )}
                {item.recommended_action && (
                  <p className="text-xs text-primary">Acción: {item.recommended_action}</p>
                )}
              </div>
              <div className="space-y-2 text-sm lg:text-right min-w-[180px]">
                <div>
                  <p className="text-xs text-muted-foreground mb-1">Documento asociado</p>
                  <p className="font-medium">{match?.document_title ?? "Ninguno"}</p>
                </div>
                <RequirementActions
                  opportunityId={opportunityId}
                  item={item}
                  taskBusy={taskBusyId === item.id}
                  onPreview={() => onPreview(item.id)}
                  onValidate={() => onValidate(item.id)}
                  onAddNote={() => onAddNote(item.id)}
                  onCreateTask={() => void onCreateTask(item.id)}
                  onAssociate={() => onAssociate(item.id)}
                  onMarkNoAplica={() => onMarkNoAplica(item.id)}
                />
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

function ComplianceIcon({
  status,
  item,
}: {
  status: string;
  item?: DGCPChecklistItem;
}) {
  const effectiveStatus = item ? effectiveChecklistStatus(item) : status;
  const icon =
    effectiveStatus === "encontrado_vigente" || effectiveStatus === "validado_manual"
      ? "🟢"
      : effectiveStatus === "requiere_revision" ||
          effectiveStatus === "encontrado_sin_fecha" ||
          effectiveStatus === "encontrado_sin_analizar"
        ? "🟡"
        : effectiveStatus === "requiere_completado"
          ? "🟠"
          : effectiveStatus === "faltante" || effectiveStatus === "encontrado_vencido"
            ? "🔴"
            : effectiveStatus === "no_aplica"
              ? "⚫"
              : "⚪";
  return <span aria-hidden>{icon}</span>;
}

function RequirementActions({
  opportunityId,
  item,
  taskBusy,
  onPreview,
  onValidate,
  onAddNote,
  onCreateTask,
  onAssociate,
  onMarkNoAplica,
  onGoToAutofill,
}: {
  opportunityId: string;
  item: DGCPChecklistItem;
  taskBusy?: boolean;
  onPreview: () => void;
  onValidate: () => void;
  onAddNote: () => void;
  onCreateTask: () => void;
  onAssociate: () => void;
  onMarkNoAplica: () => void;
  onGoToAutofill?: () => void;
}) {
  const hasDoc = Boolean(
    item.document_id || item.document_title || item.knowledge_asset_id || item.process_document_id,
  );
  const isFaltante = effectiveChecklistStatus(item) === "faltante" || !hasDoc;
  const isOferta = item.requirement_key === "oferta_economica";
  return (
    <div className="flex flex-wrap gap-1 justify-end">
      {hasDoc && (
        <>
          <DocumentViewButton
            knowledgeAssetId={item.knowledge_asset_id}
            documentId={item.document_id}
            processDocumentId={item.process_document_id}
            opportunityId={opportunityId}
            label="Ver documento"
          />
          <Button size="sm" variant="ghost" onClick={onPreview}>
            Detalle / validar
          </Button>
        </>
      )}
      {isFaltante && (
        <Button size="sm" variant="outline" onClick={onAssociate}>
          {isOferta ? "Adjuntar" : "Asociar / subir"}
        </Button>
      )}
      <Button size="sm" variant="ghost" onClick={onValidate}>
        Validar
      </Button>
      <Button size="sm" variant="ghost" onClick={onAddNote}>
        Agregar nota
      </Button>
      <Button size="sm" variant="ghost" onClick={onMarkNoAplica}>
        No aplica
      </Button>
      {item.task_id ? (
        <Button size="sm" variant="secondary" asChild>
          <Link href={`/tasks/${item.task_id}`}>Ver tarea</Link>
        </Button>
      ) : (
        <Button size="sm" variant="outline" onClick={onCreateTask} disabled={taskBusy}>
          {taskBusy ? "Creando…" : "Crear tarea"}
        </Button>
      )}
      {item.completable && item.form_type && onGoToAutofill && (
        <Button size="sm" variant="secondary" onClick={onGoToAutofill}>
          Autollenar
        </Button>
      )}
    </div>
  );
}

function DocumentosJustechTab({
  opportunityId,
  matches,
  checklist,
  onPreview,
  onValidate,
  onAddNote,
  onCreateTask,
  taskBusyId,
}: {
  opportunityId: string;
  matches: DGCPDocumentMatches;
  checklist: DGCPChecklist | null;
  onPreview: (itemId: string) => void;
  onValidate: (itemId: string) => void;
  onAddNote: (itemId: string) => void;
  onCreateTask: (itemId: string) => Promise<{ task_id: string; existing?: boolean }>;
  taskBusyId: string | null;
}) {
  const justechMatches = matches.matches.filter(
    (m) =>
      m.match_source === "knowledge_repository" ||
      m.match_source === "document_repository" ||
      m.match_source === "knowledge_template",
  );
  const itemByKey = Object.fromEntries((checklist?.items ?? []).map((i) => [i.requirement_key, i]));

  return (
    <div className="space-y-4">
      <p className="text-sm text-muted-foreground">
        Documentos corporativos Justech (RPE, DGII, TSS, SNCC, ofertas, cartas) usados para cumplir
        requisitos — no confundir con pliego/TDR del comprador (pestaña Docs. Proceso).
      </p>
      <div className="grid gap-4">
        {justechMatches.map((m) => {
          const item = itemByKey[m.requirement_key];
          return (
            <Card key={m.requirement_key} className="overflow-hidden">
              <CardContent className="p-0">
                <div className="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x">
                  <div className="p-4 space-y-1">
                    <p className="text-xs font-medium uppercase text-muted-foreground">Requisito</p>
                    <p className="font-semibold">{m.requirement_label}</p>
                    <StatusPill status={m.status} item={item} />
                  </div>
                  <div className="p-4 space-y-2 bg-muted/20">
                    <p className="text-xs font-medium uppercase text-muted-foreground">Documento Justech</p>
                    {m.document_id ? (
                      <Link
                        href={`/documents?id=${m.document_id}`}
                        className="text-primary hover:underline font-medium"
                      >
                        {m.document_title}
                      </Link>
                    ) : m.knowledge_asset_id ? (
                      <p className="font-medium">{m.document_title}</p>
                    ) : m.document_title ? (
                      <p className="font-medium">{m.document_title}</p>
                    ) : (
                      <p className="text-muted-foreground italic">Ninguno</p>
                    )}
                    {m.relative_path && (
                      <p className="text-xs text-muted-foreground break-all">Ruta: {m.relative_path}</p>
                    )}
                    {item && (
                      <p className="text-xs text-muted-foreground">
                        Estado:{" "}
                        {COMPLIANCE_STATUS_LABELS[effectiveChecklistStatus(item)] ?? item.status}
                      </p>
                    )}
                    {m.valid_until && (
                      <p className="text-xs text-muted-foreground">Vigencia: hasta {m.valid_until}</p>
                    )}
                    {item && (
                      <div className="flex flex-wrap gap-1 pt-1">
                        {(m.document_title || m.document_id || m.knowledge_asset_id) && (
                          <>
                            <DocumentViewButton
                              knowledgeAssetId={m.knowledge_asset_id}
                              documentId={m.document_id}
                              opportunityId={opportunityId}
                              label="Ver documento"
                            />
                            <Button size="sm" variant="ghost" onClick={() => onPreview(item.id)}>
                              Detalle / validar
                            </Button>
                          </>
                        )}
                        <Button size="sm" variant="ghost" onClick={() => onValidate(item.id)}>
                          Validar
                        </Button>
                        <Button size="sm" variant="ghost" onClick={() => onAddNote(item.id)}>
                          Agregar nota
                        </Button>
                        {item.task_id ? (
                          <Button size="sm" variant="secondary" asChild>
                            <Link href={`/tasks/${item.task_id}`}>Ver tarea</Link>
                          </Button>
                        ) : (
                          <Button
                            size="sm"
                            variant="outline"
                            onClick={() => void onCreateTask(item.id)}
                            disabled={taskBusyId === item.id}
                          >
                            {taskBusyId === item.id ? "Creando…" : "Crear tarea"}
                          </Button>
                        )}
                      </div>
                    )}
                    {item?.note_history && item.note_history.length > 0 && (
                      <div className="text-xs space-y-1 rounded bg-muted/30 px-2 py-1 mt-2">
                        {item.note_history.slice(-2).reverse().map((entry, idx) => (
                          <p key={`${entry.created_at}-${idx}`}>
                            <span className="font-medium">{entry.author}</span>{" "}
                            {formatNoteTimestamp(entry.created_at)} — {entry.note}
                          </p>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </CardContent>
            </Card>
          );
        })}
      </div>
    </div>
  );
}

function DocumentosTab({ matches }: { matches: DGCPDocumentMatches }) {
  return (
    <div className="space-y-4">
      <p className="text-sm text-muted-foreground">
        Cruce documental: qué requisito satisface cada documento del repositorio corporativo.
      </p>
      <div className="grid gap-4">
        {matches.matches.map((m) => (
          <Card key={m.requirement_key} className="overflow-hidden">
            <CardContent className="p-0">
              <div className="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x">
                <div className="p-4 space-y-1">
                  <p className="text-xs font-medium uppercase text-muted-foreground">Requisito</p>
                  <p className="font-semibold">{m.requirement_label}</p>
                  <StatusPill status={m.status} />
                </div>
                <div className="p-4 space-y-2 bg-muted/20">
                  <p className="text-xs font-medium uppercase text-muted-foreground">Documento asociado</p>
                  {m.document_id ? (
                    <Link href={`/documents?id=${m.document_id}`} className="text-primary hover:underline font-medium">
                      {m.document_title}
                    </Link>
                  ) : m.document_title ? (
                    <p className="font-medium">{m.document_title}</p>
                  ) : (
                    <p className="text-muted-foreground italic">Ninguno</p>
                  )}
                  <p className="text-xs text-muted-foreground">
                    Estado: {COMPLIANCE_STATUS_LABELS[m.status] ?? m.status}
                  </p>
                  {m.vigency_status && m.vigency_status !== "no_aplica_vigencia" && (
                    <p className="text-xs text-muted-foreground">
                      Vigencia: {m.valid_until ? `hasta ${m.valid_until}` : m.vigency_status}
                    </p>
                  )}
                  {(m.observation ?? m.notes) && (
                    <p className="text-xs">{m.observation ?? m.notes}</p>
                  )}
                </div>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  );
}

function ChecklistTab({
  opportunityId,
  checklist,
  onCreateTask,
  onPreview,
  onValidate,
  taskBusyId,
  onAddNote,
  onAssociate,
  onMarkNoAplica,
  onGoToAutofill,
}: {
  opportunityId: string;
  checklist: DGCPChecklist;
  onCreateTask: (id: string) => Promise<{ task_id: string; existing?: boolean }>;
  onPreviewSncc: (form: string) => Promise<void>;
  onGoToAutofill?: (formType: string) => void;
  onPreview: (itemId: string) => void;
  onValidate: (itemId: string) => void;
  taskBusyId: string | null;
  onAddNote: (itemId: string) => void;
  onAssociate: (itemId: string) => void;
  onMarkNoAplica: (itemId: string) => void;
}) {
  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2 text-base">
          <ClipboardCheck className="h-4 w-4" />
          Checklist — {checklist.compliant_count ?? checklist.ready_count}/
          {checklist.mandatory_total ?? checklist.total} cumplidos
        </CardTitle>
        <p className="text-xs text-muted-foreground">
          {checklist.pending_count} faltante(s) · {checklist.incomplete_count} por completar ·{" "}
          {checklist.expired_count} vencido(s) · {checklist.review_count ?? 0} requieren revisión ·{" "}
          {checklist.unanalyzed_count ?? 0} sin analizar
        </p>
      </CardHeader>
      <CardContent className="space-y-2">
        {checklist.items.map((item) => (
          <div
            key={item.id}
            className="flex flex-wrap items-start justify-between gap-2 rounded-lg border px-3 py-2 text-sm"
          >
            <div className="min-w-0 flex-1">
              <p className="font-medium">{item.requirement}</p>
              <p className="text-xs text-muted-foreground">
                {REQUIREMENT_TYPE_LABELS[item.tipo] ?? item.tipo}
                {item.mandatory ? " · Obligatorio" : " · Opcional"}
                {item.risk ? ` · ${item.risk}` : ""}
              </p>
              {item.recommended_action && (
                <p className="text-xs mt-1">{item.recommended_action}</p>
              )}
              {item.note_history && item.note_history.length > 0 && (
                <div className="text-xs space-y-1 rounded bg-muted/30 px-2 py-1 mt-1">
                  {item.note_history.slice(-2).reverse().map((entry, idx) => (
                    <p key={`${entry.created_at}-${idx}`}>
                      <span className="font-medium">{entry.author}</span>{" "}
                      {formatNoteTimestamp(entry.created_at)} — {entry.note}
                    </p>
                  ))}
                </div>
              )}
            </div>
            <div className="flex items-center gap-2 shrink-0 flex-wrap justify-end max-w-md">
              <StatusPill status={item.status} item={item} />
              <RequirementActions
                opportunityId={opportunityId}
                item={item}
                taskBusy={taskBusyId === item.id}
                onPreview={() => onPreview(item.id)}
                onValidate={() => onValidate(item.id)}
                onAddNote={() => onAddNote(item.id)}
                onCreateTask={() => void onCreateTask(item.id)}
                onAssociate={() => onAssociate(item.id)}
                onMarkNoAplica={() => void onMarkNoAplica(item.id)}
                onGoToAutofill={
                  item.completable && item.form_type
                    ? () => onGoToAutofill?.(item.form_type ?? selectedFormType)
                    : undefined
                }
              />
            </div>
          </div>
        ))}
      </CardContent>
    </Card>
  );
}

function ExpedienteTab({
  opportunityId,
  checklist,
  bidPackage,
  expedienteStatus,
  docValidation,
  busy,
  onPrepare,
  onDownload,
  onMarkReady,
  onFinalizationUpdated,
  onGoToAutofill,
  onNavigateTab,
  onRefreshExpediente,
}: {
  opportunityId: string;
  checklist: DGCPChecklist | null;
  bidPackage: DGCPBidPackage;
  expedienteStatus: DGCPExpedienteStatus | null;
  docValidation: DGCPDocumentValidation | null;
  busy: boolean;
  onPrepare: () => void;
  onDownload: () => void;
  onMarkReady: () => void;
  onFinalizationUpdated: () => void;
  onGoToAutofill?: () => void;
  onNavigateTab?: (tab: string, options?: { formType?: string }) => void;
  onRefreshExpediente?: () => void;
}) {
  const [section, setSection] = useState<
    "resumen" | "checklist" | "documentos" | "formularios" | "inteligencia-tecnica" | "actualizaciones" | "firmas" | "pdf" | "zip"
  >("resumen");
  const [updatesPending, setUpdatesPending] = useState(0);

  const sections = [
    { id: "resumen" as const, label: "Resumen" },
    { id: "checklist" as const, label: "Checklist" },
    { id: "documentos" as const, label: "Documentos" },
    { id: "formularios" as const, label: "Formularios" },
    ...(dgcpExpedienteTechnicalIntelligenceEnabled()
      ? [{ id: "inteligencia-tecnica" as const, label: "Oferta técnica" }]
      : []),
    ...(dgcpProcessUpdatesEnabled()
      ? [{ id: "actualizaciones" as const, label: "Actualizaciones" }]
      : []),
    { id: "firmas" as const, label: "Firmas" },
    { id: "pdf" as const, label: "PDF final" },
    { id: "zip" as const, label: "ZIP final" },
  ];

  const statusLabel =
    EXPEDIENTE_STATUS_LABELS[expedienteStatus?.expediente_status ?? "sin_preparar"] ?? "Sin preparar";
  const incomplete = docValidation?.blocked ?? docValidation?.status === "incompleto";

  return (
    <Card className="border-primary/20">
      <CardHeader>
        <CardTitle className="flex items-center gap-2 text-base">
          <Package className="h-4 w-4 text-primary" />
          Expediente — {incomplete ? "INCOMPLETO" : statusLabel}
        </CardTitle>
        <div className="flex flex-wrap gap-1 pt-2">
          {sections.map((s) => (
            <Button
              key={s.id}
              type="button"
              size="sm"
              variant={section === s.id ? "default" : "outline"}
              onClick={() => setSection(s.id)}
            >
              {s.label}
              {s.id === "actualizaciones" && updatesPending > 0 ? (
                <span className="ml-1 rounded-full bg-destructive px-1.5 py-0 text-[9px] text-destructive-foreground">
                  {updatesPending}
                </span>
              ) : null}
            </Button>
          ))}
        </div>
      </CardHeader>
      <CardContent className="space-y-4">
        {dgcpOfferPreparationCenterEnabled() && (
          <DgcpOfferPreparationCenter
            opportunityId={opportunityId}
            onRefreshExpediente={onRefreshExpediente}
            onGoToAutofill={() => onGoToAutofill?.()}
            onGoToOfferTechnical={() => setSection("inteligencia-tecnica")}
            onGoToFichas={() => onNavigateTab?.("fichas-tecnicas")}
          />
        )}
        {dgcpProcessUpdatesEnabled() && updatesPending > 0 && section !== "actualizaciones" && (
          <button
            type="button"
            className="w-full rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-left text-xs text-amber-900 hover:bg-amber-500/15"
            onClick={() => setSection("actualizaciones")}
          >
            <span className="font-medium flex items-center gap-1">
              <Bell className="h-3.5 w-3.5" />
              {updatesPending} actualización(es) del portal pendiente(s) de revisión
            </span>
          </button>
        )}
        {section === "actualizaciones" && dgcpProcessUpdatesEnabled() && (
          <DgcpProcessUpdatesPanel
            opportunityId={opportunityId}
            onPendingCountChange={setUpdatesPending}
          />
        )}
        {section === "resumen" && (
          <>
            {incomplete && docValidation && (
              <div className="rounded-lg border border-amber-500/40 bg-amber-500/10 p-4 text-sm">
                <p className="flex items-center gap-2 font-medium text-amber-900">
                  <AlertTriangle className="h-4 w-4" />
                  {docValidation.message}
                </p>
                <ul className="mt-2 space-y-1 text-amber-800">
                  {docValidation.missing_documents.map((d) => (
                    <li key={d}>• Documento: {d.replace(/_/g, " ")}</li>
                  ))}
                  {docValidation.missing_data.map((d) => (
                    <li key={d}>• Dato: {d.replace(/_/g, " ")}</li>
                  ))}
                  {docValidation.expired_documents.map((d) => (
                    <li key={d}>• Vencido: {d}</li>
                  ))}
                </ul>
              </div>
            )}
            <div className="flex flex-wrap gap-2">
              <Button onClick={onPrepare} disabled={busy || incomplete}>
                {busy ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : null}
                Preparar expediente
              </Button>
              <Button
                variant="outline"
                onClick={onDownload}
                disabled={busy || !expedienteStatus?.can_download}
              >
                <Download className="mr-2 h-4 w-4" />
                Descargar expediente
              </Button>
              <Button
                variant="secondary"
                onClick={onMarkReady}
                disabled={busy || !expedienteStatus?.can_mark_ready}
              >
                Enviar a revisión
              </Button>
            </div>
            <div className="flex items-end gap-4">
              <div>
                <p className="text-xs text-muted-foreground uppercase">Avance por áreas</p>
                <p className="text-4xl font-bold text-primary">
                  {(bidPackage.area_preparation_pct ?? 0).toFixed(1)}%
                </p>
              </div>
              <div>
                <p className="text-xs text-muted-foreground uppercase">Cumplimiento checklist</p>
                <p className="text-2xl font-semibold text-foreground pb-1">
                  {bidPackage.compliant_count ?? bidPackage.found_documents}/
                  {bidPackage.mandatory_requirements ?? bidPackage.total_requirements ?? "—"}
                </p>
              </div>
            </div>
            <div className="grid gap-2 sm:grid-cols-3 lg:grid-cols-6 text-sm">
              <Metric label="Total requisitos" value={bidPackage.total_requirements ?? 0} />
              <Metric label="Cumplidos" value={bidPackage.compliant_count ?? 0} />
              <Metric label="Faltantes" value={bidPackage.pending_documents} />
              <Metric label="Vencidos" value={bidPackage.expired_documents} />
              <Metric label="Por completar" value={bidPackage.forms_to_complete} />
              <Metric label="Requieren revisión" value={bidPackage.review_count ?? 0} />
            </div>
            {bidPackage.recommended_tasks.length > 0 && (
              <div>
                <p className="text-xs font-medium text-muted-foreground uppercase mb-2">Tareas recomendadas</p>
                <ul className="list-disc pl-4 text-sm space-y-1">
                  {bidPackage.recommended_tasks.map((t) => (
                    <li key={t}>{t}</li>
                  ))}
                </ul>
              </div>
            )}
          </>
        )}

        {section === "checklist" && checklist && (
          <div className="space-y-2 text-sm">
            <p className="text-muted-foreground">
              {checklist.compliant_count ?? checklist.ready_count}/{checklist.mandatory_total ?? checklist.total}{" "}
              cumplidos · {checklist.pending_count} faltante(s)
            </p>
            <ul className="divide-y rounded border">
              {checklist.items.slice(0, 12).map((item) => (
                <li key={item.id} className="flex justify-between gap-2 px-3 py-2">
                  <span>{item.requirement}</span>
                  <StatusPill status={item.status} item={item} />
                </li>
              ))}
            </ul>
          </div>
        )}

        {section === "documentos" && (
          <div className="grid gap-4 sm:grid-cols-2 text-sm">
            <ListBlock title="Disponibles" items={bidPackage.available} />
            <ListBlock title="Faltantes" items={bidPackage.missing} empty="Ninguno" />
            <ListBlock title="Vencidos" items={bidPackage.expired} empty="Ninguno" />
            <ListBlock title="Por completar" items={bidPackage.to_complete} empty="Ninguno" />
          </div>
        )}

        {section === "formularios" && (
          <div className="space-y-3 text-sm">
            <p className="text-muted-foreground">
              Formularios SNCC y plantillas corporativas se autollena en la pestaña Autollenado.
            </p>
            <p>
              Pendientes por completar: <strong>{bidPackage.forms_to_complete}</strong>
            </p>
            {onGoToAutofill && (
              <Button size="sm" onClick={onGoToAutofill}>
                Ir a Autollenado
              </Button>
            )}
          </div>
        )}

        {section === "inteligencia-tecnica" && dgcpExpedienteTechnicalIntelligenceEnabled() && (
          <DgcpExpedienteTechnicalIntelligencePanel opportunityId={opportunityId} embedded />
        )}

        {section === "firmas" && (
          <DGCPFinalizationPanel
            opportunityId={opportunityId}
            checklist={checklist}
            busy={busy}
            onUpdated={onFinalizationUpdated}
          />
        )}

        {section === "pdf" && (
          <div className="space-y-2 text-sm text-muted-foreground">
            <p>PDFs finales con sello y firma — use la subsección Firmas para generar y descargar.</p>
            <Button size="sm" variant="outline" onClick={() => setSection("firmas")}>
              Abrir Firmas / PDF final
            </Button>
          </div>
        )}

        {section === "zip" && (
          <RealExpedientePanel opportunityId={opportunityId} busy={busy} onUpdated={onFinalizationUpdated} />
        )}
      </CardContent>
    </Card>
  );
}

function RiesgosTab({
  checklist,
  opportunity,
}: {
  checklist: DGCPChecklist;
  opportunity: DGCPOpportunity;
}) {
  const risks = checklist.items.filter((i) => i.risk);
  return (
    <div className="space-y-4">
      {opportunity.risks.length > 0 && (
        <Card>
          <CardHeader><CardTitle className="text-base">Riesgos IA del proceso</CardTitle></CardHeader>
          <CardContent className="space-y-2 text-sm">
            {opportunity.risks.map((r, i) => (
              <p key={i}>{r.descripcion}</p>
            ))}
          </CardContent>
        </Card>
      )}
      <Card>
        <CardHeader><CardTitle className="text-base">Riesgos de cumplimiento documental</CardTitle></CardHeader>
        <CardContent>
          {risks.length === 0 ? (
            <p className="text-sm text-muted-foreground">Sin riesgos documentales detectados.</p>
          ) : (
            <ul className="space-y-2 text-sm">
              {risks.map((r) => (
                <li key={r.id} className="rounded border px-3 py-2">
                  <span className="font-medium">{r.requirement}</span>
                  <p className="text-muted-foreground text-xs mt-0.5">{r.risk}</p>
                </li>
              ))}
            </ul>
          )}
        </CardContent>
      </Card>
    </div>
  );
}

const PROCESS_DOC_SECTION_ORDER = [
  "pliego",
  "tdr",
  "formulario",
  "anexo",
  "enmienda",
  "circular",
  "adenda",
  "general",
  "ficha_tecnica",
  "especificaciones",
  "invitacion",
  "cronograma",
  "contrato",
] as const;

const RECLASSIFY_ROLES = [
  { value: "pliego", label: "Pliego" },
  { value: "tdr", label: "TDR" },
  { value: "formulario", label: "Formulario" },
  { value: "anexo", label: "Anexo" },
  { value: "enmienda", label: "Enmienda" },
  { value: "circular", label: "Circular" },
  { value: "adenda", label: "Adenda" },
  { value: "general", label: "Complementario" },
];

function formatFileSize(bytes?: number | null): string {
  if (!bytes || bytes <= 0) return "—";
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function ProcessDocumentsTab({
  documents,
  opportunityId,
  analyzed,
  onReload,
}: {
  documents: DGCPProcessDocuments | null;
  opportunityId?: string;
  analyzed: boolean;
  onReload: () => Promise<void>;
}) {
  const [busy, setBusy] = useState<string | null>(null);
  const [message, setMessage] = useState<string | null>(null);
  const [uploadRole, setUploadRole] = useState("pliego");
  const [linkOpen, setLinkOpen] = useState(false);
  const [linkUrl, setLinkUrl] = useState("");
  const [linkTitle, setLinkTitle] = useState("");
  const [linkRole, setLinkRole] = useState("pliego");

  const realItems = (documents?.items ?? []).filter((d) => !d.is_portal_link && d.source_type !== "portal");
  const portal = documents?.portal ?? null;
  const hasDownloadablePliego = realItems.some(
    (d) => PLIEGO_ROLES.has(d.doc_role) && (d.has_text || d.is_downloadable),
  );

  const grouped = PROCESS_DOC_SECTION_ORDER.map((role) => ({
    role,
    label: PROCESS_DOC_ROLE_LABELS[role] ?? role,
    docs: realItems.filter((d) => d.doc_role === role || (role === "anexo" && d.doc_role === "anexo_tecnico")),
  })).filter((g) => g.docs.length > 0);

  const coveredRoles = new Set(PROCESS_DOC_SECTION_ORDER);
  const otherDocs = realItems.filter(
    (d) => !coveredRoles.has(d.doc_role as (typeof PROCESS_DOC_SECTION_ORDER)[number]) && d.doc_role !== "anexo_tecnico",
  );
  if (otherDocs.length) {
    grouped.push({ role: "complementario", label: "Documentos complementarios", docs: otherDocs });
  }

  const handleRefresh = async () => {
    if (!opportunityId) return;
    setBusy("refresh");
    setMessage(null);
    try {
      const result = await apiClient.refreshDGCPProcessDocuments(opportunityId);
      setMessage(result.message ?? `Descargados ${result.downloaded ?? 0} documento(s) del portal DGCP.`);
      await onReload();
    } catch {
      setMessage("No se pudo buscar documentos en DGCP. Intente de nuevo.");
    } finally {
      setBusy(null);
    }
  };

  const handleUpload = async (file: File) => {
    if (!opportunityId || !file) return;
    setBusy("upload");
    setMessage(null);
    try {
      const result = await apiClient.uploadDGCPProcessDocument(opportunityId, file, uploadRole);
      setMessage(result.message ?? "Documento subido correctamente.");
      await onReload();
    } catch {
      setMessage("No se pudo subir el documento.");
    } finally {
      setBusy(null);
    }
  };

  const handleReingest = async (docId: string) => {
    if (!opportunityId) return;
    setBusy(`reingest:${docId}`);
    try {
      await apiClient.reingestDGCPProcessDocument(opportunityId, docId);
      setMessage("Texto reextraído correctamente.");
      await onReload();
    } catch {
      setMessage("No se pudo reingestar el documento.");
    } finally {
      setBusy(null);
    }
  };

  const handleReclassify = async (docId: string, role: string) => {
    if (!opportunityId) return;
    setBusy(`role:${docId}`);
    try {
      await apiClient.updateDGCPProcessDocumentRole(opportunityId, docId, role);
      setMessage("Clasificación actualizada.");
      await onReload();
    } catch {
      setMessage("No se pudo actualizar la clasificación.");
    } finally {
      setBusy(null);
    }
  };

  const handleLinkExisting = async () => {
    if (!opportunityId || !linkUrl.trim()) return;
    setBusy("link");
    try {
      await apiClient.linkDGCPProcessDocument(opportunityId, {
        url: linkUrl.trim(),
        title: linkTitle.trim() || undefined,
        doc_role: linkRole,
      });
      setMessage("Documento vinculado e indexado.");
      setLinkOpen(false);
      setLinkUrl("");
      setLinkTitle("");
      await onReload();
    } catch {
      setMessage("No se pudo vincular el documento. Verifique la URL o suba el archivo manualmente.");
    } finally {
      setBusy(null);
    }
  };

  return (
    <div className="space-y-4">
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-base">
            <FileStack className="h-4 w-4" />
            Documentos del comprador ({realItems.length})
          </CardTitle>
          <p className="text-sm text-muted-foreground">
            Pliegos, TDR, formularios y anexos publicados por la institución en DGCP — separados de los documentos Justech.
          </p>
        </CardHeader>
        <CardContent className="space-y-4">
          {message && (
            <p className="text-sm rounded-lg border border-primary/20 bg-primary/5 px-3 py-2">{message}</p>
          )}

          {realItems.length === 0 ? (
            <div className="rounded-lg border border-dashed px-4 py-8 text-center space-y-4">
              <p className="text-sm font-medium">No se encontró pliego/TDR descargable desde DGCP.</p>
              <p className="text-sm text-muted-foreground">
                Busque nuevamente en el portal, suba el pliego manualmente o vincule un documento existente.
              </p>
              <div className="flex flex-wrap justify-center gap-2">
                <Button type="button" size="sm" disabled={busy === "refresh"} onClick={() => void handleRefresh()}>
                  {busy === "refresh" ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : <RefreshCw className="mr-2 h-4 w-4" />}
                  Buscar nuevamente en DGCP
                </Button>
                <label className="inline-flex">
                  <input
                    type="file"
                    accept=".pdf,.doc,.docx"
                    className="sr-only"
                    disabled={busy === "upload"}
                    onChange={(e) => {
                      const file = e.target.files?.[0];
                      if (file) void handleUpload(file);
                      e.target.value = "";
                    }}
                  />
                  <Button type="button" size="sm" variant="outline" asChild disabled={busy === "upload"}>
                    <span>
                      {busy === "upload" ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : null}
                      Subir pliego/TDR manualmente
                    </span>
                  </Button>
                </label>
                <Button type="button" size="sm" variant="outline" onClick={() => setLinkOpen(true)}>
                  Vincular documento existente
                </Button>
              </div>
              <div className="flex justify-center items-center gap-2 text-xs text-muted-foreground">
                <Label htmlFor="upload-role-empty">Tipo al subir:</Label>
                <select
                  id="upload-role-empty"
                  className="rounded border px-2 py-1 text-xs bg-background"
                  value={uploadRole}
                  onChange={(e) => setUploadRole(e.target.value)}
                >
                  {RECLASSIFY_ROLES.map((r) => (
                    <option key={r.value} value={r.value}>{r.label}</option>
                  ))}
                </select>
              </div>
            </div>
          ) : (
            <>
              {!hasDownloadablePliego && (
                <div className="rounded-lg border border-warning/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-800 dark:text-amber-200">
                  No se encontró pliego/TDR con texto extraído. Use «Reingestar» o suba el pliego para un análisis completo.
                </div>
              )}
              <div className="flex flex-wrap gap-2">
                <Button type="button" size="sm" variant="outline" disabled={busy === "refresh"} onClick={() => void handleRefresh()}>
                  {busy === "refresh" ? <Loader2 className="h-4 w-4 animate-spin" /> : <RefreshCw className="mr-2 h-4 w-4" />}
                  Buscar en DGCP
                </Button>
                <label className="inline-flex">
                  <input
                    type="file"
                    accept=".pdf,.doc,.docx"
                    className="sr-only"
                    disabled={busy === "upload"}
                    onChange={(e) => {
                      const file = e.target.files?.[0];
                      if (file) void handleUpload(file);
                      e.target.value = "";
                    }}
                  />
                  <Button type="button" size="sm" variant="outline" asChild>
                    <span>Subir manual</span>
                  </Button>
                </label>
                <select
                  className="rounded border px-2 py-1 text-xs bg-background h-8"
                  value={uploadRole}
                  onChange={(e) => setUploadRole(e.target.value)}
                  aria-label="Tipo de documento al subir"
                >
                  {RECLASSIFY_ROLES.map((r) => (
                    <option key={r.value} value={r.value}>{r.label}</option>
                  ))}
                </select>
              </div>
              {grouped.map((group) => (
                <div key={group.role} className="rounded-lg border bg-muted/10 overflow-hidden">
                  <p className="px-4 py-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground border-b bg-muted/20">
                    {group.label} ({group.docs.length})
                  </p>
                  <div className="overflow-x-auto">
                    <table className="w-full text-sm">
                      <thead>
                        <tr className="border-b text-xs text-muted-foreground">
                          <th className="text-left p-3 font-medium">Nombre</th>
                          <th className="text-left p-3 font-medium">Tipo</th>
                          <th className="text-left p-3 font-medium">Fecha</th>
                          <th className="text-left p-3 font-medium">Fuente</th>
                          <th className="text-left p-3 font-medium">Tamaño</th>
                          <th className="text-left p-3 font-medium">Texto</th>
                          <th className="text-right p-3 font-medium">Acciones</th>
                        </tr>
                      </thead>
                      <tbody>
                        {group.docs.map((doc) => (
                          <tr key={doc.id} className="border-b last:border-0 align-top">
                            <td className="p-3">
                              <p className="font-medium">{doc.title}</p>
                              {doc.original_filename && doc.original_filename !== doc.title && (
                                <p className="text-xs text-muted-foreground mt-0.5">{doc.original_filename}</p>
                              )}
                            </td>
                            <td className="p-3 text-xs">{PROCESS_DOC_ROLE_LABELS[doc.doc_role] ?? doc.doc_role}</td>
                            <td className="p-3 text-xs whitespace-nowrap">
                              {doc.published_at ? formatNoteTimestamp(doc.published_at) : "—"}
                            </td>
                            <td className="p-3 text-xs">{doc.source_label ?? doc.source_type}</td>
                            <td className="p-3 text-xs">{formatFileSize(doc.file_size_bytes)}</td>
                            <td className="p-3">
                              <ProcessStatusPill status={doc.text_extraction_status ?? doc.display_status ?? doc.ingestion_status} />
                            </td>
                            <td className="p-3">
                              <div className="flex flex-wrap justify-end gap-1">
                                {opportunityId && doc.is_downloadable && (
                                  <DocumentViewButton
                                    processDocumentId={doc.id}
                                    opportunityId={opportunityId}
                                    label="Ver"
                                  />
                                )}
                                {opportunityId && doc.is_downloadable && (
                                  <Button size="sm" variant="outline" asChild>
                                    <a
                                      href={`/api/v1/dgcp/opportunities/${opportunityId}/process-documents/${doc.id}/file?disposition=attachment`}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                    >
                                      <Download className="h-3.5 w-3.5 mr-1" />
                                      Descargar
                                    </a>
                                  </Button>
                                )}
                                {doc.source_url && !doc.is_downloadable && (
                                  <Button size="sm" variant="outline" asChild>
                                    <a href={doc.source_url} target="_blank" rel="noopener noreferrer">Abrir enlace</a>
                                  </Button>
                                )}
                                {doc.is_downloadable && (
                                  <Button
                                    size="sm"
                                    variant="ghost"
                                    disabled={busy === `reingest:${doc.id}`}
                                    onClick={() => void handleReingest(doc.id)}
                                  >
                                    {busy === `reingest:${doc.id}` ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : "Reingestar"}
                                  </Button>
                                )}
                                <select
                                  className="rounded border px-1.5 py-1 text-xs bg-background max-w-[110px]"
                                  value={doc.doc_role}
                                  disabled={busy === `role:${doc.id}`}
                                  onChange={(e) => void handleReclassify(doc.id, e.target.value)}
                                  aria-label={`Clasificar ${doc.title}`}
                                >
                                  {RECLASSIFY_ROLES.map((r) => (
                                    <option key={r.value} value={r.value}>{r.label}</option>
                                  ))}
                                </select>
                              </div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </>
          )}

          {portal && (
            <div className="rounded-lg border border-dashed bg-muted/5 px-4 py-3">
              <p className="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2">Portal DGCP</p>
              <div className="flex flex-wrap items-center justify-between gap-3 text-sm">
                <div>
                  <p className="font-medium">Ficha pública del proceso</p>
                  <p className="text-xs text-muted-foreground mt-0.5">Enlace externo — no es un documento descargable indexado.</p>
                </div>
                {portal.source_url && (
                  <Button size="sm" variant="outline" asChild>
                    <a href={portal.source_url} target="_blank" rel="noopener noreferrer">Abrir portal DGCP</a>
                  </Button>
                )}
              </div>
            </div>
          )}

          {!analyzed && realItems.length > 0 && (
            <p className="text-xs text-muted-foreground">
              Para extraer requisitos del pliego, pulse «Analizar requisitos» arriba.
            </p>
          )}
        </CardContent>
      </Card>

      {linkOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" onClick={() => setLinkOpen(false)} role="presentation">
          <Card className="w-full max-w-lg" onClick={(e) => e.stopPropagation()}>
            <CardHeader>
              <CardTitle className="text-base">Vincular documento existente</CardTitle>
              <p className="text-sm text-muted-foreground">Indique la URL directa del PDF (p. ej. enlace del portal DGCP).</p>
            </CardHeader>
            <CardContent className="space-y-3">
              <div>
                <Label className="text-xs">URL del documento</Label>
                <Input value={linkUrl} onChange={(e) => setLinkUrl(e.target.value)} placeholder="https://..." />
              </div>
              <div>
                <Label className="text-xs">Nombre (opcional)</Label>
                <Input value={linkTitle} onChange={(e) => setLinkTitle(e.target.value)} placeholder="Pliego de condiciones.pdf" />
              </div>
              <div>
                <Label className="text-xs">Clasificar como</Label>
                <select
                  className="w-full rounded border px-2 py-2 text-sm bg-background"
                  value={linkRole}
                  onChange={(e) => setLinkRole(e.target.value)}
                >
                  {RECLASSIFY_ROLES.map((r) => (
                    <option key={r.value} value={r.value}>{r.label}</option>
                  ))}
                </select>
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <Button type="button" variant="outline" onClick={() => setLinkOpen(false)}>Cancelar</Button>
                <Button type="button" disabled={busy === "link" || !linkUrl.trim()} onClick={() => void handleLinkExisting()}>
                  {busy === "link" ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : null}
                  Vincular
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      )}
    </div>
  );
}

function AlertasTab({ alerts }: { alerts: DGCPBidAlerts }) {
  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2 text-base">
          <Bell className="h-4 w-4" />
          Alertas ({alerts.total})
        </CardTitle>
      </CardHeader>
      <CardContent className="space-y-2">
        {alerts.alerts.length === 0 ? (
          <p className="text-sm text-muted-foreground">Sin alertas activas.</p>
        ) : (
          alerts.alerts.map((a) => (
            <div
              key={a.id}
              className={cn(
                "rounded border px-3 py-2 text-sm",
                a.severity === "high" && "border-red-500/30 bg-red-500/5",
                a.severity === "medium" && "border-amber-500/30 bg-warning/10",
              )}
            >
              <p className="font-medium">{a.title}</p>
              <p className="text-xs text-muted-foreground mt-0.5">{a.message}</p>
            </div>
          ))
        )}
      </CardContent>
    </Card>
  );
}

function AssociateDocumentModal({
  busy,
  onClose,
  onOpenM365,
  onPickKnowledge,
  onPickDocument,
  onUpload,
}: {
  busy: boolean;
  onClose: () => void;
  onOpenM365: () => void;
  onPickKnowledge: (id: string) => void;
  onPickDocument: (id: string) => void;
  onUpload: (file: File) => void;
}) {
  const [knowledge, setKnowledge] = useState<
    Array<{ id: string; title: string; relative_path: string; folder_category: string }>
  >([]);
  const [documents, setDocuments] = useState<Array<{ id: string; title: string }>>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;
    void Promise.all([
      apiClient.listKnowledgeAssets({ limit: 40 }),
      apiClient.getDocuments({ limit: 40 }),
    ])
      .then(([k, d]) => {
        if (cancelled) return;
        setKnowledge(k.items);
        setDocuments(d.items.map((x) => ({ id: x.id, title: x.title })));
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, []);

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
      onClick={onClose}
      role="presentation"
    >
      <Card className="w-full max-w-2xl max-h-[85vh] overflow-y-auto" onClick={(e) => e.stopPropagation()}>
        <CardHeader>
          <CardTitle className="text-base">Asociar documento corporativo</CardTitle>
          <p className="text-sm text-muted-foreground">
            Seleccione del repositorio JustechAI (carpetas oficiales) o suba un archivo nuevo.
          </p>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="flex flex-wrap gap-2">
            <Button type="button" variant="default" size="sm" disabled={busy} onClick={onOpenM365}>
              Buscar en Microsoft 365
            </Button>
          </div>
          <div>
            <Label className="text-xs uppercase text-muted-foreground">Subir nuevo</Label>
            <Input
              type="file"
              accept=".pdf,.docx,.xlsx,.txt,.csv,.rtf,.odt"
              disabled={busy}
              onChange={(e) => {
                const f = e.target.files?.[0];
                if (f) onUpload(f);
              }}
            />
          </div>
          {loading ? (
            <p className="text-sm text-muted-foreground">Cargando repositorio…</p>
          ) : (
            <>
              <div>
                <p className="text-xs font-medium mb-2">JustechAI ({knowledge.length})</p>
                <div className="max-h-48 overflow-y-auto divide-y rounded border">
                  {knowledge.map((k) => (
                    <button
                      key={k.id}
                      type="button"
                      className="w-full px-3 py-2 text-left text-sm hover:bg-muted/50"
                      disabled={busy}
                      onClick={() => onPickKnowledge(k.id)}
                    >
                      <span className="font-medium">{k.title}</span>
                      <span className="block text-xs text-muted-foreground">{k.relative_path}</span>
                    </button>
                  ))}
                </div>
              </div>
              <div>
                <p className="text-xs font-medium mb-2">Documentos JAIOS ({documents.length})</p>
                <div className="max-h-32 overflow-y-auto divide-y rounded border">
                  {documents.map((d) => (
                    <button
                      key={d.id}
                      type="button"
                      className="w-full px-3 py-2 text-left text-sm hover:bg-muted/50"
                      disabled={busy}
                      onClick={() => onPickDocument(d.id)}
                    >
                      {d.title}
                    </button>
                  ))}
                </div>
              </div>
            </>
          )}
          <Button variant="ghost" size="sm" onClick={onClose} disabled={busy}>
            Cancelar
          </Button>
        </CardContent>
      </Card>
    </div>
  );
}

function ProcessStatusPill({ status }: { status: string }) {
  return (
    <span
      className={cn(
        "rounded px-2 py-0.5 text-[10px] font-semibold",
        status === "Requisitos extraídos" && "bg-success/10 text-success",
        status === "Texto extraído" && "bg-success/10 text-success",
        status === "Procesado" && "bg-blue-500/15 text-blue-700",
        status === "Detectado" && "bg-muted text-muted-foreground",
        status === "Error de lectura" && "bg-red-500/15 text-red-600",
        status === "Sin contenido relevante" && "bg-muted text-muted-foreground",
      )}
    >
      {status}
    </span>
  );
}

function PriorityPill({ priority }: { priority: string }) {
  return (
    <span
      className={cn(
        "rounded px-2 py-0.5 text-[10px] font-semibold uppercase",
        priority === "alta" && "bg-red-500/15 text-red-600",
        priority === "media" && "bg-warning/10 text-warning",
        priority === "baja" && "bg-muted text-muted-foreground",
      )}
    >
      {PROCESS_PRIORITY_LABELS[priority] ?? priority}
    </span>
  );
}

function StatusPill({ status, item }: { status: string; item?: DGCPChecklistItem }) {
  const effective = item ? effectiveChecklistStatus(item) : status;
  const unified = item?.unified_status;
  const label =
    (unified && UNIFIED_STATUS_LABELS[unified]) ||
    COMPLIANCE_STATUS_LABELS[effective] ||
    CHECKLIST_STATUS_LABELS[effective] ||
    effective;
  return (
    <span
      className={cn(
        "rounded px-2 py-0.5 text-[10px] font-semibold uppercase",
        effective === "validado_manual" && "bg-success/10 text-success",
        (effective === "encontrado_vigente" || effective === "encontrado") &&
          "bg-success/10 text-success",
        (effective === "faltante" || effective === "pendiente") && "bg-muted text-muted-foreground",
        (effective === "encontrado_vencido" || effective === "vencido") && "bg-red-500/15 text-red-600",
        (effective === "requiere_completado" || effective === "completar" || effective === "incompleto") &&
          "bg-warning/10 text-warning",
        (effective === "requiere_revision" || effective === "encontrado_sin_fecha") &&
          "bg-orange-500/15 text-orange-600",
        (effective === "adjuntado" || effective === "borrador_pendiente") &&
          "bg-primary/10 text-primary",
        effective === "no_aplica" && "bg-blue-500/15 text-blue-600",
      )}
    >
      {label}
    </span>
  );
}

function Metric({ label, value }: { label: string; value: number }) {
  return (
    <div className="rounded border px-3 py-2">
      <p className="text-xs text-muted-foreground">{label}</p>
      <p className="text-lg font-bold">{value}</p>
    </div>
  );
}

function ListBlock({ title, items, empty = "—" }: { title: string; items: string[]; empty?: string }) {
  return (
    <div>
      <p className="text-xs font-medium text-muted-foreground mb-1">{title}</p>
      {items.length === 0 ? (
        <p className="text-sm text-muted-foreground">{empty}</p>
      ) : (
        <ul className="text-sm list-disc pl-4 space-y-0.5">
          {items.map((i) => (
            <li key={i}>{i}</li>
          ))}
        </ul>
      )}
    </div>
  );
}
