<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_crm_lead_form_justech_dgcp" model="ir.ui.view">
    <field name="name">crm.lead.form.justech.dgcp</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_open_justech_jaios" type="object" class="oe_stat_button" icon="fa-globe"
                invisible="not justech_jaios_url">
          <div class="o_stat_info"><span class="o_stat_text">Abrir en JAIOS</span></div>
        </button>
        <button name="action_open_justech_dgcp" type="object" class="oe_stat_button" icon="fa-external-link"
                invisible="not justech_url">
          <div class="o_stat_info"><span class="o_stat_text">Portal DGCP</span></div>
        </button>
        <button name="action_open_justech_dgcp_lines" type="object" class="oe_stat_button" icon="fa-cubes"
                invisible="justech_dgcp_line_count == 0">
          <field name="justech_dgcp_line_count" widget="statinfo" string="Productos solicitados"/>
        </button>
        <button name="action_open_justech_sales" type="object" class="oe_stat_button" icon="fa-usd"
                invisible="justech_sale_count == 0">
          <field name="justech_sale_count" widget="statinfo" string="Cotización"/>
        </button>
      </div>

      <notebook position="inside">
        <!-- 1. Información licitación + 2. Usuario JAIOS -->
        <page string="Licitación DGCP / JAIOS" name="justech_dgcp" invisible="not justech_dgcp_code and not justech_jaios_id">
          <group>
            <group string="Licitación">
              <field name="justech_dgcp_code" string="Código DGCP"/>
              <field name="justech_institution" string="Entidad contratante"/>
              <field name="justech_company_key" string="Empresa participante"/>
              <field name="justech_rpe" string="RPE"/>
              <field name="justech_dgcp_status" string="Estado DGCP"/>
              <field name="justech_deadline" string="Fecha límite"/>
              <field name="justech_amount" string="Monto estimado"/>
              <field name="justech_currency" string="Moneda"/>
              <field name="justech_url" string="Enlace DGCP" widget="url"/>
            </group>
            <group string="JAIOS">
              <field name="justech_jaios_user_name" string="Iniciado por"/>
              <field name="justech_jaios_owner_name" string="Responsable actual"/>
              <field name="justech_jaios_last_action_user_name" string="Última acción"/>
              <field name="justech_jaios_last_action_at" string="Fecha última acción"/>
              <field name="justech_jaios_last_sync_at" string="Última sincronización"/>
              <field name="justech_jaios_url" string="Abrir en JAIOS" widget="url"/>
              <field name="justech_jaios_id" string="ID JAIOS" groups="base.group_no_one"/>
            </group>
          </group>
          <div class="oe_button_box mb-2" invisible="not justech_jaios_url">
            <button name="action_open_justech_jaios" type="object" class="btn btn-primary" string="Abrir en JAIOS"/>
          </div>
        </page>

        <!-- 3. Productos solicitados -->
        <page string="Productos solicitados" name="justech_dgcp_products" invisible="not justech_dgcp_code and justech_dgcp_line_count == 0">
          <group>
            <group>
              <field name="justech_dgcp_line_count" string="Productos solicitados"/>
              <field name="justech_dgcp_line_linked_count" string="Vinculados"/>
            </group>
            <group>
              <field name="justech_dgcp_line_review_count" string="Requieren revisión"/>
              <field name="justech_dgcp_line_unlinked_count" string="Sin vincular"/>
            </group>
          </group>
          <field name="justech_dgcp_line_ids" nolabel="1" mode="list">
            <list>
              <field name="line_number" string="#"/>
              <field name="description_original" string="Descripción"/>
              <field name="quantity" string="Cantidad"/>
              <field name="uom_text" string="Unidad"/>
              <field name="brand_required" string="Marca"/>
              <field name="model_required" string="Modelo"/>
              <field name="estimated_unit_price" string="Precio estimado"/>
              <field name="product_id" string="Producto Odoo"/>
              <field name="match_state" string="Estado"/>
            </list>
          </field>
        </page>
      </notebook>
    </field>
  </record>

  <record id="view_crm_lead_kanban_justech_dgcp" model="ir.ui.view">
    <field name="name">crm.lead.kanban.justech.dgcp</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
    <field name="arch" type="xml">
      <xpath expr="//kanban" position="inside">
        <field name="justech_dgcp_code"/>
        <field name="justech_jaios_owner_name"/>
      </xpath>
      <xpath expr="//t[@t-name='card']//div[hasclass('o_kanban_card_crm_lead_revenue')]" position="after">
        <div t-if="record.justech_dgcp_code.raw_value" class="text-muted" style="font-size:11px;line-height:1.3;">
          <div>DGCP: <field name="justech_dgcp_code"/></div>
          <div t-if="record.justech_jaios_owner_name.raw_value">
            JAIOS: <field name="justech_jaios_owner_name"/>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
