<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_hellenia_invoice" model="report.paperformat">
        <field name="name">Hellenia Invoice Paperformat</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_justech_invoice" model="ir.actions.report">
        <field name="name">Justech PDF — Factura</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">justech_report_design.report_justech_invoice_document</field>
        <field name="report_file">justech_report_design.report_justech_invoice_document</field>
        <field name="print_report_name">'Factura - %s' % (object.name)</field>
        <field name="paperformat_id" ref="justech_report_design.paperformat_hellenia_invoice"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
    </record>
</odoo>
