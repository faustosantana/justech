<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="justech_invoice_body">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="lines_to_report" t-value="doc._jt_invoice_product_lines()"/>
        <t t-set="has_discount" t-value="doc.get_jt_invoice_has_discount()"/>
        <t t-set="show_discount_totals" t-value="doc.get_jt_invoice_show_discount_totals()"/>
        <t t-set="retention_lines" t-value="doc.get_jt_invoice_retention_lines()"/>

        <div class="jt-hq-hdr">
            <div class="jt-hq-hdr-logo">
                <img t-if="company.logo" class="jt-hq-logo"
                     t-att-src="image_data_uri(company.logo)" alt="Logo"/>
            </div>
            <div class="jt-hq-co">
                <div class="jt-hq-co-name"><span t-field="company.name"/></div>
                <div t-if="company.street">
                    <span t-field="company.street"/>
                    <t t-if="company.city">, <span t-field="company.city"/></t>
                </div>
                <div t-if="company.vat">
                    <span class="jt-hq-co-lbl">RNC: </span><span t-field="company.vat"/>
                </div>
                <div t-if="company.phone">
                    <span class="jt-hq-co-lbl">Tel.: </span><span t-field="company.phone"/>
                </div>
                <div t-if="company.email">
                    <span class="jt-hq-co-lbl">Correo: </span><span t-field="company.email"/>
                </div>
                <div t-if="company.website">
                    <span class="jt-hq-co-lbl">Web: </span><span t-field="company.website"/>
                </div>
            </div>
        </div>

        <table width="100%" cellpadding="0" cellspacing="0" class="jt-hq-band jt-inv-band"
               style="background-color: #3E4827; width: 100%; border-collapse: collapse;">
            <tr>
                <td width="22%" class="jt-hq-band-title"
                    style="background-color: #3E4827; color: #ffffff; padding: 11px 14px;">FACTURA</td>
                <td width="78%" class="jt-inv-band-meta-cell"
                    style="background-color: #3E4827; color: #ffffff; padding: 8px 14px; text-align: right; border-left: 1px solid rgba(255,255,255,0.35);">
                    <div class="jt-inv-band-meta-row">
                        <span class="jt-inv-band-lbl">No. FACTURA:</span>
                        <span t-field="doc.name"/>
                    </div>
                    <div class="jt-inv-band-meta-row" t-if="doc.get_jt_ncf_display()">
                        <span class="jt-inv-band-lbl">NCF:</span>
                        <span t-out="doc.get_jt_ncf_display()"/>
                    </div>
                    <div class="jt-inv-band-meta-row" t-if="doc.get_jt_document_type_label()">
                        <span class="jt-inv-band-lbl">TIPO DE COMPROBANTE:</span>
                        <span t-out="doc.get_jt_document_type_label()"/>
                    </div>
                </td>
            </tr>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" class="jt-inv-meta-cols"
               style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
            <tr>
                <td width="20%" class="jt-inv-meta-col" valign="top">
                    <div class="jt-hq-card-title">Información del Cliente</div>
                    <div class="jt-hq-meta-row">
                        <span class="jt-hq-val"><span t-field="doc.partner_id.name"/></span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="doc.partner_id.vat">
                        <span class="jt-hq-lbl">RNC</span>
                        <span class="jt-hq-val"><span t-field="doc.partner_id.vat"/></span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="doc.get_jt_partner_address_display()">
                        <span class="jt-hq-val" t-out="doc.get_jt_partner_address_display()"/>
                    </div>
                    <div class="jt-hq-meta-row" t-if="doc.partner_id.phone">
                        <span class="jt-hq-lbl">Tel.</span>
                        <span class="jt-hq-val"><span t-field="doc.partner_id.phone"/></span>
                    </div>
                    <div class="jt-hq-meta-row" t-if="doc.partner_id.email">
                        <span class="jt-hq-val"><span t-field="doc.partner_id.email"/></span>
                    </div>
                </td>
                <td class="jt-hq-vdiv">&#160;</td>
                <td width="16%" class="jt-inv-meta-col" valign="top">
                    <div class="jt-hq-card-title">Condiciones de Pago</div>
                    <div class="jt-hq-pay-val" t-out="doc.get_jt_payment_term_display()"/>
                </td>
                <td class="jt-hq-vdiv">&#160;</td>
                <td width="16%" class="jt-inv-meta-col" valign="top">
                    <div class="jt-hq-card-title">Vendedor</div>
                    <div class="jt-hq-meta-row" t-if="doc.invoice_user_id">
                        <span class="jt-hq-val"><span t-field="doc.invoice_user_id.name"/></span>
                    </div>
                </td>
                <td class="jt-hq-vdiv">&#160;</td>
                <td width="16%" class="jt-inv-meta-col" valign="top">
                    <div class="jt-hq-card-title">Fecha de Emisión</div>
                    <div class="jt-hq-val-bold" t-if="doc.invoice_date">
                        <span t-out="doc.invoice_date.strftime('%d/%m/%Y') if doc.invoice_date else ''"/>
                    </div>
                </td>
                <td class="jt-hq-vdiv">&#160;</td>
                <td width="16%" class="jt-inv-meta-col" valign="top">
                    <div class="jt-hq-card-title">Fecha de Vencimiento</div>
                    <div class="jt-hq-val-bold" t-if="doc.invoice_date_due">
                        <span t-out="doc.invoice_date_due.strftime('%d/%m/%Y') if doc.invoice_date_due else ''"/>
                    </div>
                </td>
            </tr>
        </table>

        <table class="jt-hq-items" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th class="c-num">#</th>
                    <th>DESCRIPCIÓN</th>
                    <th class="c-qty">CANT.</th>
                    <th class="c-price">P. UNIT.</th>
                    <th t-if="has_discount" class="c-disc">DESCUENTO</th>
                    <th class="c-tax">ITBIS</th>
                    <th class="c-sub">SUBTOTAL</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="n" t-value="0"/>
                <t t-foreach="lines_to_report" t-as="line">
                    <t t-set="n" t-value="n + 1"/>
                    <tr>
                        <td class="c-num"><span t-out="n"/></td>
                        <td><span t-field="line.name"/></td>
                        <td class="c-qty">
                            <span t-field="line.quantity"/>
                            <t t-if="line.product_uom_id"> <span t-field="line.product_uom_id"/></t>
                        </td>
                        <td class="c-price">
                            <span t-field="line.price_unit"
                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </td>
                        <td t-if="has_discount" class="c-disc">
                            <t t-if="(line.discount or 0) > 0">
                                <span t-out="doc.format_jt_monetary(doc.get_jt_line_discount_amount(line))"/>
                            </t>
                            <t t-else="">—</t>
                        </td>
                        <td class="c-tax">
                            <span t-out="doc.format_jt_monetary(doc.get_jt_line_itbis_amount(line))"/>
                        </td>
                        <td class="c-sub">
                            <span t-field="line.price_subtotal"
                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

        <table width="100%" cellpadding="0" cellspacing="0" class="jt-inv-bottom">
            <tr>
                <td width="58%" class="jt-inv-obs" valign="top" t-if="doc.jt_show_invoice_observations()">
                    <div class="jt-hq-cond-title">OBSERVACIONES / TÉRMINOS Y CONDICIONES</div>
                    <div class="jt-hq-cond-body" t-out="doc.jt_invoice_observations_html()"/>
                </td>
                <td width="58%" class="jt-inv-obs" valign="top" t-else=""/>
                <td width="42%" class="jt-inv-totals-cell" valign="top">
                    <table width="280" cellpadding="0" cellspacing="0" border="0" align="right" class="jt-hq-totals">
                        <t t-if="show_discount_totals">
                            <tr>
                                <td class="t-lbl">Subtotal bruto</td>
                                <td class="t-val">
                                    <span t-out="doc.format_jt_monetary(doc.get_jt_invoice_gross_subtotal())"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="t-lbl">Descuento</td>
                                <td class="t-val">
                                    <span t-out="doc.format_jt_monetary(doc.get_jt_invoice_discount_total())"/>
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td class="t-lbl">Subtotal</td>
                            <td class="t-val">
                                <span t-field="doc.amount_untaxed"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="t-lbl">ITBIS (18%)</td>
                            <td class="t-val">
                                <span t-out="doc.format_jt_monetary(doc.get_jt_invoice_itbis_total())"/>
                            </td>
                        </tr>
                        <t t-foreach="retention_lines" t-as="ret">
                            <tr>
                                <td class="t-lbl">
                                    Retenciones (<span t-out="ret['label']"/>)
                                </td>
                                <td class="t-val">
                                    <span t-out="doc.format_jt_monetary(ret['amount'])"/>
                                </td>
                            </tr>
                        </t>
                        <tr class="grand">
                            <td class="t-lbl">TOTAL</td>
                            <td class="t-val">
                                <span t-field="doc.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <div class="jt-hq-clear"/>

        <div class="jt-hq-sigs-zone">
            <div class="jt-hq-sig-grow">&#160;</div>
            <div class="jt-hq-sigs">
                <div class="jt-hq-sig-col">
                    <div class="jt-hq-sig-head">ENTREGADO POR</div>
                    <hr class="jt-hq-sig-line"/>
                    <div class="jt-hq-sig-date-lbl">Fecha:</div>
                    <hr class="jt-hq-sig-line jt-hq-sig-line-date"/>
                </div>
                <div class="jt-hq-sig-col">
                    <div class="jt-hq-sig-head">RECIBIDO POR</div>
                    <hr class="jt-hq-sig-line"/>
                    <div class="jt-hq-sig-date-lbl">Fecha:</div>
                    <hr class="jt-hq-sig-line jt-hq-sig-line-date"/>
                </div>
            </div>
        </div>
    </template>

    <template id="report_justech_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-set="company" t-value="doc.company_id"/>
                <div class="article page jt-hq-page jt-inv-page"
                     style="border: none !important; border-top: none !important;"
                     t-att-data-oe-model="doc._name"
                     t-att-data-oe-id="doc.id"
                     t-att-data-oe-lang="doc.env.context.get('lang')">
                    <t t-call="justech_report_design.justech_invoice_body"/>
                </div>
                <div class="footer jt-hq-footer-pdf">
                    <div class="jt-hq-foot-row">
                        <t t-if="company.phone"><span class="jt-hq-foot-item" t-field="company.phone"/></t>
                        <t t-if="company.email">
                            <span class="jt-hq-foot-sep">|</span>
                            <span class="jt-hq-foot-item" t-field="company.email"/>
                        </t>
                        <t t-if="company.website">
                            <span class="jt-hq-foot-sep">|</span>
                            <span class="jt-hq-foot-item" t-field="company.website"/>
                        </t>
                        <span class="jt-hq-foot-sep">|</span>
                        <span class="jt-hq-foot-item jt-hq-foot-page">
                            Página <span class="page"></span> de <span class="topage"></span>
                        </span>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
